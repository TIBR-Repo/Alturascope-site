---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Privacy Policy | Alturascope"
  description="Privacy information for Alturascope website visitors and prospective clients."
  canonical="https://alturascope.com/privacy/"
  fullWidth={true}
>
  <section class="bg-white section-padding">
    <div class="max-w-[760px] mx-auto px-6">
      <p class="label text-gold mb-4">Privacy</p>
      <h1 class="text-[2rem] md:text-[2.6rem] font-light text-navy leading-tight">
        Privacy Policy
      </h1>
      <div class="mt-8 space-y-5 text-midgrey leading-body">
        <p>
          Alturascope collects information you submit through contact and project enquiry forms so we can respond to your request, prepare quotes, and communicate about potential work.
        </p>
        <p>
          We may also collect basic website analytics information, such as page views and device data, to understand how the site is used and improve its performance.
        </p>
        <p>
          We do not sell your personal information. We only share information with service providers where needed to operate the website, manage communications, or deliver services.
        </p>
        <p>
          If you would like us to update or delete information you have submitted through this site, contact us through the enquiry form and include enough detail for us to identify your request.
        </p>
      </div>
    </div>
  </section>
</Layout>
