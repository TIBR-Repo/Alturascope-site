---
import Layout from "../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Alturascope",
  "description": "Reality capture, 3D documentation, and conditions surveys for construction teams and specialist clients across the US, Canada, and the UK.",
  "url": "https://alturascope.com",
  "areaServed": ["United States", "Canada", "United Kingdom"],
  "serviceType": "Reality Capture and Site Documentation"
});
---
<Layout
  title="Start a Project | Alturascope"
  description="Share the address, size, and decision you're trying to make. We'll respond within one business day with a scope recommendation and an all-in quote — travel included."
  canonical="https://alturascope.com/contact"
  schema={schema}
  fullWidth={true}
>
  <section class="bg-white section-padding">
    <div class="max-w-[640px] mx-auto px-6">
      <h1 class="text-[2.4rem] md:text-[3rem] font-light text-navy leading-tight">
        Tell us about the project.
      </h1>
      <p class="mt-4 text-midgrey leading-body">
        Share the address or location, the approximate size of the space, and what you're trying to decide. We'll come back within one business day with a clear scope recommendation and an all-in quote — travel included.
      </p>

      <form class="mt-12 space-y-6" method="POST" action="https://api.web3forms.com/submit">
        <input type="hidden" name="access_key" value="8c6ab3a1-43b4-4110-8b1b-4a8bb804b90c" />
        <input type="hidden" name="subject" value="New project enquiry from Alturascope.com" />
        <input type="hidden" name="from_name" value="Alturascope Website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
        <div>
          <label for="name" class="block text-sm font-medium text-navy mb-1.5">Name <span class="text-gold">*</span></label>
          <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="company" class="block text-sm font-medium text-navy mb-1.5">Company</label>
          <input type="text" id="company" name="company" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-navy mb-1.5">Email <span class="text-gold">*</span></label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-navy mb-1.5">Location / Address</label>
          <input type="text" id="location" name="location" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="size" class="block text-sm font-medium text-navy mb-1.5">Approximate size</label>
          <input type="text" id="size" name="size" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="brief" class="block text-sm font-medium text-navy mb-1.5">What are you trying to decide or document?</label>
          <textarea id="brief" name="brief" rows="4" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors resize-y"></textarea>
        </div>

        <div>
          <label for="referral" class="block text-sm font-medium text-navy mb-1.5">How did you find us?</label>
          <input type="text" id="referral" name="referral" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
        </div>

        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn-primary">Send</button>
      </form>

      <p class="mt-10 text-[0.85rem] text-midgrey">
        We operate across all 50 US states, every Canadian province, and the United Kingdom. Travel costs are included in all project pricing.
      </p>

      <div class="mt-10 flex flex-wrap gap-6 text-sm">
        <a href="/" class="text-navy font-medium hover:opacity-80 transition-opacity">Home &rarr;</a>
        <a href="/services" class="text-navy font-medium hover:opacity-80 transition-opacity">Our services &rarr;</a>
        <a href="/services/construction-documentation" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction documentation &rarr;</a>
        <a href="/work" class="text-navy font-medium hover:opacity-80 transition-opacity">The Standard &rarr;</a>
        <a href="/about" class="text-navy font-medium hover:opacity-80 transition-opacity">About Alturascope &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
