---
import Layout from "../../layouts/Layout.astro";

const project = {
  name: "Austin Downtown — Pre-Fit-Out Survey",
  address: "412 E 6th Street, Austin, TX 78701",
  client: "Pulp & Press Co.",
  surveyDate: "March 2026",
  surveyor: "Alturascope Central US",
};

// Rooms — ordered as they appear during a standard walkthrough
const rooms = [
  {
    id: "room-foh",
    name: "Front of House — Dining",
    type: "Customer-facing",
    summary:
      "Primary dining and queue area with full-height storefront glazing to 6th Street. Existing ceiling is exposed structure painted matte black with surface-mounted track lighting. Three tenants preceded the current vacancy; legacy millwork has been removed and the slab is exposed.",
    measurements: { width: "34' 2\"", length: "22' 6\"", ceiling: "11' 4\" AFF", area: "769 sq ft" },
    finishes: { floor: "Sealed concrete — original slab", ceiling: "Exposed structure, matte black", walls: "Painted gypsum, 2 coats neutral" },
    photos: [
      { src: "/Images/site-interior-1.jpg", label: "North elevation — storefront glazing" },
      { src: "/Images/site-inside.jpg", label: "East wall toward service counter" },
      { src: "/Images/site-interior-2.jpg", label: "South wall — queue line" },
      { src: "/Images/site-interior-3.jpg", label: "Ceiling — structure and track lighting" },
      { src: "/Images/plan-1.jpg", label: "Overlay — dimensions annotated" },
    ],
    system: null,
  },
  {
    id: "room-counter",
    name: "Service Counter & Order Point",
    type: "Customer-facing",
    summary:
      "Service counter runs the full east wall. Existing soffit conceals supply ductwork; we opened three access panels on the north face to confirm routing and duct size (see Above-Ceiling section). POS power circuits run from the panel in the Electrical/IT room through a dedicated conduit above ceiling.",
    measurements: { width: "18' 0\"", length: "12' 6\"", ceiling: "9' 0\" AFF soffit", area: "225 sq ft" },
    finishes: { floor: "Quarry tile, beige — reusable", ceiling: "GWB soffit, painted", walls: "FRP panel to 4' on working face" },
    photos: [
      { src: "/Images/site-with-studs.png", label: "Counter framing — east elevation" },
      { src: "/Images/whatsapp-site-photo.jpg", label: "Soffit access panel #1 — ducting visible" },
      { src: "/Images/clean-site.png", label: "Floor — quarry tile condition" },
    ],
    system: null,
  },
  {
    id: "room-kitchen",
    name: "Prep Kitchen — Back of House",
    type: "Operational",
    summary:
      "Active prep kitchen with existing 9-foot Type I hood on the east wall. Make-up air routed through rooftop unit RTU-2 (see HVAC schedule). Grease trap is below slab at the south-east corner — location confirmed with landlord drawings and probe. Floor drains are epoxy-sealed and in good condition. Three-compartment sink on north wall is serviceable; recommended for reuse.",
    measurements: { width: "18' 4\"", length: "24' 0\"", ceiling: "10' 2\" AFF", area: "440 sq ft" },
    finishes: { floor: "Epoxy coating, sloped to drains", ceiling: "Vinyl-clad gypsum tile", walls: "FRP panel, full height" },
    photos: [
      { src: "/commercial-kitchen-work.jpg", label: "North wall — three-compartment sink" },
      { src: "/Images/hvac.jpg", label: "Type I hood — east wall" },
      { src: "/Images/site-interior-3.jpg", label: "West wall — prep table location" },
      { src: "/Images/site-with-studs.png", label: "Hood exhaust rise — ceiling penetration" },
    ],
    system:
      "Type I hood: 9'-0\" wide, 48\" deep canopy. Stainless, in-line Ansul R-102. Exhaust rises through ceiling to rooftop fan EF-1 (2,400 CFM nameplate). Make-up air from RTU-2. Control panel at east wall adjacent to hood; interlock confirmed functional.",
  },
  {
    id: "room-walkin",
    name: "Walk-in Cooler / Freezer",
    type: "Operational",
    summary:
      "Paired walk-in units on the west wall. Cooler (8' × 10') and freezer (6' × 8') share a common vestibule. Condenser units are rooftop-mounted (see HVAC schedule). Existing panels are in serviceable condition with minor gasket wear on the cooler door — recommended replacement rather than full unit.",
    measurements: { width: "14' 0\"", length: "10' 0\"", ceiling: "8' 6\" AFF", area: "140 sq ft" },
    finishes: { floor: "Aluminium diamond plate over insulated slab", ceiling: "Insulated metal panel", walls: "Insulated metal panel, 4\"" },
    photos: [
      { src: "/Images/attic.jpg", label: "Cooler interior — shelving" },
      { src: "/Images/site-interior-2.jpg", label: "Vestibule looking toward freezer" },
      { src: "/Images/whatsapp-site-photo.jpg", label: "Cooler door gasket — wear visible" },
    ],
    system:
      "Cooler: 8' × 10' × 8'-6\" clear. Evap coil IMP-1, rooftop condenser CU-1 (nameplate R-448A, 1.5 HP). Freezer: 6' × 8' × 8'-6\" clear. Evap coil IMP-2, rooftop condenser CU-2 (2 HP). Control panel in vestibule. Both units tested and operating at setpoint during survey.",
  },
  {
    id: "room-electrical",
    name: "Electrical & IT Room",
    type: "Back-of-house utility",
    summary:
      "Combined electrical / IT closet at the south-west corner. Main service is 400A, 208Y/120V, 3-phase, 4-wire. Existing panel schedule confirms 72 poles total with approximately 35% current spare capacity — sufficient for the proposed new menu without a service upgrade. Fiber drop terminates here from the landlord IDF.",
    measurements: { width: "6' 0\"", length: "8' 0\"", ceiling: "9' 0\" AFF", area: "48 sq ft" },
    finishes: { floor: "Sealed concrete", ceiling: "Exposed structure", walls: "Painted CMU" },
    photos: [
      { src: "/Images/fire-safety.jpg", label: "Panel MP-1 — deadfront" },
      { src: "/Images/whatsapp-site-photo.jpg", label: "Panel MP-1 — schedule label" },
      { src: "/Images/site-interior-1.jpg", label: "IT rack — landlord fiber drop" },
    ],
    system:
      "Main service: 400A, 208Y/120V, 3-ph, 4-wire. Panel MP-1: 72 poles, ~35% spare capacity. Panel LP-1 (BOH): 42 poles, ~20% spare. Surge protection present at main. No ground-fault deficiencies observed. Recommend thermal imaging at connection points prior to tenant improvement work — see Thermal Imaging section.",
  },
  {
    id: "room-above-ceiling",
    name: "Above-Ceiling Plenum",
    type: "Concealed space",
    summary:
      "Concealed space above the suspended ceiling grid is fully accessible. Structure is open-web steel joist at 4' o.c. with corrugated deck above. Fire separation between tenant bay and the corridor is rated and intact. See the Above-Ceiling Survey section below for a complete inventory.",
    measurements: { width: "—", length: "—", ceiling: "6' 2\" to deck (varies)", area: "—" },
    finishes: { floor: "—", ceiling: "Corrugated deck", walls: "Party wall — rated gypsum, type X" },
    photos: [
      { src: "/above-ceiling-survey.jpg", label: "Grid D — HVAC trunk line" },
      { src: "/Images/attic.jpg", label: "Grid B — sprinkler main" },
      { src: "/Images/site-with-studs.png", label: "Party wall — rated assembly" },
      { src: "/Images/hvac.jpg", label: "Grid F — electrical junction box" },
    ],
    system:
      "Clear height from ceiling grid to underside of deck ranges 5'-8\" to 6'-2\" depending on joist depth. Structural deflection capacity confirmed for planned new loads (branded pendant lighting, additional signage). Full photographic record in Above-Ceiling Survey below.",
  },
];

const aboveCeilingPhotos = [
  { src: "/above-ceiling-survey.jpg", label: "Grid A — main supply duct, 18×12 trunk" },
  { src: "/Images/hvac.jpg", label: "Grid B — 4\" sprinkler main, clamp hanger" },
  { src: "/Images/attic.jpg", label: "Grid C — party wall, rated gypsum assembly" },
  { src: "/Images/site-with-studs.png", label: "Grid D — electrical J-box, existing circuit" },
  { src: "/Images/fire-safety.jpg", label: "Grid E — smoke detector, interconnect" },
  { src: "/Images/whatsapp-site-photo.jpg", label: "Grid F — grease exhaust rise from hood" },
];

const equipmentReuse = [
  { id: "EQ-01", item: "Type I hood canopy, 9'-0\"", make: "CaptiveAire", model: "5424ND-2", qty: 1, condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-02", item: "Ansul R-102 wet chemical system", make: "Ansul", model: "R-102", qty: 1, condition: "Due for service", recommendation: "Reuse — service before turnover" },
  { id: "EQ-03", item: "Three-compartment sink", make: "Advance Tabco", model: "93-3-54", qty: 1, condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-04", item: "Hand sink, wall-mount", make: "Krowne", model: "HS-20", qty: 2, condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-05", item: "Walk-in cooler box, 8×10", make: "Nor-Lake", model: "KLB8X10", qty: 1, condition: "Minor gasket wear", recommendation: "Reuse — replace gaskets" },
  { id: "EQ-06", item: "Walk-in freezer box, 6×8", make: "Nor-Lake", model: "KLF6X8", qty: 1, condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-07", item: "Floor drains, 2\" with trap", make: "Zurn", model: "Z415", qty: 4, condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-08", item: "Grease trap, under-slab", make: "Rockford", model: "G-50-SA", qty: 1, condition: "Service verified", recommendation: "Reuse" },
  { id: "EQ-09", item: "POS counter, quartz top", make: "Site-built", model: "—", qty: 1, condition: "Obsolete layout", recommendation: "Remove" },
  { id: "EQ-10", item: "Track lighting, FOH", make: "Juno", model: "T256", qty: 14, condition: "Functional", recommendation: "Remove — new brand package" },
  { id: "EQ-11", item: "Quarry tile floor, FOH counter", make: "Daltile", model: "Q41", qty: "225 sf", condition: "Serviceable", recommendation: "Reuse" },
  { id: "EQ-12", item: "Fire extinguishers, ABC", make: "Amerex", model: "B402", qty: 3, condition: "Tagged — current", recommendation: "Reuse" },
];

const hvac = [
  { tag: "RTU-1", type: "Rooftop packaged unit", tonnage: "5 ton", age: "~8 yrs", refrigerant: "R-410A", serves: "FOH dining", condition: "Serviceable", recommendation: "Retain — service filters" },
  { tag: "RTU-2", type: "Rooftop packaged unit with MUA", tonnage: "4 ton + 1,800 CFM MUA", age: "~6 yrs", refrigerant: "R-410A", serves: "Prep kitchen", condition: "Serviceable", recommendation: "Retain — interlock to hood confirmed" },
  { tag: "CU-1", type: "Condensing unit, walk-in cooler", tonnage: "1.5 HP", age: "~4 yrs", refrigerant: "R-448A", serves: "Walk-in cooler", condition: "Good", recommendation: "Retain" },
  { tag: "CU-2", type: "Condensing unit, walk-in freezer", tonnage: "2 HP", age: "~4 yrs", refrigerant: "R-448A", serves: "Walk-in freezer", condition: "Good", recommendation: "Retain" },
  { tag: "EF-1", type: "Rooftop exhaust fan, grease duct", tonnage: "2,400 CFM", age: "~8 yrs", refrigerant: "—", serves: "Type I hood", condition: "Serviceable — clean prior to turnover", recommendation: "Retain" },
];

const thermalFindings = [
  {
    id: "TH-01",
    severity: "P2 — Monitor",
    location: "Panel MP-1, main breaker lug",
    finding: "Elevated thermal signature at line-side lug of the 400A main breaker. 14°F above ambient compared to adjacent connections. Not a failure, but outside the baseline we'd expect for a panel of this age.",
    photo: "/Images/fire-safety.jpg",
    label: "MP-1 — thermal overlay, line-side lug",
  },
  {
    id: "TH-02",
    severity: "P3 — Note",
    location: "Prep kitchen ceiling, south-east corner",
    finding: "Small cool spot consistent with minor condensation below the insulated duct elbow at the rise to the hood exhaust. Not a leak. Recommend wrap inspection during TI works.",
    photo: "/Images/attic.jpg",
    label: "Ceiling — cool spot at duct elbow",
  },
];

const drawings = [
  { name: "Existing Conditions — Floor Plan", format: "PDF", pages: 1, size: "1.8 MB" },
  { name: "Existing Conditions — Reflected Ceiling Plan", format: "PDF", pages: 1, size: "1.4 MB" },
  { name: "MEP Overlay — Above-Ceiling Survey", format: "PDF", pages: 2, size: "2.6 MB" },
  { name: "Equipment Schedule — Reuse / Remove", format: "XLSX", pages: "—", size: "48 KB" },
  { name: "Thermal Imaging Findings", format: "PDF", pages: 3, size: "4.2 MB" },
  { name: "Point Cloud Extract — FOH", format: "E57", pages: "—", size: "312 MB" },
];

const comments = [
  {
    author: "Marcus Lee",
    role: "Project Architect",
    team: true,
    when: "2 days ago",
    body: "Note for the MEP consultant — panel MP-1 has ~35% spare at 400A. The new menu load calc (attached in schedule) stays within that. Good to proceed without a service upgrade.",
    replies: [
      {
        author: "Sonia Bhatt",
        role: "MEP Lead — Contractor",
        team: false,
        when: "1 day ago",
        body: "Cross-referenced with our preliminary load schedule. Agreed — no upgrade needed. We'll add the juicer station on a dedicated 20A circuit from panel LP-1.",
      },
    ],
  },
  {
    author: "Riley Chen",
    role: "Alturascope — Site Lead",
    team: true,
    when: "3 days ago",
    body: "Heads up: the grease trap is below slab at the south-east corner of the prep kitchen — probe location marked in the E57 extract. Coordinate with the plumbing sub before demo so we don't cut a core over it.",
    replies: [],
  },
  {
    author: "Alex Rivera",
    role: "Pulp & Press — Design",
    team: false,
    when: "4 days ago",
    body: "Can we get a dimensional confirmation on the soffit at the service counter? The menu board design assumes 9'-0\" AFF and we want to double-check before we commit the fabrication order.",
    replies: [
      {
        author: "Riley Chen",
        role: "Alturascope — Site Lead",
        team: true,
        when: "4 days ago",
        body: "Confirmed — 9'-0\" AFF at the soffit face, consistent across the full counter run. Point cloud extract will let your fabricator take off any additional dimensions without a return visit.",
      },
    ],
  },
];

const totalPhotos = rooms.reduce((acc, r) => acc + r.photos.length, 0) + aboveCeilingPhotos.length + thermalFindings.length;

const navSections = [
  { id: "overview", label: "Overview" },
  { id: "site-discussion", label: "Site Discussion" },
  { id: "aerial", label: "Aerial / Drone" },
  { id: "tour", label: "3D Tour" },
  { id: "rooms", label: "Rooms & Spaces" },
  { id: "above-ceiling", label: "Above-Ceiling" },
  { id: "equipment", label: "Equipment Schedule" },
  { id: "hvac", label: "HVAC Schedule" },
  { id: "thermal", label: "Thermal Imaging" },
  { id: "drawings", label: "Drawings" },
  { id: "media", label: "External Media" },
  { id: "comments", label: "Questions & Comments" },
];
---
<Layout
  title="Sample ScopeWalk Project — Alturascope"
  description="Explore an interactive sample of the ScopeWalk deliverable Alturascope produces on every site visit — rooms, measurements, photographs, equipment schedules, and more."
  canonical="https://alturascope.com/work/sample-project/"
  robots="noindex, follow"
  fullWidth={true}
  minimalChrome={true}
>
  <div class="sw-root bg-[#FBF8F3] text-[#3A3630] min-h-screen">

    <!-- Guest banner (sticky) -->
    <div class="sticky top-0 z-40 bg-gradient-to-r from-[#EE7B1A] to-[#CC620A] text-white shadow-md">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <span class="text-xs sm:text-sm font-medium truncate">
            <span class="font-semibold">Sample project</span>
            <span class="hidden sm:inline opacity-90"> — this is an interactive demo of the ScopeWalk deliverable.</span>
          </span>
        </div>
        <a href="/" class="text-xs font-semibold whitespace-nowrap hover:underline underline-offset-4">&larr; Alturascope</a>
      </div>
    </div>

    <!-- Project header -->
    <header id="overview" class="scroll-mt-20 max-w-[1200px] mx-auto px-4 sm:px-6 pt-6 sm:pt-10 pb-4">
      <div class="bg-white rounded-2xl shadow-sm border border-[#E9E0CD] overflow-hidden">
        <div class="p-5 sm:p-8">
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
            <div class="min-w-0">
              <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-[#CC620A] mb-2">ScopeWalk Project</p>
              <h1 class="text-2xl sm:text-3xl lg:text-[2.1rem] font-semibold text-[#1C1A17] leading-tight">{project.name}</h1>
              <div class="mt-3 flex items-start gap-2 text-[#504B43]">
                <svg class="w-4 h-4 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="text-sm">{project.address}</span>
              </div>
              <p class="text-sm text-[#6F6A61] mt-1">Client: <span class="text-[#3A3630] font-medium">{project.client}</span></p>
            </div>

            <!-- Quick stats -->
            <div class="grid grid-cols-4 gap-2 sm:gap-3 lg:gap-4 lg:flex-shrink-0">
              <div class="bg-[#F5EFE4] rounded-lg px-3 py-2.5 text-center">
                <div class="text-base sm:text-lg font-semibold text-[#1C1A17]">{rooms.length}</div>
                <div class="text-[10px] sm:text-[11px] font-medium uppercase tracking-wider text-[#6F6A61] mt-0.5">Rooms</div>
              </div>
              <div class="bg-[#F5EFE4] rounded-lg px-3 py-2.5 text-center">
                <div class="text-base sm:text-lg font-semibold text-[#1C1A17]">{totalPhotos}</div>
                <div class="text-[10px] sm:text-[11px] font-medium uppercase tracking-wider text-[#6F6A61] mt-0.5">Photos</div>
              </div>
              <div class="bg-[#F5EFE4] rounded-lg px-3 py-2.5 text-center">
                <div class="text-base sm:text-lg font-semibold text-[#1C1A17]">1,622</div>
                <div class="text-[10px] sm:text-[11px] font-medium uppercase tracking-wider text-[#6F6A61] mt-0.5">Sq ft</div>
              </div>
              <div class="bg-[#F5EFE4] rounded-lg px-3 py-2.5 text-center">
                <div class="text-base sm:text-lg font-semibold text-[#1C1A17]">1</div>
                <div class="text-[10px] sm:text-[11px] font-medium uppercase tracking-wider text-[#6F6A61] mt-0.5">Visit</div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-5 border-t border-[#EDE5D7] flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-[#6F6A61]">
            <span><span class="text-[#504B43] font-medium">Surveyed:</span> {project.surveyDate}</span>
            <span><span class="text-[#504B43] font-medium">By:</span> {project.surveyor}</span>
            <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Deliverable issued</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main layout: sidebar + content -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 pb-12">
      <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-8">

        <!-- Sticky section nav (desktop) -->
        <aside class="hidden lg:block">
          <nav aria-label="Sections" class="sticky top-20 pt-4">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#9A938A] mb-3 px-3">Jump to</p>
            <ul class="flex flex-col gap-1 text-sm" id="sw-side-nav">
              {navSections.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-nav-link data-target={s.id} class="sw-nav-link block px-3 py-1.5 rounded-md text-[#504B43] hover:text-[#1C1A17] hover:bg-[#F5EFE4] transition-colors">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Mobile section pills -->
        <nav aria-label="Sections" class="lg:hidden -mx-4 sm:-mx-6 px-4 sm:px-6 overflow-x-auto mb-4">
          <ul class="flex gap-2 whitespace-nowrap pb-1">
            {navSections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="inline-block px-3 py-1.5 rounded-full text-xs font-medium bg-white border border-[#E9E0CD] text-[#504B43] hover:border-[#EE7B1A] hover:text-[#CC620A] transition-colors">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Content -->
        <div class="space-y-6">

          <!-- Site Discussion -->
          <section id="site-discussion" class="scroll-mt-20 bg-white rounded-2xl shadow-sm border border-[#E9E0CD] overflow-hidden">
            <div class="px-5 sm:px-6 py-4 border-b border-[#EDE5D7] bg-[#FFF8EC] flex items-center gap-2.5">
              <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <h2 class="text-base sm:text-lg font-semibold text-[#1C1A17]">Site Discussion</h2>
            </div>
            <div class="p-5 sm:p-6 grid md:grid-cols-2 gap-5">
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#6F6A61] mb-1.5">TI Information</h4>
                <p class="text-sm text-[#504B43] leading-relaxed">Tenant improvement budget approved. Landlord has provided as-built drawings from 2018 with annotations from the prior tenant's 2022 lease-end survey. All drawings attached to this deliverable.</p>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#6F6A61] mb-1.5">Preferred Vendors</h4>
                <p class="text-sm text-[#504B43] leading-relaxed">Landlord requests use of their roofing contractor (BuildUp Roofing) for any rooftop penetrations. Electrical and plumbing vendor selection is tenant's choice, subject to licensing verification.</p>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#6F6A61] mb-1.5">Building Mandates</h4>
                <p class="text-sm text-[#504B43] leading-relaxed">After-hours work permitted 7pm–7am weekdays and all day weekends. Freight elevator access coordinated via property management with 48-hour notice. Historic district façade restrictions apply to signage — see addendum.</p>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#6F6A61] mb-1.5">Garbage / Debris</h4>
                <p class="text-sm text-[#504B43] leading-relaxed">Shared dumpster in the rear service alley (accessed off Red River). Construction debris requires separate roll-off — coordinate with property management. No curbside staging permitted on 6th Street.</p>
              </div>
            </div>
          </section>

          <!-- Aerial -->
          <section id="aerial" class="scroll-mt-20 bg-white rounded-2xl shadow-sm border border-[#E9E0CD] overflow-hidden">
