  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const accs = document.querySelectorAll(".sw-acc");

      function setOpen(acc, open) {
        const body = acc.querySelector(".sw-acc-body");
        const chev = acc.querySelector(".sw-acc-chev");
        if (!body || !chev) return;
        if (open) {
          body.style.display = "";
          chev.style.transform = "rotate(180deg)";
        } else {
          body.style.display = "none";
          chev.style.transform = "rotate(0deg)";
        }
      }

      document.querySelectorAll(".sw-acc-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const acc = btn.closest(".sw-acc");
          if (!acc) return;
          const body = acc.querySelector(".sw-acc-body");
          const isOpen = body && body.style.display !== "none";
          setOpen(acc, !isOpen);
        });
      });

      const expand = document.getElementById("sw-expand-all");
      const collapse = document.getElementById("sw-collapse-all");
      expand && expand.addEventListener("click", () => accs.forEach((a) => setOpen(a, true)));
      collapse && collapse.addEventListener("click", () => accs.forEach((a) => setOpen(a, false)));
    });
  </script>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get("key") === "AS2026demo") {
        document.getElementById("sw-gated").style.display = "";
      } else {
        window.location.href = "/";
      }
    })();
  </script>
