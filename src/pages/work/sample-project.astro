            <div class="p-5 sm:p-6 grid sm:grid-cols-2 gap-4">
              <a href="#tour" class="flex items-center gap-3 p-4 bg-[#FBF8F3] rounded-xl border border-[#EDE5D7] hover:border-[#EE7B1A] hover:bg-[#F5EFE4] transition-colors">
                <div class="w-10 h-10 rounded-lg bg-[#FFECD9] flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#CC620A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
