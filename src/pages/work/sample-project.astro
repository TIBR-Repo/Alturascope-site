                        <span class="text-sm font-semibold text-[#1C1A17]">{room.measurements.length}</span>
                      </div>
                      <div class="bg-[#FBF8F3] border border-[#EDE5D7] rounded-lg p-3">
                        <span class="text-[10px] uppercase tracking-wider text-[#9A938A] font-semibold block">Ceiling</span>
                        <span class="text-sm font-semibold text-[#1C1A17]">{room.measurements.ceiling}</span>
                      </div>
                      <div class="bg-[#FBF8F3] border border-[#EDE5D7] rounded-lg p-3">
                        <span class="text-[10px] uppercase tracking-wider text-[#9A938A] font-semibold block">Area</span>
                        <span class="text-sm font-semibold text-[#1C1A17]">{room.measurements.area}</span>
                      </div>
                    </div>
