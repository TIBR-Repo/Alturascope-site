                          e.recommendation.startsWith('Reuse') ? 'bg-emerald-50 text-emerald-800 border border-emerald-100' :
                          e.recommendation.startsWith('Remove') ? 'bg-rose-50 text-rose-800 border border-rose-100' :
                          'bg-amber-50 text-amber-800 border border-amber-100'
                        }`}>{e.recommendation}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

