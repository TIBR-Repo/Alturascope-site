---
import Layout from "../../layouts/Layout.astro";

// The sample is a live ScopeWalk client portfolio (a fictional client, real surveys with
// identifying details removed). /sample on the ScopeWalk host forwards to the share link,
// so this page never needs the token. The sample saves nothing a visitor types.
const SAMPLE_URL = "https://scopewalk2.on-forge.com/sample";

const shot = (name: string, w: number, h: number) => ({
  src: `/Images/sample/${name}-1600.webp`,
  srcset: `/Images/sample/${name}-800.webp 800w, /Images/sample/${name}-1600.webp ${w}w`,
  width: w,
  height: h,
});

const TRY = [
  {
    ...shot("portfolio", 1600, 687),
    title: "Every site in one place",
    body: "The client's whole programme on one screen: delivered, revised, in progress and scheduled. Switch between cards, a list and a map, or search by city.",
    alt: "Sample portfolio of six sites with status tiles and site cards",
  },
  {
    ...shot("ask", 1236, 735),
    title: "Ask the site a question",
    body: "Type a question in plain English. The answer comes only from that survey's photos, readings, drawings and report, and shows where it came from.",
    alt: "Ask this site panel answering what still needs confirming, with cited open items",
  },
  {
    ...shot("drawings", 1600, 704),
    title: "Measured drawings and a ROM",
    body: "Plans, ceiling plans and elevations drawn from the site measurements, in PDF and CAD, with a rough order of magnitude for the fit-out priced from the same record.",
    alt: "Drawings and files tab listing measured plans and elevations with PDF and DXF downloads",
  },
  {
    ...shot("photos", 1600, 704),
    title: "Photos sorted by system",
    body: "Every photo filed under electrical, HVAC, plumbing, life safety and the rest. Download one system, a few, or all of them at once.",
    alt: "Photos tab grouped by building system with per-system downloads",
  },
  {
    ...shot("openitems", 1600, 710),
    title: "What still needs an answer",
    body: "Anything the survey couldn't settle on the day, with who can answer it. The client team closes each item with a note, and the surveyor sees it.",
    alt: "Open items list, each with who can answer it and a close-with-a-note button",
  },
];

const hero = shot("overview", 1600, 1000);

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alturascope.com/" },
    { "@type": "ListItem", position: 2, name: "Projects", item: "https://alturascope.com/work/locations/" },
    { "@type": "ListItem", position: 3, name: "Sample Project", item: "https://alturascope.com/work/sample-project/" },
  ],
});
---

<Layout
  title="Sample Site Survey | Explore a Live Deliverable | Alturascope"
  description="Open a live sample Alturascope site survey: findings, measured drawings, photos by system, open items and a ROM. Real survey work, fictional client."
  canonical="https://alturascope.com/work/sample-project/"
  breadcrumbSchema={breadcrumbSchema}
  fullWidth={true}
>
  <section class="bg-navy pt-32 pb-14 md:pt-40 md:pb-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="label mb-5">Sample Project</p>
        <h1 class="text-[2.2rem] md:text-[3rem] font-light text-offwhite leading-[1.1]">
          Open a real survey and work through it.
        </h1>
        <p class="mt-6 text-offwhite/70 leading-relaxed">
          This is the portal our clients log into. The client is fictional. The surveys, photos,
          measured drawings and reports are real Alturascope work, with identifying details removed.
          Click through it the way a construction manager would.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={SAMPLE_URL} target="_blank" rel="noopener" class="btn-primary">Open the sample survey &rarr;</a>
          <span class="text-offwhite/50 text-[0.85rem]">Opens in a new tab. No sign-up.</span>
        </div>
      </div>

      <a href={SAMPLE_URL} target="_blank" rel="noopener" class="group block mt-12 md:mt-16" aria-label="Open the sample survey">
        <div class="rounded-md overflow-hidden shadow-2xl ring-1 ring-white/10 bg-white">
          <div class="flex items-center gap-2 px-4 py-2.5 bg-[#e9ecef] border-b border-black/5">
            <span class="w-2.5 h-2.5 rounded-full bg-black/15"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-black/15"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-black/15"></span>
            <span class="ml-3 text-[0.72rem] text-black/45 truncate">Sample survey &middot; Meridian Commons, Suite 140 &middot; Houston, TX</span>
          </div>
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes="(min-width: 1200px) 1152px, 100vw"
            width={hero.width}
            height={hero.height}
            alt="A delivered survey in the sample portal: headline finding, key facts on power, HVAC, water and grease, and the client's questions"
            fetchpriority="high"
            class="w-full h-auto block transition-opacity group-hover:opacity-95"
          />
        </div>
      </a>
    </div>
  </section>

  <section class="bg-white section-padding">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="label text-gold mb-4">What to try</p>
      <h2 class="text-[1.8rem] md:text-[2.2rem] font-light text-navy leading-tight max-w-2xl">
        Everything your team needs to decide on a space, in one record.
      </h2>
      <p class="mt-5 text-midgrey leading-relaxed max-w-2xl">
        Start with the Houston suite: it has been delivered and revised, so every tab is full.
        Ask it a question, download a drawing, and close an open item. Nothing you type in the
        sample is saved.
      </p>

      <div class="mt-14 space-y-16 md:space-y-24">
        {TRY.map((t, i) => (
          <div class={`grid md:grid-cols-[1fr_1.6fr] gap-8 md:gap-12 items-center ${i % 2 ? "md:[&>*:first-child]:order-2" : ""}`}>
            <div>
              <p class="text-gold text-[0.8rem] font-medium tracking-[0.12em] uppercase">0{i + 1}</p>
              <h3 class="mt-2 text-[1.35rem] md:text-[1.5rem] font-light text-navy leading-snug">{t.title}</h3>
              <p class="mt-3 text-midgrey leading-relaxed">{t.body}</p>
            </div>
            <a href={SAMPLE_URL} target="_blank" rel="noopener" class="block rounded-md overflow-hidden border border-border shadow-sm hover:shadow-md transition-shadow">
              <img
                src={t.src}
                srcset={t.srcset}
                sizes="(min-width: 1200px) 700px, (min-width: 768px) 60vw, 100vw"
                width={t.width}
                height={t.height}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-auto block"
              />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-offwhite section-padding border-t border-border">
    <div class="max-w-[900px] mx-auto px-6 text-center">
      <h2 class="text-[1.8rem] md:text-[2.2rem] font-light text-navy leading-tight">
        Want this for your sites?
      </h2>
      <p class="mt-5 text-midgrey leading-relaxed">
        Every survey we deliver arrives in a portal like this one: your sites, your standards,
        your team. One site or a national rollout, anywhere in the US and Canada.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href="/contact/" class="btn-primary">Start a Project</a>
        <a href={SAMPLE_URL} target="_blank" rel="noopener" class="btn-secondary">Open the sample survey</a>
      </div>
    </div>
  </section>
</Layout>
