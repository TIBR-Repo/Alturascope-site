const PHOTO_GRADIENTS = [
  "linear-gradient(135deg, #cbd5e1 0%, #94a3b8 100%)",
  "linear-gradient(135deg, #e5e7eb 0%, #9ca3af 100%)",
  "linear-gradient(135deg, #fef3c7 0%, #d4a853 100%)",
  "linear-gradient(135deg, #fed7aa 0%, #f97316 100%)",
  "linear-gradient(135deg, #d1fae5 0%, #10b981 100%)",
  "linear-gradient(135deg, #dbeafe 0%, #3b82f6 100%)",
  "linear-gradient(135deg, #e0e7ff 0%, #6366f1 100%)",
  "linear-gradient(135deg, #fce7f3 0%, #ec4899 100%)",
];

const THERMAL_GRADIENT = "linear-gradient(135deg, #7c2d12 0%, #f97316 40%, #fbbf24 70%, #fef3c7 100%)";

function gradientFor(id: string, i: number, isThermal: boolean) {
  if (isThermal) return THERMAL_GRADIENT;
  const idx = (i + id.charCodeAt(0)) % PHOTO_GRADIENTS.length;
  return PHOTO_GRADIENTS[idx];
}

function badgeColors(kind: string) {
  if (kind === "good") return { bg: "#dcfce7", color: "#166534", border: "#86efac" };
  if (kind === "warn") return { bg: "#fef3c7", color: "#854d0e", border: "#fcd34d" };
  if (kind === "bad")  return { bg: "#fee2e2", color: "#991b1b", border: "#fca5a5" };
  return { bg: "#dcfce7", color: "#166534", border: "#86efac" };
}

function recColors(rec: string) {
  if (rec === "REUSE")    return { bg: "#dcfce7", color: "#166534" };
  if (rec === "REPLACE")  return { bg: "#fee2e2", color: "#991b1b" };
  if (rec === "EVALUATE") return { bg: "#fef3c7", color: "#854d0e" };
  return { bg: "#f3f4f6", color: "#374151" };
}

function recPalette(level: string) {
  if (level === "critical") return { bg: "#fef2f2", border: "#fca5a5", head: "#991b1b" };
  if (level === "high")     return { bg: "#fff7ed", border: "#fdba74", head: "#9a3412" };
  if (level === "medium")   return { bg: "#fefce8", border: "#fde047", head: "#854d0e" };
  return { bg: "#f9fafb", border: "#e5e7eb", head: "#374151" };
}

const PAGE_FONT = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

const initialOpenId = "plumbing";
---

<Layout
  title="ScopeWalk Sample Project — Greenleaf Kitchen San Marcos"
  description="Interactive ScopeWalk survey report for a former juice/smoothie space in San Marcos, CA. MEP, equipment reuse assessment, recommendations, and 3D capture."
  canonical="https://alturascope.com/work/sample-project/"
  robots="noindex, nofollow"
  fullWidth={true}
  minimalChrome={true}
>
  <div id="sw-gated" style={`display:none; font-family: ${PAGE_FONT}; background: #f3f4f6; min-height: 100vh; color: #111827;`}>

    {/* TOP NAV BAR */}
    <header style="background: #fff; border-bottom: 1px solid #e5e7eb; padding: 12px 24px; position: sticky; top: 0; z-index: 50;">
