        <div style="display: flex; align-items: center; gap: 32px;">
          <div style="font-size: 18px; font-weight: 800; color: #111827; letter-spacing: -0.3px;">ScopeWalk</div>
          <nav style="display: flex; gap: 22px; font-size: 13px; color: #6b7280; font-weight: 500;">
            <span>Dashboard</span>
            <span>Visits</span>
            <span>Projects</span>
            <span>Portfolios</span>
            <span>Teams</span>
            <span>Templates</span>
          </nav>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 5px; background: #dcfce7; color: #166534; padding: 5px 11px; border-radius: 6px; font-size: 12px; font-weight: 600;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5" /></svg>
            All synced
          </div>
          <div style="display: flex; align-items: center; gap: 5px; background: #ea580c; color: #fff; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            Schedule Visit
          </div>
          <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: #374151;">
            <span style="font-weight: 600;">Andrew Harris</span>
            <span style="background: #f3f4f6; padding: 2px 7px; border-radius: 3px; font-size: 10px; font-weight: 600; color: #6b7280;">owner</span>
          </div>
          <span style="font-size: 13px; color: #6b7280; font-weight: 500;">Admin</span>
          <div style="padding: 5px 11px; border: 1px solid #a78bfa; border-radius: 6px; color: #7c3aed; font-size: 12px; font-weight: 600; cursor: pointer;">Designer View</div>
          <span style="font-size: 13px; color: #6b7280;">Log out</span>
        </div>
      </div>
    </header>

    {/* MAIN */}
    <main style="max-width: 1200px; margin: 0 auto; padding: 24px;">

      {/* Report title */}
      <div style="margin-bottom: 20px;">
        <h1 style="font-size: 30px; font-weight: 800; color: #111827; margin: 0 0 4px; letter-spacing: -0.5px;">Survey Report</h1>
        <div style="font-size: 14px; color: #6b7280;">{PROJECT.name}</div>
        <div style="height: 3px; width: 100%; background: #ea580c; margin-top: 10px; border-radius: 2px;"></div>
      </div>

      {/* Project Information */}
      <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 18px; margin-bottom: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px 28px;">
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">PROJECT</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.name}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">VISIT DATE</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.visitDate}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">CLIENT</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.client}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">STATUS</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">
            <span style="display: inline-block; padding: 2px 9px; border-radius: 3px; font-size: 11px; font-weight: 700; background: #dcfce7; color: #166534; letter-spacing: 0.5px;">{PROJECT.status}</span>
          </div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">ADDRESS</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.address}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">ROUTE & START</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.route}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">SURVEYOR</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.surveyor}</div>
        </div>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 3px;">LAST UPDATED</div>
          <div style="font-size: 13px; color: #111827; font-weight: 500;">{PROJECT.lastUpdated}</div>
        </div>
      </div>

      {/* Envelope & Doors */}
      <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 18px; margin-bottom: 20px;">
        <h2 style="font-size: 16px; font-weight: 700; color: #111827; margin: 0 0 10px;">Envelope &amp; Doors</h2>
        <div style="height: 2px; background: #ea580c; margin-bottom: 12px; width: 100%; border-radius: 1px;"></div>
        <div style="overflow-x: auto;">
