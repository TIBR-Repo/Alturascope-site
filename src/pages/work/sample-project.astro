                <div class="w-10 h-10 rounded-lg bg-[#EDE5D7] flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#6F6A61]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                </div>
                <div class="min-w-0">
                  <span class="text-sm font-semibold text-[#1C1A17] block">Above-Ceiling Fly-Through</span>
                  <span class="text-xs text-[#6F6A61]">Cubex tour &middot; available to project team</span>
                </div>
              </div>
            </div>
          </section>

          <!-- Comments -->
          <section id="comments" class="scroll-mt-20 bg-white rounded-2xl shadow-sm border border-[#E9E0CD] overflow-hidden">
            <div class="px-5 sm:px-6 py-4 border-b border-[#EDE5D7] bg-[#F5EFE4]">
              <h2 class="text-base sm:text-lg font-semibold text-[#1C1A17] flex items-center gap-2.5">
                <svg class="w-5 h-5 text-[#504B43]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                Questions &amp; Comments
              </h2>
              <p class="text-xs text-[#6F6A61] mt-1">Visible to all invited contractors and the project team.</p>
            </div>
            <div class="p-5 sm:p-6 space-y-6">
              {comments.map((c) => (
                <div class={`border-l-2 ${c.team ? 'border-[#EE7B1A]' : 'border-[#DDD1BD]'} pl-4`}>
                  <div class="flex items-start justify-between gap-2 mb-1 flex-wrap">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-sm font-semibold text-[#1C1A17]">{c.author}</span>
                      <span class="text-xs text-[#6F6A61]">{c.role}</span>
                      {c.team && <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 bg-[#FFECD9] text-[#B25508] rounded">Team</span>}
                    </div>
                    <span class="text-xs text-[#9A938A]">{c.when}</span>
                  </div>
                  <p class="text-sm text-[#504B43] leading-relaxed whitespace-pre-wrap">{c.body}</p>

                  {c.replies.length > 0 && (
                    <div class="mt-3 ml-3 space-y-3">
                      {c.replies.map((r) => (
                        <div class={`border-l-2 ${r.team ? 'border-[#FFBB7F]' : 'border-[#E9E0CD]'} pl-3`}>
                          <div class="flex items-start justify-between gap-2 mb-1 flex-wrap">
                            <div class="flex items-center gap-2 flex-wrap">
                              <span class="text-sm font-semibold text-[#1C1A17]">{r.author}</span>
                              <span class="text-xs text-[#6F6A61]">{r.role}</span>
                              {r.team && <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 bg-[#FFECD9] text-[#B25508] rounded">Team</span>}
                            </div>
                            <span class="text-xs text-[#9A938A]">{r.when}</span>
                          </div>
                          <p class="text-sm text-[#504B43] leading-relaxed whitespace-pre-wrap">{r.body}</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}

              <div class="bg-[#FBF8F3] border border-dashed border-[#DDD1BD] rounded-xl p-4 text-center">
                <p class="text-sm text-[#6F6A61]">
                  Invited contractors and the project team can post questions and replies here.
                  <span class="block sm:inline mt-1 sm:mt-0 sm:ml-1">
                    <a href="/contact" class="text-[#CC620A] font-semibold hover:underline underline-offset-2">Start a project &rarr;</a>
                  </span>
                </p>
              </div>
            </div>
          </section>

          <!-- CTA -->
          <section class="bg-[#1C1A17] rounded-2xl overflow-hidden">
            <div class="p-6 sm:p-10 text-center">
              <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-[#EE7B1A] mb-3">This is the deliverable</p>
              <h2 class="text-xl sm:text-2xl lg:text-[1.8rem] font-light text-white leading-tight max-w-xl mx-auto">
                Every Alturascope visit produces a project record that looks like this.
              </h2>
              <p class="mt-4 text-sm text-white/70 max-w-lg mx-auto">
                One brief. One standard. One place your whole team returns to for the life of the project.
              </p>
              <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
                <a href="/contact" class="inline-block bg-[#EE7B1A] hover:bg-[#CC620A] text-white text-sm font-semibold px-6 py-3 rounded-md transition-colors">Start a project</a>
                <a href="/work" class="inline-block border border-white/30 hover:border-white/60 text-white text-sm font-medium px-6 py-3 rounded-md transition-colors">The Standard</a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- Lightbox overlay -->
    <div id="sw-lightbox" class="fixed inset-0 z-[70] bg-black/90 hidden items-center justify-center p-4 sm:p-8" aria-hidden="true">
      <button id="sw-lightbox-close" type="button" class="absolute top-4 right-4 text-white/80 hover:text-white w-10 h-10 flex items-center justify-center" aria-label="Close">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <button id="sw-lightbox-prev" type="button" class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white w-10 h-10 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60" aria-label="Previous">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="sw-lightbox-next" type="button" class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white w-10 h-10 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60" aria-label="Next">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
      </button>
      <figure class="max-w-5xl w-full max-h-full flex flex-col items-center">
        <img id="sw-lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl"/>
        <figcaption id="sw-lightbox-caption" class="mt-4 text-sm text-white/80 text-center max-w-3xl"></figcaption>
      </figure>
    </div>
  </div>

  <style>
    [data-nav-link].sw-nav-active {
      background-color: #FFECD9;
      color: #B25508;
      font-weight: 600;
    }
    .sw-room-body.sw-collapsed {
      display: none;
    }
    .sw-toggle-icon.sw-rotated {
      transform: rotate(-90deg);
    }
    body:has(#sw-lightbox:not(.hidden)) {
      overflow: hidden;
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Lazy-load iframes (mirrors index.astro pattern)
      const iframes = document.querySelectorAll("iframe[data-src]");
      if (iframes.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const f = entry.target;
              if (f.dataset.src) {
                f.src = f.dataset.src;
                delete f.dataset.src;
              }
              io.unobserve(f);
            }
          });
        }, { rootMargin: "200px" });
        iframes.forEach((f) => io.observe(f));
      }

      // Side-nav active-state tracking
      const navLinks = document.querySelectorAll("[data-nav-link]");
      const sections = Array.from(navLinks)
        .map((l) => document.getElementById(l.dataset.target))
        .filter(Boolean);

      if (sections.length && "IntersectionObserver" in window) {
        const activeMap = new Map();
        const navObserver = new IntersectionObserver((entries) => {
          entries.forEach((e) => activeMap.set(e.target.id, e.isIntersecting));
          const firstVisible = sections.find((s) => activeMap.get(s.id));
          if (!firstVisible) return;
          navLinks.forEach((l) => {
            l.classList.toggle("sw-nav-active", l.dataset.target === firstVisible.id);
          });
        }, { rootMargin: "-30% 0px -60% 0px", threshold: 0 });
        sections.forEach((s) => navObserver.observe(s));
      }

      // Room collapse/expand
      document.querySelectorAll(".sw-room-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const article = btn.closest("article");
          if (!article) return;
          const body = article.querySelector(".sw-room-body");
          const label = btn.querySelector(".sw-toggle-label");
          const icon = btn.querySelector(".sw-toggle-icon");
          if (!body) return;
          const collapsed = body.classList.toggle("sw-collapsed");
          btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
          if (label) label.textContent = collapsed ? "Expand" : "Collapse";
          if (icon) icon.classList.toggle("sw-rotated", collapsed);
        });
      });

      // Lightbox
      const lightbox = document.getElementById("sw-lightbox");
      const lbImg = document.getElementById("sw-lightbox-img");
      const lbCaption = document.getElementById("sw-lightbox-caption");
      const lbClose = document.getElementById("sw-lightbox-close");
      const lbPrev = document.getElementById("sw-lightbox-prev");
      const lbNext = document.getElementById("sw-lightbox-next");

      let currentGroup = [];
      let currentIndex = 0;

      function openLightbox(trigger) {
        const group = trigger.dataset.group;
        if (group) {
          currentGroup = Array.from(document.querySelectorAll(`.sw-lightbox-trigger[data-group="${group}"]`));
        } else {
          currentGroup = [trigger];
        }
        currentIndex = Math.max(0, currentGroup.indexOf(trigger));
        renderLightbox();
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        lightbox.setAttribute("aria-hidden", "false");
        const multi = currentGroup.length > 1;
        lbPrev.style.display = multi ? "" : "none";
        lbNext.style.display = multi ? "" : "none";
      }

      function renderLightbox() {
        const t = currentGroup[currentIndex];
        if (!t) return;
        lbImg.src = t.dataset.src;
        lbImg.alt = t.dataset.label || "";
        const pos = currentGroup.length > 1 ? ` (${currentIndex + 1} of ${currentGroup.length})` : "";
        lbCaption.textContent = (t.dataset.label || "") + pos;
      }

      function closeLightbox() {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightbox.setAttribute("aria-hidden", "true");
        lbImg.src = "";
      }

      function step(delta) {
        if (!currentGroup.length) return;
        currentIndex = (currentIndex + delta + currentGroup.length) % currentGroup.length;
        renderLightbox();
      }

      document.querySelectorAll(".sw-lightbox-trigger").forEach((t) => {
        t.addEventListener("click", (e) => {
          e.preventDefault();
          openLightbox(t);
        });
      });

      lbClose?.addEventListener("click", closeLightbox);
      lbPrev?.addEventListener("click", () => step(-1));
      lbNext?.addEventListener("click", () => step(1));
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener("keydown", (e) => {
        if (lightbox.classList.contains("hidden")) return;
        if (e.key === "Escape") closeLightbox();
        else if (e.key === "ArrowLeft") step(-1);
        else if (e.key === "ArrowRight") step(1);
      });
    });
  </script>
</Layout>
