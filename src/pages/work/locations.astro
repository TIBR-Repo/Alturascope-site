---
import Layout from "../../layouts/Layout.astro";
import locations from "../../data/locations.json";
import stories from "../../data/location-stories.json";
import ProjectMap from "../../components/ProjectMap.astro";

// Filter groups. A location can sit in several (a clinic fit-out in an office
// building is both healthcare and office), so each card carries a list.
const sectors = [
  { key: "retail", label: "Retail & malls" },
  { key: "healthcare", label: "Healthcare & clinics" },
  { key: "office", label: "Office & industrial" },
  { key: "landmark", label: "Landmark & transit" },
  { key: "shell", label: "Shells & vacant units" },
];
const countFor = (k) => locations.filter((l) => (l.sectors || []).includes(k)).length;
// Strongest sites first; everything else keeps its order in locations.json.
const lead = [
  "grand-central-terminal-new-york", "westfield-topanga-canoga-park", "the-gardens-mall-palm-beach",
  "lincoln-road-miami-beach", "fifth-avenue-new-york", "scottsdale-fashion-square", "bellevue-square",
  "spectrum-center-irvine", "kierland-commons-scottsdale", "new-york-avenue-washington-dc",
];
const rank = (slug) => (lead.indexOf(slug) === -1 ? 999 : lead.indexOf(slug));
const ordered = [...locations].sort((a, b) => rank(a.slug) - rank(b.slug));

const storySlugs = new Set(stories.map((s) => s.slug));

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Projects",
  "description":
    "A sample of commercial locations documented by Alturascope across the United States - retail, office, mall, industrial and transport sites surveyed on site.",
  "url": "https://alturascope.com/work/locations/",
  "isPartOf": { "@id": "https://alturascope.com/#organization" },
  "mainEntity": { "@id": "https://alturascope.com/work/locations/#itemlist" },
});

// Tell crawlers what the collection actually contains. Each entry is a real
// surveyed building, named by centre or street - never by occupier.
const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  // The CollectionPage above points at this node by @id; without it that
  // mainEntity reference dangles.
  "@id": "https://alturascope.com/work/locations/#itemlist",
  "name": "Commercial sites documented by Alturascope",
  "numberOfItems": locations.length,
  "itemListElement": locations.map((loc, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "ImageObject",
      "name": loc.label,
      "description": `${loc.kind} - commercial site surveyed by Alturascope`,
      "contentUrl": `https://alturascope.com/Images/locations/${loc.slug}.webp`,
      "width": loc.w,
      "height": loc.h,
      "creator": { "@id": "https://alturascope.com/#organization" },
      "copyrightHolder": { "@id": "https://alturascope.com/#organization" },
      // Search Console flags an ImageObject without these three as incomplete
      // Image Metadata. They are also what makes an image eligible for the
      // licensable treatment in Google Images, which links back to us.
      "creditText": "Alturascope",
      "copyrightNotice": `© ${new Date().getFullYear()} Alturascope. All rights reserved.`,
      "license": "https://alturascope.com/terms/#image-licensing",
      "acquireLicensePage": "https://alturascope.com/contact/",
    },
  })),
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://alturascope.com/" },
    { "@type": "ListItem", position: 2, name: "The Standard", item: "https://alturascope.com/work/" },
    { "@type": "ListItem", position: 3, name: "Projects", item: "https://alturascope.com/work/locations/" },
  ],
});
---

<Layout
  title="Projects | Site Survey Portfolio | Alturascope"
  description="A sample of commercial sites documented by Alturascope - retail, office, mall, industrial and transport locations we have surveyed recently."
  canonical="https://alturascope.com/work/locations/"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  extraSchema={itemListSchema}
  fullWidth={true}
>
  <section class="bg-navy pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="max-w-[1100px] mx-auto px-6">
      <p class="label mb-5">Projects</p>
      <h1 class="text-[2.2rem] md:text-[3rem] font-light text-offwhite leading-[1.1] max-w-3xl">
        Inside 500+ commercial spaces across 38 states.
      </h1>
      <p class="mt-6 text-offwhite/70 leading-relaxed max-w-2xl">
        A landmark terminal concourse, luxury malls, high streets, clinics, offices and a fair
        number of empty shells halfway through their next life. Every image here comes from a real
        Alturascope site visit &mdash; not stock photography, and not a render.
      </p>
    </div>
  </section>

  <section class="bg-offwhite py-14 md:py-20 border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-[1fr_2fr] gap-10 lg:gap-14 items-center">
      <div>
        <p class="label mb-4">Where we&rsquo;ve worked</p>
        <h2 class="text-[1.7rem] md:text-[2rem] font-light text-navy leading-tight">
          Coast to coast, and Puerto Rico.
        </h2>
        <p class="mt-5 text-midgrey leading-relaxed">
          Each pin is one of the {locations.length} sites on this page &mdash; a sample of the 500+ we
          have surveyed. Most of our work is delivered under contract and issued under other
          firms&rsquo; names, so it never appears here.
        </p>
        <p class="mt-4 text-midgrey text-[0.9rem] leading-relaxed">
          Locations are identified by centre or street only. Occupiers, suite numbers and lease
          details stay confidential. Where a site opens a story, the findings have been anonymised first.
        </p>
      </div>
      <ProjectMap />
    </div>
  </section>

  <section class="bg-white section-padding" id="projects">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-8">
        <div>
          <p class="label mb-4">Locations</p>
          <h2 class="text-[1.8rem] md:text-[2.1rem] font-light text-navy leading-tight">
            Some of the locations we&rsquo;ve visited recently.
          </h2>
        </div>
        <p class="text-midgrey text-[0.9rem]" aria-live="polite"><span id="project-count">{locations.length}</span> sites shown</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter projects by type">
        <button type="button" class="project-filter is-on" data-filter="all">All projects <span>{locations.length}</span></button>
        {sectors.map((sec) => (
          <button type="button" class="project-filter" data-filter={sec.key}>{sec.label} <span>{countFor(sec.key)}</span></button>
        ))}
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 list-none p-0 m-0">
        {ordered.map((loc) => {
          const story = storySlugs.has(loc.slug);
          const card = (
            <>
              <div class="relative overflow-hidden aspect-[16/10] bg-offwhite">
                <img
                  src={"/Images/locations/" + loc.slug + ".webp"}
                  alt={loc.label + " - commercial site surveyed by Alturascope"}
                  width={loc.w}
                  height={loc.h}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
                <span class="absolute top-3 left-3 bg-navy/85 text-white text-[0.65rem] font-medium uppercase tracking-[0.12em] px-2.5 py-1">{loc.kind}</span>
              </div>
              <h3 class="mt-4 text-navy font-medium leading-snug">{loc.label}</h3>
              {story && (
                <p class="mt-1.5 text-navy text-[0.85rem] font-medium">
                  <span class="border-b border-gold pb-0.5">Read the site story &rarr;</span>
                </p>
              )}
            </>
          );
          return (
            <li id={`site-${loc.slug}`} class="project-card scroll-mt-28" data-sectors={(loc.sectors || []).join(" ")}>
              {story ? <a href={`/work/locations/${loc.slug}/`} class="group block">{card}</a> : <div class="group">{card}</div>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="bg-white section-padding">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="label mb-4">What a Twin Actually Is</p>
          <h2 class="text-[1.8rem] md:text-[2.1rem] font-light text-navy leading-tight">
            Underneath the photography, it&rsquo;s geometry.
          </h2>
          <p class="mt-6 text-midgrey leading-relaxed">
            Strip the panoramic imagery away and what remains is a measured mesh of the floor
            plate &mdash; every wall, column, riser and reveal in its true position. That is why
            a dimension pulled from a twin holds up months later, and why a quantity taken off
            one can be traced back to the surface it came from.
          </p>
          <p class="mt-4 text-midgrey leading-relaxed">
            It is also the reason a survey and an estimate belong on the same platform: the
            measurement and the money come from one record of the building.
          </p>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
            <a href="/services/" class="text-navy font-medium border-b border-gold pb-0.5 hover:opacity-80 transition-opacity">How a survey works &rarr;</a>
            <a href="/estimating/" class="text-navy font-medium border-b border-gold pb-0.5 hover:opacity-80 transition-opacity">Pricing from the same record &rarr;</a>
          </div>
        </div>
        <figure class="bg-navy p-4 md:p-6">
          <img
            src="/Images/locations/digital-twin-mesh.webp"
          srcset="/Images/locations/digital-twin-mesh-640w.webp 640w, /Images/locations/digital-twin-mesh-1024w.webp 1024w, /Images/locations/digital-twin-mesh.webp 1280w"
          sizes="100vw"
            alt="Measured mesh view of a surveyed office floor plate, showing wall and column positions extracted from a Matterport digital twin"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
          <figcaption class="mt-4 text-offwhite/60 text-[0.8rem] leading-relaxed">
            Mesh view of a surveyed office floor plate &mdash; Chelmsford, Massachusetts. The same
            capture that produces the walkthrough produces this.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-navy section-padding">
    <div class="max-w-[900px] mx-auto px-6 text-center">
      <p class="label mb-8">Client Reference</p>
      <blockquote class="text-[1.25rem] md:text-[1.5rem] font-light text-offwhite leading-relaxed">
        &ldquo;You have been great so far, and deliver exceptional quality reports and data,
        miles ahead of our previous reports. Your response time is on par as well, and the
        urgency in your scope is never overlooked. Here&rsquo;s to 22 more locations!&rdquo;
      </blockquote>
      <p class="mt-8 text-offwhite/60 text-[0.9rem]">
        Nathaniel Lindley &mdash; Construction Manager, West Coast
      </p>
      <p class="mt-1 text-offwhite/40 text-[0.8rem]">
        National retail rollout programme
      </p>
    </div>
  </section>

  <section class="bg-white section-padding">
    <div class="max-w-[760px] mx-auto px-6 text-center">
      <h2 class="text-[1.8rem] md:text-[2.1rem] font-light text-navy leading-tight">
        Your building next.
      </h2>
      <p class="mt-6 text-midgrey leading-relaxed">
        One site or a hundred, the standard is the same and travel is included. Tell us where
        the buildings are and what the programme needs to answer.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="/contact/" class="btn-primary">Discuss a survey</a>
        <a href="/estimating/sample-quote-pack/" class="btn-secondary">See a priced estimate pack</a>
      </div>
    </div>
  </section>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".project-filter");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    const pins = document.querySelectorAll<SVGAElement>(".map-pin");
    const count = document.getElementById("project-count");
    const apply = (key: string) => {
      let shown = 0;
      cards.forEach((c) => {
        const on = key === "all" || (c.dataset.sectors || "").split(" ").includes(key);
        c.hidden = !on;
        if (on) shown++;
      });
      pins.forEach((p) => {
        const on = key === "all" || (p.dataset.sectors || "").split(" ").includes(key);
        p.classList.toggle("is-dim", !on);
      });
      buttons.forEach((b) => b.classList.toggle("is-on", b.dataset.filter === key));
      if (count) count.textContent = String(shown);
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter || "all")));
  </script>
</Layout>

