---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Site Surveys & Documentation — Northeast US",
  "description": "Pre-construction site documentation across the Northeast — New York, Boston, Philadelphia, Washington DC, and the I-95 corridor. Matterport digital twins, conditions reports, and equipment schedules for renovation and rollout programmes.",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Alturascope",
    "url": "https://alturascope.com/",
    "areaServed": [
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "Canada" },
      { "@type": "Country", "name": "United Kingdom" }
    ]
  },
  "serviceType": "Pre-Construction Site Documentation — Northeast US",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Site Documentation Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Navigable Digital Twin" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Conditions Report" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Equipment & Asset Schedule" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ScopeWalk Platform Access" } }
    ]
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://alturascope.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "Northeast Site Surveys", "item": "https://alturascope.com/services/northeast-site-surveys/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you cover all Northeast states?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We operate across every state in the Northeast — New York, New Jersey, Connecticut, Massachusetts, Pennsylvania, Maryland, Virginia, Washington DC, Maine, New Hampshire, Vermont, Rhode Island, and Delaware. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time." }
    },
    {
      "@type": "Question",
      "name": "Can you survey occupied buildings in dense urban environments?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We routinely survey occupied commercial buildings in Manhattan, downtown Boston, Center City Philadelphia, and other dense urban cores. We coordinate with building management for access, freight elevator scheduling, and any tenant notifications. Our capture process is non-disruptive and can work around active operations, office tenants, and retail trading hours." }
    },
    {
      "@type": "Question",
      "name": "How do you handle pre-war buildings with undocumented modifications?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pre-war and legacy buildings are where our methodology delivers the most value. Traditional as-built drawings often do not exist for these structures, and whatever drawings do exist rarely reflect decades of tenant modifications, MEP upgrades, and structural alterations. Our conditions survey documents the building as it actually is — not as it was designed. Thermal imaging reveals hidden services and moisture intrusion. Above-ceiling capture documents the real routing and condition of MEP systems. The result is a current, accurate baseline that design teams can actually rely on." }
    },
    {
      "@type": "Question",
      "name": "What types of projects do you typically document in the Northeast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our Northeast work spans the full range of commercial renovation and rollout documentation: office-to-residential conversions in Manhattan and Brooklyn, multi-site retail refreshes along the I-95 corridor, QSR remodel programmes across the tri-state area, healthcare campus renovations in Boston and Philadelphia, and pre-construction documentation for design-build firms working on renovation projects in occupied buildings. The common thread is that these projects require more than a floor plan — they require a complete picture of existing conditions before the design is committed." }
    }
  ]
});
---
<Layout
  title="Site Surveys & Documentation — Northeast US | Alturascope"
  description="Pre-construction site documentation across the Northeast — New York, Boston, Philadelphia, Washington DC, and the I-95 corridor."
  canonical="https://alturascope.com/services/northeast-site-surveys/"
  ogImage="/Images/stock/1534430480872-3498386e7856.webp"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-[100vh] md:min-h-0 md:h-[60vh] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <img
          src="/Images/site-interior-1.webp"
          srcset="/Images/site-interior-1-640w.webp 640w, /Images/site-interior-1-1024w.webp 1024w, /Images/site-interior-1.webp 1600w"
          sizes="100vw"
          width="1600"
          height="1205"
          alt="Aerial orthographic survey of a commercial roof captured by Alturascope in the northeastern United States"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>
      <div class="relative z-10 text-center px-6 pt-28 pb-16 md:pt-0 md:pb-0 max-w-[900px] mx-auto">
        <p class="label text-gold mb-4">Regional Coverage &middot; Northeast US</p>
        <h1 class="text-[1.8rem] md:text-[3.2rem] font-light text-offwhite leading-tight">
          Site Surveys &amp; Pre-Construction Documentation — Northeast United States
        </h1>
        <p class="mt-6 text-offwhite/70 leading-body max-w-[720px] mx-auto">
          From Manhattan high-rises to Boston medical campuses to Philadelphia's commercial core — the Northeast demands pre-construction documentation that accounts for dense urban environments, ageing building stock, and some of the strictest permitting requirements in the country. AlturaScope delivers structured site intelligence across the entire I-95 corridor and beyond.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn-primary">Start a Project</a>
          <a href="/services/" class="btn-secondary-light">How It Works</a>
        </div>
      </div>
    </section>

    <!-- Why Documentation Matters in the Northeast -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Northeast Market</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Why pre-construction documentation matters here.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            The Northeast presents a construction documentation challenge unlike any other region. Dense urban environments mean tight access, occupied buildings, and high-rise interiors where logistics are as complex as the project itself. Multi-tenant commercial buildings in New York, Boston, and Philadelphia often require coordination with building management, freight elevator scheduling, and surveys conducted around active operations — none of which a remote surveyor or local freelancer is equipped to manage consistently.
          </p>
          <p>
            The region's building stock compounds the challenge. Pre-war structures with undocumented modifications across decades of tenancy. MEP systems that have been upgraded, extended, and rerouted over generations without updated drawings. Above-ceiling conditions that bear no resemblance to whatever original plans may still exist. For renovation and conversion projects — office-to-residential, retail refreshes, healthcare campus upgrades — the gap between what is assumed and what actually exists is where change orders originate.
          </p>
          <p>
            Permitting environments in the Northeast are among the most demanding in the country. NYC DOB, Boston ISD, and Philadelphia L&I all require accurate existing conditions documentation as part of permit submissions. A pre-construction site survey that produces only a floor plan leaves the design team without the conditions evidence these authorities expect — and without the detail that prevents costly revisions during the permitting process.
          </p>
        </div>
      </div>
    </section>

    <!-- What We Deliver -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Deliverable</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Structured site intelligence. Every project.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Every AlturaScope site visit in the Northeast produces the same structured deliverable package — whether the project is a single-floor office survey in Midtown Manhattan or a multi-building healthcare campus assessment in Boston.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Navigable Digital Twin</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Matterport-based 3D model of the entire space. Remote access for the full project team. Measurements taken directly in the model.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Conditions Report</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              P1/P2/P3 prioritised assessment of existing conditions — structural, MEP, finishes, code compliance, accessibility.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Equipment &amp; Asset Schedule</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Full inventory by location, make, model, condition, and services connections. Formatted for procurement and design teams.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Thermal Imaging (FLIR)</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Non-invasive identification of hidden services, moisture intrusion, electrical loads, and HVAC performance anomalies.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Above-Ceiling MEP Documentation</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Thermal, pole-mounted 360&deg;, and borescope capture of ceiling plenum conditions, services routing, and conflicts.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">ScopeWalk Platform</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              All deliverables structured in a single portal. Permanent access. For multi-site programmes: compare locations side by side.
            </p>
          </div>
        </div>

        <a href="/services/pre-construction-site-intelligence/" class="inline-block mt-10 text-navy font-medium hover:opacity-80 transition-opacity">
          Full detail on the AlturaScope deliverable &rarr;
        </a>
      </div>
    </section>

    <!-- Markets We Serve -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Sectors</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Markets we serve in the Northeast.
        </h2>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">QSR &amp; Restaurant</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              The Northeast's QSR and restaurant market is concentrated in some of the most operationally challenging environments in the country — dense urban cores, limited access hours, occupied spaces, and buildings with complex MEP infrastructure. Our <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant survey programme</a> is built for exactly this context: single-visit capture, off-peak scheduling, and consistent deliverables across every location in the tri-state area and beyond.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Retail &amp; Franchise</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              Retail refreshes and rebrands in Northeast urban cores present unique documentation challenges — from flagship locations in Manhattan and Boston's Back Bay to strip-mall remodels along the I-95 corridor. Our <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">retail rollout documentation</a> delivers the same structured package at every store, regardless of format or location.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Healthcare</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              The Northeast is home to some of the largest and most complex healthcare networks in the country. Capital planning programmes across multi-building hospital campuses, satellite clinics, and medical office buildings require documentation that accounts for dense MEP infrastructure, compliance requirements, and operational sensitivity. Our <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">healthcare facility survey</a> methodology is designed for exactly this environment.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Commercial Renovation &amp; Conversion</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              Office-to-residential conversions in Manhattan and Brooklyn. Mixed-use renovation in Philadelphia. Adaptive reuse in Boston's waterfront district. These projects depend on thorough pre-construction documentation of existing conditions — structural, MEP, above-ceiling, and equipment — before the design is committed. Our <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">construction documentation</a> service delivers the complete picture.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage and Logistics -->
    <section class="bg-navy section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Logistics</p>
        <h2 class="text-[2rem] font-light text-offwhite leading-tight">
          No local subcontractors. No variability.
        </h2>
        <div class="mt-6 space-y-4 text-offwhite/70 leading-body">
          <p>
            AlturaScope operates under a national travel model. Every site visit in the Northeast — whether it is in midtown Manhattan, suburban New Jersey, or rural Connecticut — is conducted by AlturaScope using the same methodology, the same equipment, and the same deliverable standard. There is no local subcontractor lottery. Travel costs are included in all project pricing.
          </p>
          <p>
            For multi-site programmes running across the Northeast — or across the entire US — we coordinate scheduling centrally. Your team briefs us once, and we manage access, timing, and logistics directly with each location. For programmes requiring simultaneous coverage across multiple states, we mobilise in parallel to compress your pre-construction timeline.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Common questions about Northeast site surveys.</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you cover all Northeast states?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We operate across every state in the Northeast — New York, New Jersey, Connecticut, Massachusetts, Pennsylvania, Maryland, Virginia, Washington DC, Maine, New Hampshire, Vermont, Rhode Island, and Delaware. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you survey occupied buildings in dense urban environments?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We routinely survey occupied commercial buildings in Manhattan, downtown Boston, Center City Philadelphia, and other dense urban cores. We coordinate with building management for access, freight elevator scheduling, and any tenant notifications. Our capture process is non-disruptive and can work around active operations, office tenants, and retail trading hours.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              How do you handle pre-war buildings with undocumented modifications?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Pre-war and legacy buildings are where our methodology delivers the most value. Traditional as-built drawings often do not exist for these structures, and whatever drawings do exist rarely reflect decades of tenant modifications, MEP upgrades, and structural alterations. Our conditions survey documents the building as it actually is — not as it was designed. Thermal imaging reveals hidden services and moisture intrusion. Above-ceiling capture documents the real routing and condition of MEP systems. The result is a current, accurate baseline that design teams can actually rely on.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What types of projects do you typically document in the Northeast?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Our Northeast work spans the full range of commercial renovation and rollout documentation: office-to-residential conversions in Manhattan and Brooklyn, multi-site retail refreshes along the I-95 corridor, QSR remodel programmes across the tri-state area, healthcare campus renovations in Boston and Philadelphia, and pre-construction documentation for design-build firms working on renovation projects in occupied buildings. The common thread is that these projects require more than a floor plan — they require a complete picture of existing conditions before the design is committed.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-white section-padding">
      <div class="max-w-[700px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">Ready to start?</h2>
        <p class="mt-4 text-midgrey leading-body">
          Tell us about the site, the project scope, and what your team needs to decide. We will come back with a clear proposal and an all-in quote — travel included.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm">
          <a href="/services/pre-construction-site-intelligence/" class="text-navy font-medium hover:opacity-80 transition-opacity">The full AlturaScope deliverable &rarr;</a>
          <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant surveys &rarr;</a>
          <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Retail rollout documentation &rarr;</a>
          <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Healthcare facility surveys &rarr;</a>
          <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction documentation &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
