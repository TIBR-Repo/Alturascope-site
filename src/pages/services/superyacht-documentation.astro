import SpecialtyPage from "../../components/SpecialtyPage.astro";
---
<SpecialtyPage
  title="Superyacht & Luxury Vessel Documentation | Matterport 3D Scan | Alturascope"
  description="Matterport digital twins and structured documentation for superyachts and luxury vessels. Charter marketing, refit planning, and condition records."
  canonical="https://alturascope.com/services/superyacht-documentation"
  h1="Superyacht and luxury vessel documentation."
  heroImage="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?w=1920&q=80"
  heroAlt="Luxury vessel interior with rich materials and atmospheric lighting showing premium nautical environment"
  heroPlaceholder="Hero — luxury vessel interior or dramatic nautical space. Rich materials, atmospheric lighting."
  openingLabel="Vessel Documentation"
  openingBody="A superyacht is a complex, high-value asset in constant motion — which makes accurate documentation both more difficult and more important than for a static building. Alturascope produces Matterport digital twins and structured condition documentation for luxury vessels: for charter marketing, pre-purchase diligence, refit planning, and the ongoing asset management that significant vessels require."
  whatWeDocumentBody="Complete interior — saloons, cabins, galley, engine room access areas, deck spaces. Equipment and systems inventory. Condition of surfaces, fittings, and installed equipment. Areas accessible by conventional survey and those requiring specialist access techniques. The documentation captures the vessel as it exists, with the precision that high-value asset management demands."
  whatYouReceiveBody="Matterport digital twin, equipment and asset schedule formatted for refit specification, narrated walkthrough, conditions report, and labeled photo storyboard. All delivered through ScopeWalk and accessible to your management team, brokers, or refit yard as needed."
  whoThisIsForBody="Yacht brokers, charter operators, refit yards, yacht management companies, and private owners. Whether you need marketing documentation that shows the vessel at its best, a pre-purchase condition record, or a complete survey to support refit planning — the deliverable is structured for the decision you're making."
  faqs={[
    { question: "What does a superyacht Matterport scan include?", answer: "A full vessel documentation survey includes a Matterport digital twin of all accessible interior spaces, an equipment and asset schedule documenting installed systems and fittings, a narrated walkthrough with commentary on conditions and areas of note, a conditions report, and a labeled photo storyboard. The scope is tailored to the vessel and the purpose of the documentation — whether that's charter marketing, refit planning, or asset management." },
    { question: "How is yacht documentation used in refit planning?", answer: "For refit planning, the Matterport digital twin allows designers and yard teams to explore the vessel remotely, take measurements, and understand spatial constraints before work begins. The equipment schedule provides a complete inventory of installed systems formatted for specification work. The conditions report identifies areas requiring attention with prioritised findings. Together, these deliverables give the refit team a complete picture of the vessel without needing multiple on-board visits." },
    { question: "Can you document vessels anywhere in the US or Caribbean?", answer: "Yes. We operate a national travel model across the US and can mobilise to any marina or shipyard location. For vessels in the Caribbean, we can arrange documentation visits by arrangement. Travel costs are included in project pricing — there are no surprise charges. Contact us with the vessel's location and we'll confirm logistics." },
    { question: "What is the difference between a marketing scan and a full documentation survey?", answer: "A marketing scan focuses on presenting the vessel at its best for charter or brokerage purposes — the Matterport digital twin serves as an immersive virtual tour that potential clients or buyers can navigate. A full documentation survey goes further: it includes a complete equipment inventory, a conditions assessment, above-deck and below-deck documentation, and a structured report. The purpose determines the scope." },
    { question: "How long does a full vessel documentation survey take?", answer: "Duration depends on the vessel size and the scope of documentation required. A standard survey of a 30-40 metre vessel typically takes one full day on board. Larger vessels or more comprehensive documentation scopes may require two days. We confirm the schedule during the brief and coordinate with the vessel's crew or management team to ensure minimal disruption." }
  ]}
  internalLinks={[
