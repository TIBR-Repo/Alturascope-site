---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Site Surveys & Documentation — West Coast US",
  "description": "Site documentation for construction and renovation projects across the West Coast — Los Angeles, San Francisco, Seattle, Portland. Seismic assessment documentation, conditions surveys, and Matterport digital twins.",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Alturascope",
    "url": "https://alturascope.com/",
    "areaServed": [
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "Canada" },
      { "@type": "Country", "name": "United Kingdom" }
    ]
  },
  "serviceType": "Pre-Construction Site Documentation — West Coast US",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Site Documentation Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Navigable Digital Twin" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Conditions Report" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Equipment & Asset Schedule" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ScopeWalk Platform Access" } }
    ]
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://alturascope.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "West Coast Site Surveys", "item": "https://alturascope.com/services/west-coast-site-surveys/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you cover all West Coast states?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We operate across every state on the West Coast — California, Oregon, Washington, Nevada, Arizona, and Hawaii. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time." }
    },
    {
      "@type": "Question",
      "name": "How does your documentation support renovation projects in seismic zones?",
      "acceptedAnswer": { "@type": "Answer", "text": "Renovation projects in seismic zones require thorough documentation of existing structural conditions — not just dimensions, but the actual condition of structural elements, connections, and any modifications made since original construction. Our conditions report documents structural observations including visible cracking, settlement, and previous retrofit work. Above-ceiling capture reveals structural connections and bracing that are concealed by finishes. This baseline documentation supports the structural engineer's seismic assessment and helps the design team understand the existing structural system before committing to a renovation strategy." }
    },
    {
      "@type": "Question",
      "name": "Why is pre-construction documentation especially valuable on the West Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "West Coast construction costs are among the highest in the country — labour rates frequently exceed $150 per hour for skilled trades. At those rates, every prevented change order has an outsized financial impact. Thorough pre-construction documentation that captures conditions, equipment, above-ceiling infrastructure, and thermal anomalies before the design is committed reduces the scope surprises that generate the most expensive change orders. The documentation investment is proportionally small relative to the cost of the construction it informs." }
    },
    {
      "@type": "Question",
      "name": "Can you support multi-site programmes across the West Coast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We deliver the same structured documentation package at every location through ScopeWalk, coordinate scheduling centrally, and mobilise across multiple states in parallel when timelines require it. For national programmes that include West Coast locations alongside sites in other regions, we provide the same deliverable standard coast to coast — your team works from one format regardless of where the building is." }
    }
  ]
});
---
<Layout
  title="Site Surveys & Documentation — West Coast US | Alturascope"
  description="Site documentation for construction and renovation projects across the West Coast — Los Angeles, San Francisco, Seattle, Portland."
  canonical="https://alturascope.com/services/west-coast-site-surveys/"
  ogImage="/Images/stock/1449034446853-66c86144b0ad.webp"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-[100vh] md:min-h-0 md:h-[60vh] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <img
          src="/Images/drone-shot-1.webp"
          srcset="/Images/drone-shot-1-640w.webp 640w, /Images/drone-shot-1-1024w.webp 1024w, /Images/drone-shot-1.webp 1600w"
          sizes="100vw"
          width="1600"
          height="900"
          alt="Aerial orthographic survey of a commercial site captured by Alturascope on the west coast"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>
      <div class="relative z-10 text-center px-6 pt-28 pb-16 md:pt-0 md:pb-0 max-w-[900px] mx-auto">
        <p class="label text-gold mb-4">Regional Coverage &middot; West Coast US</p>
        <h1 class="text-[1.8rem] md:text-[3.2rem] font-light text-offwhite leading-tight">
          Site Surveys &amp; Pre-Construction Documentation — West Coast United States
        </h1>
        <p class="mt-6 text-offwhite/70 leading-body max-w-[720px] mx-auto">
          The West Coast combines high construction costs, stringent code requirements, and seismic considerations that make thorough pre-construction documentation especially valuable. AlturaScope delivers structured site intelligence across Los Angeles, San Francisco, Seattle, Portland, and every market in between.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn-primary">Start a Project</a>
          <a href="/services/" class="btn-secondary-light">How It Works</a>
        </div>
      </div>
    </section>

    <!-- Why Documentation Matters on the West Coast -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The West Coast Market</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Why pre-construction documentation matters here.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Seismic considerations shape every renovation project on the West Coast. Existing conditions documentation is not optional in seismic zones — it is foundational. The structural engineer's assessment depends on understanding what is actually built, not what the original drawings show. Previous seismic retrofits, undocumented structural modifications, concealed connections, and the actual condition of structural elements all affect the renovation strategy. Our conditions survey and above-ceiling capture document these conditions so the design team works from accurate information rather than assumptions.
          </p>
          <p>
            Stringent energy and sustainability code requirements add another dimension. California's Title 24 and similar frameworks in Oregon and Washington demand accurate documentation of existing HVAC systems, lighting, insulation, and building envelope performance as part of the compliance process for renovation projects. FLIR thermal imaging documents these conditions non-invasively — identifying insulation gaps, HVAC performance anomalies, and building envelope deficiencies that must be addressed to meet code requirements.
          </p>
          <p>
            West Coast construction costs are among the highest in the country. Skilled trade labour rates frequently exceed $150 per hour. At those rates, every prevented change order has an outsized financial impact. The cost of thorough pre-construction documentation is proportionally small relative to the construction budget it informs — and the <a href="/insights/why-poor-site-documentation-costs-construction-projects/" class="text-navy font-medium hover:opacity-80 transition-opacity">cost of incomplete documentation</a> is proportionally large. A single scope surprise on a West Coast renovation project can cost more than the entire documentation investment.
          </p>
        </div>
      </div>
    </section>

    <!-- What We Deliver -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Deliverable</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Structured site intelligence. Every project.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Every AlturaScope site visit on the West Coast produces the same structured deliverable package — whether the project is a single office conversion in San Francisco or a multi-site retail refresh across Southern California.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Navigable Digital Twin</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Matterport-based 3D model of the entire space. Remote access for the full project team. Measurements taken directly in the model.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Conditions Report</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              P1/P2/P3 prioritised assessment of existing conditions — structural, seismic observations, MEP, finishes, code compliance, accessibility.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Equipment &amp; Asset Schedule</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Full inventory by location, make, model, condition, and services connections. Formatted for procurement and design teams.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Thermal Imaging (FLIR)</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Building envelope analysis, insulation verification, HVAC performance assessment, and hidden services identification — supporting Title 24 and energy code compliance.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Above-Ceiling MEP Documentation</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Thermal, pole-mounted 360&deg;, and borescope capture of ceiling plenum conditions, structural connections, services routing, and conflicts.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">ScopeWalk Platform</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              All deliverables structured in a single portal. Permanent access. For multi-site programmes: compare locations side by side.
            </p>
          </div>
        </div>

        <a href="/services/pre-construction-site-intelligence/" class="inline-block mt-10 text-navy font-medium hover:opacity-80 transition-opacity">
          Full detail on the AlturaScope deliverable &rarr;
        </a>
      </div>
    </section>

    <!-- Markets We Serve -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Sectors</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Markets we serve on the West Coast.
        </h2>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">QSR &amp; Restaurant</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              West Coast QSR and restaurant remodel programmes operate in some of the most expensive construction markets in the country — where every change order carries a disproportionate cost. Our <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant survey programme</a> captures the complete picture at every location in a single visit: equipment schedules, conditions reports, above-ceiling MEP documentation, and commercial kitchen detail. Complete information upfront means fewer surprises during construction — and at West Coast labour rates, that translates directly to budget saved.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Retail &amp; Franchise</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              National retail refreshes and rebrands include significant West Coast portfolios — from flagship locations in Beverly Hills and Union Square to strip-mall remodels across suburban Southern California and the Pacific Northwest. Our <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">retail rollout documentation</a> delivers the same structured package at every store, with conditions data and equipment inventories that account for the seismic and energy code requirements specific to West Coast locations.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Healthcare</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              West Coast healthcare networks face the intersection of complex MEP infrastructure, seismic compliance requirements, and stringent energy codes. Capital planning programmes across multi-facility networks require documentation that captures all of these dimensions. Our <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">healthcare facility survey</a> methodology documents the structural, MEP, equipment, and compliance conditions that capital planning teams need to prioritise projects and allocate budget with confidence.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Commercial Renovation &amp; Conversion</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              Tech sector office renovation and conversion projects. Adaptive reuse in San Francisco, Seattle, and Portland. Mixed-use development in Los Angeles. These projects depend on thorough <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">pre-construction documentation</a> that captures structural conditions relevant to seismic assessment, MEP infrastructure, above-ceiling routing, and building envelope performance. In markets where construction costs make every prevented change order worth thousands, the documentation investment pays for itself on the first avoided surprise.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage and Logistics -->
    <section class="bg-navy section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Logistics</p>
        <h2 class="text-[2rem] font-light text-offwhite leading-tight">
          No local subcontractors. No variability.
        </h2>
        <div class="mt-6 space-y-4 text-offwhite/70 leading-body">
          <p>
            AlturaScope operates under a national travel model. Every site visit on the West Coast — whether it is in downtown Los Angeles, suburban Portland, or a resort town in Hawaii — is conducted by AlturaScope using the same methodology, the same equipment, and the same deliverable standard. There is no local subcontractor lottery. Travel costs are included in all project pricing.
          </p>
          <p>
            For multi-site programmes running across the West Coast — or across the entire US — we coordinate scheduling centrally. Your team briefs us once, and we manage access, timing, and logistics directly with each location. For programmes requiring simultaneous coverage across multiple states, we mobilise in parallel to compress your pre-construction timeline.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Common questions about West Coast site surveys.</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you cover all West Coast states?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We operate across every state on the West Coast — California, Oregon, Washington, Nevada, Arizona, and Hawaii. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              How does your documentation support renovation projects in seismic zones?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Renovation projects in seismic zones require thorough documentation of existing structural conditions — not just dimensions, but the actual condition of structural elements, connections, and any modifications made since original construction. Our conditions report documents structural observations including visible cracking, settlement, and previous retrofit work. Above-ceiling capture reveals structural connections and bracing that are concealed by finishes. This baseline documentation supports the structural engineer's seismic assessment and helps the design team understand the existing structural system before committing to a renovation strategy.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Why is pre-construction documentation especially valuable on the West Coast?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              West Coast construction costs are among the highest in the country — labour rates frequently exceed $150 per hour for skilled trades. At those rates, every prevented change order has an outsized financial impact. Thorough pre-construction documentation that captures conditions, equipment, above-ceiling infrastructure, and thermal anomalies before the design is committed reduces the scope surprises that generate the most expensive change orders. The documentation investment is proportionally small relative to the cost of the construction it informs.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you support multi-site programmes across the West Coast?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We deliver the same structured documentation package at every location through ScopeWalk, coordinate scheduling centrally, and mobilise across multiple states in parallel when timelines require it. For national programmes that include West Coast locations alongside sites in other regions, we provide the same deliverable standard coast to coast — your team works from one format regardless of where the building is.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-white section-padding">
      <div class="max-w-[700px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">Ready to start?</h2>
        <p class="mt-4 text-midgrey leading-body">
          Tell us about the site, the project scope, and what your team needs to decide. We will come back with a clear proposal and an all-in quote — travel included.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm">
          <a href="/services/pre-construction-site-intelligence/" class="text-navy font-medium hover:opacity-80 transition-opacity">The full AlturaScope deliverable &rarr;</a>
          <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant surveys &rarr;</a>
          <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Retail rollout documentation &rarr;</a>
          <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Healthcare facility surveys &rarr;</a>
          <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction documentation &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
