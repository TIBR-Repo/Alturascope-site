---
import Layout from "../../layouts/Layout.astro";
import GalleryBand from "../../components/GalleryBand.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Site Documentation Services",
  "description": "Reality capture, as-built documentation, conditions surveys and multi-site programmes across the US, Canada and the UK.",
  "url": "https://alturascope.com/services/",
  "isPartOf": {
    "@id": "https://alturascope.com/#organization"
  }
});
---
<Layout
  title="Existing Conditions &amp; As-Built Surveys | Alturascope"
  description="Existing conditions surveys, as-built records and pre-lease due diligence for multi-site operators - and construction estimating from the same record."
  canonical="https://alturascope.com/services/"
  schema={schema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center">
      <!-- REPLACE: Dark atmospheric commercial or industrial interior, different from homepage hero. -->
      <div class="absolute inset-0 bg-navy">
        <img
          src="/Images/drone-shot-1.webp"
          width="1600"
          height="900"
          alt="Aerial orthographic view of a commercial roof and rooftop plant captured by Alturascope during a site survey"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>
      <div class="relative z-10 text-center px-6">
        <h1 class="text-[2.4rem] md:text-[3.2rem] font-light text-offwhite leading-tight">Surveys that answer what the building will cost you.</h1>
      </div>
    </section>

    <!-- Core Service -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Core Service</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Site documentation for construction teams and project managers.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Our standard visit covers everything a project team needs to make decisions on a space — from pre-lease diligence to pre-construction capture to renovation documentation. We align on your brief before we arrive, follow a disciplined capture route on site, and deliver a structured package within three to five business days.
          </p>
          <p>
            The deliverable is always the same architecture: digital twin, narrated walkthrough, conditions report, equipment schedule where relevant, labeled photo storyboard, and ScopeWalk platform access. Consistent enough to compare across sites. Detailed enough to brief your consultants directly.
          </p>
        </div>
        <a href="/services/construction-documentation/" class="inline-block mt-8 text-navy font-medium hover:opacity-80 transition-opacity">
          Full detail on construction and commercial documentation &rarr;
        </a>
      </div>
    </section>

    <!-- Rollout & Multi-Site Programmes -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <p class="label text-gold mb-4">Rollout Programmes</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          The same standard. Across every site in your programme.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body max-w-[900px]">
          <p>
            For operators running rollout programmes — retail rebrand, QSR reimage, healthcare expansion, franchise build-out — consistency is the deliverable. Every site produces the same structured package through ScopeWalk, in the same format, accessible in the same place. Your design team briefs from the same information on site one as they do on site fifty.
          </p>
          <p>
            We coordinate access and travel nationally, with programme pricing that includes travel costs rather than adding them per visit.
          </p>
        </div>
        <a href="/services/multi-site-rollout-documentation/" class="inline-block mt-6 text-navy font-medium hover:opacity-80 transition-opacity">
          How multi-site programmes work &rarr;
        </a>

        <!-- Sector Cards -->
        <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/services/qsr-restaurant-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">QSR &amp; RESTAURANT</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Restaurant Remodel &amp; Reimage Programmes</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Kitchen equipment schedules, above-ceiling MEP documentation, and conditions reports — consistent across every location in the programme.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/aba-autism-clinic-documentation/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">ABA &amp; AUTISM THERAPY</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">ABA Clinic Documentation</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Hundreds of clinics documented. Sensory rooms, acoustic separation, elopement prevention, ceiling heights, and everything PE-backed platforms need.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/retail-rollout-documentation/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">RETAIL &amp; FRANCHISE</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Retail Rebrand &amp; Refresh Programmes</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Prototype adaptation across dozens of locations. Equipment schedules, storefront conditions, and above-ceiling documentation at every site.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/healthcare-facility-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">HEALTHCARE</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Healthcare Network Programmes</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Dental, urgent care, veterinary, and medical office documentation. Clinical equipment, MEP density, and compliance-relevant conditions.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/veterinary-clinic-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">VETERINARY</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Veterinary Practice Surveys</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Imaging shielding, kennel drainage, isolation ventilation and the electrical capacity to run it &mdash; across acquired practices nobody ever documented.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/dental-practice-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">DENTAL &amp; DSO</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Dental Practice Surveys</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Chair services, compressed air and vacuum, panel capacity and what is really in the slab &mdash; before the operatory count is fixed.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/medical-aesthetics-clinic-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">MED SPA &amp; AESTHETICS</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Med Spa &amp; Aesthetics Clinics</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Device power, treatment-room plumbing, plume extraction and laser-safe layout &mdash; tested against the unit before the lease is signed.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/behavioral-health-clinic-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">BEHAVIORAL HEALTH</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Behavioral Health &amp; Treatment Clinics</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Ligature risk in the existing fabric, observation sightlines, acoustic confidentiality and separated circulation.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/fitness-studio-survey/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">FITNESS &amp; STUDIO</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Fitness &amp; Boutique Studios</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Floor loading, impact noise to the tenancy below, and clear height measured under the services rather than to the slab.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>

          <a href="/services/cannabis-facility-documentation/" class="group block bg-white rounded p-8 border border-border transition-all duration-300 hover:border-gold hover:shadow-md">
            <p class="label text-gold text-[0.65rem] mb-3">CANNABIS</p>
            <h3 class="text-[1.1rem] font-medium text-navy leading-snug group-hover:opacity-80 transition-opacity">Dispensary &amp; Cultivation Surveys</h3>
            <p class="mt-3 text-midgrey text-[0.85rem] leading-relaxed">Electrical capacity, dehumidification, odour discharge and limited-access separation &mdash; before the licence clock starts.</p>
            <span class="inline-block mt-4 text-navy text-sm font-medium">Learn more &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Specialist Work -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Specialist Work</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Some projects require a different kind of attention.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Beyond our core commercial work, we take on projects where the brief is specific, the environment is significant, or the standard approach won't do. We've documented spaces that required specialist access techniques, precision equipment, and a level of discretion that most survey operators aren't equipped to offer.
          </p>
          <p>
            If your project is unusual — in its location, its complexity, or what it requires of the people doing the work — we'd like to hear about it.
          </p>
        </div>
        <a href="/services/specialist-projects/" class="inline-block mt-8 text-navy font-medium hover:opacity-80 transition-opacity">
          Tell us about your project &rarr;
        </a>
      </div>
    </section>

    <!-- The Process -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy text-center mb-16">
          How it works.
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
          <div>
            <p class="text-gold text-[2rem] font-light mb-3">01</p>
            <h3 class="text-navy font-medium mb-3">Clarify the brief</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              We align on what you're deciding, what your team needs to see, and what the deliverable needs to do before anyone travels anywhere.
            </p>
          </div>
          <div>
            <p class="text-gold text-[2rem] font-light mb-3">02</p>
            <h3 class="text-navy font-medium mb-3">Coordinate access</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              We handle building management, security coordination, and travel logistics. National travel model means no surprises on costs.
            </p>
          </div>
          <div>
            <p class="text-gold text-[2rem] font-light mb-3">03</p>
            <h3 class="text-navy font-medium mb-3">Capture the site</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              On site we follow a disciplined route documented through ScopeWalk in real time — structure, services, equipment, conditions, access. Nothing missed.
            </p>
          </div>
          <div>
            <p class="text-gold text-[2rem] font-light mb-3">04</p>
            <h3 class="text-navy font-medium mb-3">Deliver and access</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              Digital twin, report, walkthrough, and schedule delivered within three to five business days and permanently accessible through ScopeWalk.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Estimating cross-link -->
    <section class="bg-navy section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Other Half</p>
        <h2 class="text-[2rem] font-light text-offwhite leading-tight">
          Once you know the building, we can price the work.
        </h2>
        <div class="mt-6 space-y-4 text-offwhite/70 leading-body">
          <p>
            Documentation answers what you are working with. The next question is always what it will cost. The <a href="/estimating/" class="text-gold hover:opacity-80 transition-opacity">Alturascope Estimating Desk</a> prices bid packages for contractors &mdash; drawings in, a priced and machine-audited bid back under your own name, usually inside two working days.
          </p>
          <p>
            On a renovation the two run together. We survey the site and price the work from the same record, so the estimate is built on the building as it stands rather than the drawing as it was drawn. No other estimating bureau can survey the building; no other survey firm can price the work.
          </p>
        </div>
        <a href="/estimating/" class="btn-primary mt-8">See the Estimating Desk</a>
      </div>
    </section>

    <GalleryBand />

    <!-- Internal Links -->
    <section class="bg-white py-12">
      <div class="max-w-[900px] mx-auto px-6 flex flex-wrap justify-center gap-6 text-sm">
        <a href="/" class="text-navy font-medium hover:opacity-80 transition-opacity">Home &rarr;</a>
        <a href="/work/" class="text-navy font-medium hover:opacity-80 transition-opacity">The Standard &rarr;</a>
        <a href="/services/multi-site-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Multi-site rollout programmes &rarr;</a>
        <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant surveys &rarr;</a>
        <a href="/services/aba-autism-clinic-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">ABA clinic documentation &rarr;</a>
        <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Retail rollout documentation &rarr;</a>
        <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Healthcare facility surveys &rarr;</a>
        <a href="/services/pre-construction-site-intelligence/" class="text-navy font-medium hover:opacity-80 transition-opacity">Pre-construction intelligence &rarr;</a>
        <a href="/estimating/" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction estimating &rarr;</a>
        <a href="/about/" class="text-navy font-medium hover:opacity-80 transition-opacity">About Alturascope &rarr;</a>
        <a href="/contact/" class="text-navy font-medium hover:opacity-80 transition-opacity">Start a project &rarr;</a>
      </div>
    </section>

  </div>
</Layout>
