import SpecialtyPage from "../../components/SpecialtyPage.astro";
---
<SpecialtyPage
  title="Aviation Facility Surveys & Reality Capture | Alturascope"
  description="Site documentation for hangars, terminals, MRO facilities, and airside infrastructure. Structured deliverables for complex aviation environments where dimensional precision is non-negotiable."
  canonical="https://alturascope.com/services/aviation-facility-survey/"
  h1="Aviation facility survey and documentation."
  heroImage="https://images.unsplash.com/photo-1540962351504-03099e0a754b?w=1920&q=80"
  heroAlt="Aircraft hangar interior documented during aviation facility survey with high-bay structure and maintenance infrastructure visible"
  heroPlaceholder="Hero — dramatic hangar interior or aviation facility. High ceiling, industrial scale, atmospheric."
  openingLabel="Aviation Documentation"
  openingBody="Aviation facilities have documentation requirements that reflect their operational environment: precision, compliance, and an understanding of how these spaces actually work. Alturascope provides comprehensive reality capture and conditions surveys for hangars, FBOs, MRO facilities, and private aviation terminals — producing deliverables that facility managers, architects, and operators can use for renovation planning, lease diligence, and asset management."
  whatWeDocumentBody="Hangar interiors and structural systems, terminal and passenger areas, MRO facility layout and equipment, above-ceiling services, mechanical and electrical infrastructure, and exterior envelope and apron areas where accessible. Where dimensional accuracy is required for design, compliance, or engineering purposes, we capture using survey-grade LiDAR instrumentation producing point cloud data to millimetre accuracy. The navigable digital twin provides the accessible layer for facility managers and planners; the point cloud data supports the technical work."
  whatYouReceiveBody="Navigable digital twin, point cloud data where survey-grade accuracy is specified, equipment and asset schedule, conditions report with prioritised findings, labeled photo storyboard, and ScopeWalk platform access. Deliverables are structured for facility managers, architects, and operators — formatted to support renovation planning, compliance documentation, and asset management decisions."
  whoThisIsForBody="FBO operators, private aviation terminal managers, MRO facilities, corporate flight departments, aviation real estate developers, and architects working on aviation facilities. Whether you're planning a renovation, managing an acquisition, or documenting an existing facility for compliance and asset management purposes."
  faqs={[
    { question: "What does an aviation facility survey include?", answer: "A complete aviation facility survey includes navigable digital twin documentation of all accessible interior spaces, point cloud data where dimensional accuracy is required, an equipment and asset schedule for all installed equipment, above-ceiling documentation of services and structural elements, a conditions report with findings prioritised by urgency, a labeled photo storyboard of every area, and ScopeWalk platform access. The scope is tailored during the brief to match your facility's specific requirements." },
    { question: "Can you document active hangars without operational disruption?", answer: "Yes. Our capture process is designed to work around active operations. We coordinate access and scheduling with your facility management team to ensure the documentation process causes no disruption to hangar operations, aircraft movements, or maintenance schedules. The capture equipment is portable and non-intrusive." },
    { question: "What deliverables do aviation facility clients typically receive?", answer: "The standard deliverable package includes a navigable digital twin, point cloud data where precision is specified, an equipment schedule documenting all installed equipment by location and condition, a conditions report with P1/P2/P3 prioritisation, above-ceiling documentation, and a labeled photo storyboard. All materials are delivered through ScopeWalk and permanently accessible to your team." },
    { question: "Do you cover both private and commercial aviation facilities?", answer: "Yes. We work with private FBO operators, corporate flight departments, MRO facilities, and commercial aviation terminal operators. The documentation approach is tailored to the specific requirements of each facility type during the brief. We understand that aviation facilities operate under different regulatory and operational frameworks and scope accordingly." },
    { question: "How do you handle security requirements at aviation facilities?", answer: "We work within the security protocols of each facility. We coordinate with your security team before the visit, comply with all access requirements, and handle all documentation with the discretion that aviation environments require. We are experienced in working in restricted-access environments and understand the protocols involved." }
  ]}
