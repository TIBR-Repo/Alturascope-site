---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Site Surveys & Documentation — Southeast US",
  "description": "Site documentation for construction and renovation projects across the Southeast — Atlanta, Miami, Charlotte, Nashville, Tampa. Conditions surveys, thermal imaging, and digital twins.",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Alturascope",
    "url": "https://alturascope.com/",
    "areaServed": [
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "Canada" },
      { "@type": "Country", "name": "United Kingdom" }
    ]
  },
  "serviceType": "Pre-Construction Site Documentation — Southeast US",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Site Documentation Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Navigable Digital Twin" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Conditions Report" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Equipment & Asset Schedule" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ScopeWalk Platform Access" } }
    ]
  }
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://alturascope.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "Southeast Site Surveys", "item": "https://alturascope.com/services/southeast-site-surveys/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you cover all Southeast states?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We operate across every state in the Southeast — Georgia, Florida, North Carolina, South Carolina, Tennessee, Alabama, Mississippi, Louisiana, Virginia, and beyond. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time." }
    },
    {
      "@type": "Question",
      "name": "How does thermal imaging help with moisture and hurricane damage documentation?",
      "acceptedAnswer": { "@type": "Answer", "text": "FLIR thermal imaging detects moisture intrusion that is invisible to the naked eye — behind walls, above ceilings, and beneath flooring. In the Southeast, where hurricane damage, humidity, and water intrusion are common concerns for commercial buildings, thermal imaging reveals active moisture issues, identifies areas of insulation failure, and documents building envelope performance without invasive investigation. This is particularly valuable for renovation projects where hidden moisture damage can generate significant change orders if discovered during construction." }
    },
    {
      "@type": "Question",
      "name": "Can you support multi-site programmes across the Southeast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Southeast is one of our most active regions for multi-site rollout programmes — QSR remodel programmes, retail rebrands, and healthcare network capital assessments. We deliver the same structured documentation package at every location through ScopeWalk, coordinate scheduling centrally, and mobilise across multiple states in parallel when timelines require it. Your team briefs us once, and we manage the logistics." }
    },
    {
      "@type": "Question",
      "name": "What types of projects do you document in the Southeast?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our Southeast work includes QSR and franchise remodel programmes in high-growth metros like Atlanta, Nashville, Charlotte, and Tampa. Retail rollout documentation for national rebrands and refreshes across Florida and the Carolinas. Healthcare facility surveys for health systems running multi-facility capital programmes. Commercial renovation and fitout documentation in rapidly developing markets. The common thread is that the Southeast's pace of commercial growth makes thorough pre-construction documentation especially valuable — the cost of getting it wrong scales with the volume of projects in the pipeline." }
    }
  ]
});
---
<Layout
  title="Site Surveys & Documentation — Southeast US | Alturascope"
  description="Site documentation for construction and renovation projects across the Southeast — Atlanta, Miami, Charlotte, Nashville, Tampa. Conditions surveys, thermal imaging, and digital twins."
  canonical="https://alturascope.com/services/southeast-site-surveys/"
  ogImage="https://images.unsplash.com/photo-1575089776834-8be34d1e36f0?w=1200&q=80"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-[100vh] md:min-h-0 md:h-[60vh] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <img
          src="https://images.unsplash.com/photo-1575089776834-8be34d1e36f0?w=1920&q=80"
          srcset="
            https://images.unsplash.com/photo-1575089776834-8be34d1e36f0?w=800&q=70 800w,
            https://images.unsplash.com/photo-1575089776834-8be34d1e36f0?w=1200&q=75 1200w,
            https://images.unsplash.com/photo-1575089776834-8be34d1e36f0?w=1920&q=80 1920w
          "
          sizes="100vw"
          alt="Commercial construction and development activity in a Southeast United States urban environment with modern buildings"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>
      <div class="relative z-10 text-center px-6 pt-28 pb-16 md:pt-0 md:pb-0 max-w-[900px] mx-auto">
        <p class="label text-gold mb-4">Regional Coverage &middot; Southeast US</p>
        <h1 class="text-[1.8rem] md:text-[3.2rem] font-light text-offwhite leading-tight">
          Site Surveys &amp; Pre-Construction Documentation — Southeast United States
        </h1>
        <p class="mt-6 text-offwhite/70 leading-body max-w-[720px] mx-auto">
          The Southeast is one of the fastest-growing commercial construction markets in the country — and one where moisture, climate, and pace of development make thorough pre-construction documentation critical. AlturaScope delivers structured site intelligence across Atlanta, Miami, Charlotte, Nashville, Tampa, and every market in between.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/contact/" class="btn-primary">Start a Project</a>
          <a href="/services/" class="btn-secondary-light">How It Works</a>
        </div>
      </div>
    </section>

    <!-- Why Documentation Matters in the Southeast -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Southeast Market</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Why pre-construction documentation matters here.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            The Southeast's rapid commercial growth drives a high volume of renovation and rollout activity — but speed does not reduce the need for thorough documentation. It increases it. When the pipeline is full and programmes are running on compressed timelines, the cost of incomplete site information compounds with every location. A change order on one store is an inconvenience. A pattern of change orders across a 50-location programme is a budget problem that was preventable.
          </p>
          <p>
            Climate is a factor that most pre-construction surveys do not account for. Hurricane exposure, persistent humidity, and seasonal moisture intrusion create conditions that are invisible from a floor plan but critical to the renovation scope. FLIR thermal imaging is particularly relevant in the Southeast — it reveals active moisture behind walls, identifies insulation failure in the building envelope, and documents HVAC performance issues that a visual inspection cannot detect. For any renovation project south of the Carolinas, thermal documentation is not an add-on. It is a necessity.
          </p>
          <p>
            The Southeast is also a concentration point for multi-site programmes. QSR and franchise expansion is heaviest in high-growth metros like Atlanta, Nashville, Charlotte, Tampa, and Orlando. Healthcare networks across Florida, Georgia, and the Carolinas are running multi-facility capital programmes. National retail rebrands target the Southeast early because the market volume justifies the investment. All of these programmes require <a href="/insights/standardising-site-surveys-multi-site-operators/" class="text-navy font-medium hover:opacity-80 transition-opacity">consistent, structured site documentation</a> that scales with the rollout.
          </p>
        </div>
      </div>
    </section>

    <!-- What We Deliver -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">The Deliverable</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Structured site intelligence. Every project.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Every AlturaScope site visit in the Southeast produces the same structured deliverable package — whether the project is a single commercial renovation in Atlanta or a 100-location QSR remodel programme across Florida and the Carolinas.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Navigable Digital Twin</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Matterport-based 3D model of the entire space. Remote access for the full project team. Measurements taken directly in the model.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Conditions Report</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              P1/P2/P3 prioritised assessment of existing conditions — structural, MEP, finishes, moisture, code compliance, accessibility.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Equipment &amp; Asset Schedule</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Full inventory by location, make, model, condition, and services connections. Formatted for procurement and design teams.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Thermal Imaging (FLIR)</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Moisture intrusion detection, hidden services identification, HVAC performance assessment, and building envelope analysis — essential in the Southeast climate.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">Above-Ceiling MEP Documentation</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              Thermal, pole-mounted 360&deg;, and borescope capture of ceiling plenum conditions, services routing, and conflicts.
            </p>
          </div>
          <div>
            <h3 class="text-[1.1rem] font-medium text-navy">ScopeWalk Platform</h3>
            <p class="mt-2 text-midgrey leading-body text-[0.95rem]">
              All deliverables structured in a single portal. Permanent access. For multi-site programmes: compare locations side by side.
            </p>
          </div>
        </div>

        <a href="/services/pre-construction-site-intelligence/" class="inline-block mt-10 text-navy font-medium hover:opacity-80 transition-opacity">
          Full detail on the AlturaScope deliverable &rarr;
        </a>
      </div>
    </section>

    <!-- Markets We Serve -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Sectors</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Markets we serve in the Southeast.
        </h2>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">QSR &amp; Restaurant</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              The Southeast is the epicentre of QSR expansion in the United States. High-growth metros like Atlanta, Nashville, Charlotte, Tampa, and Orlando are where national franchise remodel programmes are concentrated. Our <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant survey programme</a> delivers consistent documentation across every location — equipment schedules, conditions reports, above-ceiling MEP documentation, and commercial kitchen detail — so your programme runs on reliable information regardless of how many locations are in the pipeline.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Retail &amp; Franchise</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              National retail rebrands and refreshes target the Southeast early because the market volume justifies the investment. From flagship locations in Buckhead and Brickell to strip-mall remodels across suburban Florida and the Carolinas, our <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">retail rollout documentation</a> delivers the same structured package at every store — consistent conditions data, equipment inventories, and thermal analysis that your design and construction teams can rely on.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Healthcare</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              Major health systems across the Southeast are running multi-facility capital programmes — expanding networks, renovating ageing campuses, and building new satellite clinics to serve growing populations. Our <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">healthcare facility survey</a> methodology documents the complex MEP infrastructure, compliance-relevant conditions, and equipment inventories that capital planning teams need to allocate budget and prioritise projects across the network.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-[1.35rem] font-medium text-navy">Commercial Renovation</h3>
          <div class="mt-4 space-y-4 text-midgrey leading-body">
            <p>
              Rapid development creates a steady pipeline of commercial renovation work — tenant fitouts, adaptive reuse, mixed-use conversions, and building repositioning. In markets where humidity and moisture are persistent concerns, thorough <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">pre-construction documentation</a> that includes thermal imaging and above-ceiling capture prevents the category of surprise that generates the most expensive change orders.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage and Logistics -->
    <section class="bg-navy section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <p class="label text-gold mb-4">Logistics</p>
        <h2 class="text-[2rem] font-light text-offwhite leading-tight">
          No local subcontractors. No variability.
        </h2>
        <div class="mt-6 space-y-4 text-offwhite/70 leading-body">
          <p>
            AlturaScope operates under a national travel model. Every site visit in the Southeast — whether it is in downtown Atlanta, coastal Florida, or rural Tennessee — is conducted by AlturaScope using the same methodology, the same equipment, and the same deliverable standard. There is no local subcontractor lottery. Travel costs are included in all project pricing.
          </p>
          <p>
            For multi-site programmes running across the Southeast — or across the entire US — we coordinate scheduling centrally. Your team briefs us once, and we manage access, timing, and logistics directly with each location. For programmes requiring simultaneous coverage across multiple states, we mobilise in parallel to compress your pre-construction timeline.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[900px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Common questions about Southeast site surveys.</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you cover all Southeast states?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We operate across every state in the Southeast — Georgia, Florida, North Carolina, South Carolina, Tennessee, Alabama, Mississippi, Louisiana, Virginia, and beyond. Travel is included in all project pricing. There are no per-visit travel surcharges and no local subcontractors. AlturaScope methodology, AlturaScope deliverables, every time.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              How does thermal imaging help with moisture and hurricane damage documentation?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              FLIR thermal imaging detects moisture intrusion that is invisible to the naked eye — behind walls, above ceilings, and beneath flooring. In the Southeast, where hurricane damage, humidity, and water intrusion are common concerns for commercial buildings, thermal imaging reveals active moisture issues, identifies areas of insulation failure, and documents building envelope performance without invasive investigation. This is particularly valuable for renovation projects where hidden moisture damage can generate significant change orders if discovered during construction.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you support multi-site programmes across the Southeast?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. The Southeast is one of our most active regions for multi-site rollout programmes — QSR remodel programmes, retail rebrands, and healthcare network capital assessments. We deliver the same structured documentation package at every location through ScopeWalk, coordinate scheduling centrally, and mobilise across multiple states in parallel when timelines require it. Your team briefs us once, and we manage the logistics.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What types of projects do you document in the Southeast?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Our Southeast work includes QSR and franchise remodel programmes in high-growth metros like Atlanta, Nashville, Charlotte, and Tampa. Retail rollout documentation for national rebrands and refreshes across Florida and the Carolinas. Healthcare facility surveys for health systems running multi-facility capital programmes. Commercial renovation and fitout documentation in rapidly developing markets. The common thread is that the Southeast's pace of commercial growth makes thorough pre-construction documentation especially valuable — the cost of getting it wrong scales with the volume of projects in the pipeline.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-white section-padding">
      <div class="max-w-[700px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">Ready to start?</h2>
        <p class="mt-4 text-midgrey leading-body">
          Tell us about the site, the project scope, and what your team needs to decide. We will come back with a clear proposal and an all-in quote — travel included.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm">
          <a href="/services/pre-construction-site-intelligence/" class="text-navy font-medium hover:opacity-80 transition-opacity">The full AlturaScope deliverable &rarr;</a>
          <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">QSR restaurant surveys &rarr;</a>
          <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Retail rollout documentation &rarr;</a>
          <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Healthcare facility surveys &rarr;</a>
          <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction documentation &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
