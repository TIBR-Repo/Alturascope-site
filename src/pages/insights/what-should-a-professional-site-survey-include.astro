---
import InsightArticle from "../../components/InsightArticle.astro";

const link = "text-navy font-medium hover:opacity-80 transition-opacity";
const a = (href: string, text: string) => `<a href="${href}" class="${link}">${text}</a>`;

const blocks = [
  {
    p: [
      "<strong class=\"text-navy font-medium\">A professional pre-lease site survey records what a commercial unit actually contains &mdash; its shell and dimensions, its electrical, mechanical, plumbing and gas services, its life-safety systems, what sits above the ceiling and on the roof, and which of those things the landlord controls &mdash; so that the lease, the design and the budget start from fact rather than from the listing.</strong>",
      "This is a buyer&rsquo;s checklist for that survey, written for operators taking small commercial units &mdash; typically 1,000 to 8,000 square feet &mdash; for restaurants and caf&eacute;s, clinics, studios and retail. Use it to brief a surveyor, to check a quote, or to judge a report somebody has already sent you.",
      "One boundary first. An existing-conditions survey <em>records</em>. It does not certify code compliance, it does not engineer capacity, and it does not assess structure. A good report says exactly that, and tells you which questions belong to your architect, engineer or the landlord.",
    ],
  },
  {
    h2: "1. Shell and dimensions",
    points: [
      ["Overall dimensions and area", "frontage width, depth and a usable-area check against the area in the lease or marketing plan. Leased area is often quoted on a rentable basis that includes a share of common areas, so a difference is normal &mdash; but it should be known."],
      ["Clear heights", "to the underside of the deck or structure, and to the lowest obstruction (duct, beam, sprinkler main). The second number is the one your ceiling design has to live with."],
      ["Structure you have to plan around", "column positions, load-bearing or rated walls, bulkheads, and any changes in floor level."],
      ["Floor slab", "level, cracks, previous trenching or patching, and whether earlier tenants cut the slab for drainage &mdash; useful evidence of where services can run."],
      ["Storefront and doors", "glazing type and condition, entrance door width and hardware, rear or service door, and the delivery route."],
      ["Demising walls", "whether they run to the deck, their apparent construction, and any openings or penetrations into neighbors."],
    ],
  },
  {
    h2: "2. Electrical service and panels",
    p: [
      "Electrical capacity is the item most likely to turn a cheap-looking unit into an expensive one, and the item most often reported badly. A one-line &ldquo;200 amp service&rdquo; is not enough.",
    ],
    points: [
      ["Service size, voltage and phase", "amperage of the main breaker or disconnect, voltage (for example 120/208 V or 277/480 V) and single- or three-phase."],
      ["Meter location", "inside the unit, in a shared meter bank, or in a landlord room &mdash; and whether the meter is clearly identified to this suite."],
      ["Every panel, photographed with its schedule", "make, rating, approximate age, spare spaces, and the panel directory. Spare spaces matter as much as amperage: a full panel limits equipment regardless of the service size."],
      ["Transformers and feeders", "where any step-down transformer sits, and whether the feeder is shared with another suite."],
      ["Obsolete or unsupported equipment", "older switchgear for which replacement breakers are hard to obtain is a replacement item, not a modification."],
    ],
    figure: {
      src: "/Images/insights/panel-schedule.webp",
      alt: "A tenant electrical panel with its handwritten circuit schedule, photographed during a site survey",
      caption: "The panel and its schedule, photographed together. Spare spaces, breaker sizes and the age of the gear tell you more than the service rating alone.",
    },
  },
  {
    h2: "3. HVAC and ventilation",
    points: [
      ["Every unit by nameplate", "rooftop units (RTUs), split systems or water-source heat pumps: make, model, serial and the manufacture date where shown. Nominal tonnage can usually be read from the model number or the plate; record it rather than estimating from the box size."],
      ["Age and refrigerant", "units still charged with R-22 deserve a replacement budget: US production and import of R-22 ended in 2020, so servicing them depends on recovered or reclaimed refrigerant."],
      ["Heat source and zoning", "gas heat, electric heat or heat pump; how many zones; where the thermostats are and whether they work."],
      ["Ductwork and exhaust", "main supply and return routes above the ceiling, restroom exhaust, and any existing kitchen exhaust or make-up air."],
      ["Who owns it", "whether the units are the tenant&rsquo;s to maintain and replace, or base-building plant serving several tenants &mdash; a lease question the survey should flag."],
    ],
  },
  {
    h2: "4. Plumbing, water and grease",
    p: [
      "For food and many medical uses this section decides the budget. " + a("/insights/grease-power-water-food-unit-fit-out/", "Grease, power and water in a food unit fit-out") + " covers the food-service side in depth.",
    ],
    points: [
      ["Water service", "line size and material where visible, meter location (inside the unit, shared, or outside the demise), and the backflow preventer."],
      ["Water heater", "type, fuel, capacity and age from the plate."],
      ["Sanitary and venting", "where existing waste lines and floor drains are, their sizes where visible, cleanouts, and the likely route to the building sewer."],
      ["Grease", "whether there is an in-ground interceptor, an under-sink trap, or nothing &mdash; and where an interceptor could realistically go."],
      ["Restrooms", "number, fixture count and visible condition."],
    ],
    figure: {
      src: "/Images/insights/water-meter-outside-demise.webp",
      alt: "A water meter located outside the tenant demise in a shared service area",
      caption: "A water meter outside the demise. Whether a service is inside your unit, shared, or in a landlord area changes who you need to talk to before anything changes.",
    },
  },
  {
    h2: "5. Gas",
    points: [
      ["Presence and meter", "whether gas is brought to the unit at all, the meter location and any tags identifying it to the suite."],
      ["Visible piping", "the route and approximate pipe size to the suite and to existing equipment, and any capped stubs."],
      ["Capacity", "the meter rating and pressure as labeled. Whether the supply will carry your equipment load is a question for your engineer and the gas utility, and the report should say so."],
    ],
  },
  {
    h2: "6. Fire and life safety",
    points: [
      ["Sprinklers", "whether the unit is sprinklered, where the riser and control valves are, and whether the system is fed from a landlord riser."],
      ["Fire alarm", "whether devices tie into a base-building panel or a tenant panel, and where that panel is."],
      ["Egress", "exit doors and their hardware, exit signs and emergency lighting, and the travel route to them."],
      ["Service tags", "extinguishers, sprinkler and alarm inspection tags with dates."],
      ["Change of use", "a new use can change the occupancy classification, and with it the exit, separation and sometimes sprinkler requirements. The survey records the existing arrangement; your architect makes the code call."],
    ],
    figure: {
      src: "/Images/insights/base-building-fire-alarm.webp",
      alt: "A base-building fire alarm control panel in a shared service room",
      caption: "A base-building fire alarm panel. If your devices report to the landlord's panel, every alteration involves the landlord's fire alarm contractor.",
    },
  },
  {
    h2: "7. Ceilings and the space above them",
    p: [
      "What is above the ceiling decides whether a new layout is straightforward. A survey that stays at floor level is only half a survey &mdash; see " + a("/insights/above-ceiling-mep-survey-fit-out/", "why above-ceiling MEP surveys matter") + ".",
    ],
    points: [
      ["Ceiling type and condition", "grid, hard lid or open to deck; tile condition and staining."],
      ["Plenum depth", "from ceiling to the lowest obstruction and to the deck."],
      ["Contents of the void", "ductwork, sprinkler mains and branch lines, conduit, abandoned cabling, junction boxes, and insulation."],
      ["Signs of trouble", "water staining on the deck or tiles, damaged insulation, or services hung from the ceiling grid rather than the structure."],
    ],
    figure: {
      src: "/Images/insights/ceiling-access-point.webp",
      alt: "An opened ceiling tile giving a view of the services in the void above a commercial unit",
      caption: "One lifted tile at each zone of the unit is usually enough to show what the ceiling design will have to work around.",
    },
  },
  {
    h2: "8. Roof",
    points: [
      ["Access", "how the roof is reached and whether access needs the landlord."],
      ["Membrane and drainage", "membrane type and visible condition, ponding, drains and scuppers."],
      ["Curbs and penetrations", "RTU curbs, exhaust fans, flues and any redundant penetrations."],
      ["Warranty", "whether a roof warranty exists and who holds it &mdash; usually the landlord, which affects who may cut new penetrations."],
    ],
  },
  {
    h2: "9. Accessibility",
    points: [
      ["Entrance", "level or ramped approach, threshold height, door width and hardware."],
      ["Path of travel", "from parking or the sidewalk to the entrance, and through the unit."],
      ["Restrooms", "whether existing restrooms appear to have accessible layouts and fixtures."],
    ],
    note: "<span class=\"text-navy font-medium\">Observations, not a compliance determination.</span> The survey records what is there. A formal ADA review belongs to your architect or an accessibility specialist &mdash; in California, often a Certified Access Specialist (CASp).",
  },
  {
    h2: "10. Landlord-controlled items",
    p: [
      "On almost every small-unit deal, part of the scope belongs to somebody else. The survey should list what it found that the landlord appears to control, so those items go into the lease negotiation rather than the change-order log. " + a("/insights/second-generation-space-what-to-verify-before-you-sign/", "Second-generation space: what to verify before you sign") + " covers the negotiation side.",
    ],
    points: [
      ["Shared or base-building systems", "meters in shared rooms, central plant, sprinkler and fire alarm systems, and any grease interceptor serving several tenants."],
      ["The roof and the structure", "penetrations, new curbs and slab cuts usually need landlord approval."],
      ["Areas not accessed", "risers, landlord rooms and roof areas the survey could not reach, listed explicitly with the question each one leaves open."],
    ],
  },
  {
    h2: "What you should receive",
    points: [
      ["A written report", "findings organized by system, each with a photo reference and, where relevant, a recommended next step or question."],
      ["A nameplate-level equipment schedule", "every item of plant and equipment with make, model, serial, age and condition."],
      ["A complete, labeled photo set", "every room, every panel with its schedule, every nameplate, the roof and the above-ceiling views &mdash; named so that each image can be traced to its location."],
      ["A 3D or 360&deg; walkthrough", "so people who were not on site can see the space. It is a visual record, not a measured survey."],
      ["Key dimensions", "frontage, depth, clear heights and critical clearances, with the method stated. If you need a dimensioned drawing set, ask for a measured survey and the tolerance it will be produced to."],
      ["A list of what was not established", "areas not accessed, questions for the landlord, and items that need an engineer or specialist."],
    ],
  },
  {
    h2: "Red flags in a survey you have been sent",
    points: [
      ["Service size stated without panel photos", "nobody can check it, and spare capacity is unknown."],
      ["HVAC described as &ldquo;working&rdquo; with no nameplate data", "age and refrigerant are the cost drivers, and they are missing."],
      ["Nothing above the ceiling", "the most expensive surprises in a fit-out live there."],
      ["No list of inaccessible areas", "a report that claims to have seen everything usually has not."],
      ["Words like &ldquo;compliant&rdquo; or &ldquo;certified&rdquo;", "an existing-conditions survey cannot certify code compliance, and a report that implies it is overreaching."],
      ["&ldquo;Survey-grade&rdquo; accuracy claimed from a 360&deg; scan", "a visual capture is not a measured survey."],
      ["No date, no author, no photos tied to locations", "a record you cannot date or trace is not evidence of anything."],
      ["No distinction between tenant and landlord items", "the single most useful thing a pre-lease survey can tell you is which problems are yours."],
    ],
  },
  {
    h2: "What to add for your sector",
    p: [
      "The checklist above is the common core. Each use adds its own priorities:",
    ],
    points: [
      ["Restaurants and caf&eacute;s", "grease, hood and make-up air, gas, and walk-in cooler space &mdash; see " + a("/services/qsr-restaurant-survey/", "restaurant and QSR site surveys") + " and " + a("/services/commercial-kitchen-survey/", "commercial kitchen surveys") + "."],
      ["ABA and therapy clinics", "room module, observation glazing, acoustics and HVAC zoning &mdash; see " + a("/services/aba-autism-clinic-documentation/", "ABA clinic surveys") + "."],
      ["Dental practices", "plumbing and drainage to the operatories, space for compressor and vacuum plant, and electrical capacity &mdash; see " + a("/services/dental-practice-survey/", "dental practice surveys") + "."],
      ["Veterinary clinics", "drainage, ventilation and odor control, and room for imaging &mdash; see " + a("/services/veterinary-clinic-survey/", "veterinary clinic surveys") + "."],
      ["Med spas and aesthetics clinics", "treatment-room electrical, plumbing at each room, and HVAC for equipment heat &mdash; see " + a("/services/medical-aesthetics-clinic-survey/", "med spa surveys") + "."],
      ["Fitness studios", "slab and floor build-up, ceiling height, acoustics toward neighbors, and showers &mdash; see " + a("/services/fitness-studio-survey/", "fitness studio surveys") + "."],
      ["Dispensaries and cultivation", "electrical service against a much heavier load, dehumidification and odor discharge &mdash; see " + a("/services/cannabis-facility-documentation/", "cannabis dispensary and cultivation surveys") + "."],
    ],
  },
  {
    h2: "What this looks like on real sites",
    p: [
      "Some of the pre-lease surveys published in our location stories show the checklist doing its job:",
    ],
    points: [
      [a("/work/locations/west-diversey-parkway-chicago/", "A vacant shell in Chicago"), "reading the transformer and tenant panel nameplates showed the power the brand needed was already in place, with almost every panel space free."],
      [a("/work/locations/cactus-road-phoenix/", "A new-build shell in Phoenix"), "tracing the switchboard positions, conduits and gas, water and grease stubs showed what the base building had already brought to the suite."],
      [a("/work/locations/henderson-avenue-dallas/", "A former bar in Dallas"), "a nameplate-level equipment schedule sorted what a lighter caf&eacute; format should keep, clear or reuse."],
      [a("/work/locations/ohio-street-commons-joliet/", "Stripped retail units in Joliet"), "measuring from inside found a fourth bay in the demise that was not obvious from the street, and the landlord-only questions went out in one request."],
    ],
  },
];

const faqs = [
  {
    q: "What should a pre-lease site survey include?",
    a: "At a minimum: shell dimensions and clear heights; the electrical service, meter and every panel with its schedule; HVAC equipment by nameplate, with age and refrigerant; water, sanitary, grease and gas provisions; sprinklers, fire alarm and egress; ceilings and the space above them; the roof; accessibility observations; and a list of landlord-controlled items and areas not accessed. Deliverables should include a written report, an equipment schedule, a labeled photo set and a 3D or 360-degree walkthrough."
  },
  {
    q: "Is a site survey the same as a building inspection or code review?",
    a: "No. An existing-conditions survey records what is there and its visible condition. It does not certify code or ADA compliance, calculate electrical or structural capacity, or replace inspections by licensed professionals. A good report states those limits and lists the questions for your architect, engineer or landlord."
  },
  {
    q: "How long does a survey of a small commercial unit take?",
    a: "Most units under about 8,000 square feet can be recorded in a single site visit, provided access to the roof, meters and any landlord rooms is arranged in advance. Report turnaround varies by provider; ask for it in writing before you commission."
  },
  {
    q: "Is a Matterport or 360-degree scan enough on its own?",
    a: "No. A 3D walkthrough is an excellent visual record, but it is not a measured survey and it does not capture nameplate data, panel schedules, above-ceiling conditions or landlord-controlled items unless someone deliberately records them. It should be one part of the package, alongside the written report and equipment schedule."
  },
  {
    q: "Can I commission a survey before I sign the lease?",
    a: "Yes, and that is when it is most useful. A pre-lease survey identifies the costly items - insufficient power, end-of-life HVAC, no grease route, landlord-controlled systems - while you can still negotiate the lease, ask for landlord work, or walk away."
  },
];
---
<InsightArticle
  title="Site Survey Checklist: What a Pre-Lease Survey Should Include"
  description="A buyer's checklist for a pre-lease survey of a small commercial unit: shell, electrical, HVAC, plumbing, gas, life safety, roof and red flags."
  slug="what-should-a-professional-site-survey-include"
  h1="What a Professional Site Survey Should Include: A Buyer's Checklist"
  datePublished="2026-02-20"
  dateModified="2026-10-26"
  heroImage="/Images/stock/1454165804606-c3d57bc86b40.webp"
  heroAlt="Reviewing survey documentation and plans for a commercial unit"
  eyebrow="Insights &middot; Buyer&rsquo;s Guide"
  blocks={blocks}
  faqs={faqs}
  estimatingLead="Once the unit is recorded to this checklist, the fit-out can be priced from the same record rather than from an allowance."
  internalLinks={[
    { text: "Pre-lease due diligence surveys", href: "/services/pre-construction-site-intelligence/" },
    { text: "Retail fit-out & remodel surveys", href: "/services/retail-rollout-documentation/" },
    { text: "What is a Matterport digital twin?", href: "/insights/what-is-a-matterport-digital-twin/" },
    { text: "Surveyed locations", href: "/work/locations/" },
  ]}
/>
