---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Point Clouds, As-Built Surveys, and What Architects Actually Need From a Site Survey",
  "author": { "@type": "Organization", "name": "Alturascope" },
  "publisher": { "@type": "Organization", "name": "Alturascope", "url": "https://alturascope.com/" },
  "datePublished": "2026-02-20",
  "description": "Not all site surveys produce data that design teams can actually use. Here's the difference between a navigable digital twin and a survey-grade point cloud — and when you need which.",
  "mainEntityOfPage": "https://alturascope.com/insights/point-cloud-as-built-survey-architects-engineers/"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://alturascope.com/insights/" },
    { "@type": "ListItem", "position": 3, "name": "Point Cloud & As-Built Surveys for Architects", "item": "https://alturascope.com/insights/point-cloud-as-built-survey-architects-engineers/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's the difference between .e57 and .rcp point cloud formats?",
      "acceptedAnswer": { "@type": "Answer", "text": "Both are industry-standard point cloud formats used in design workflows. .e57 is an open format that works across most CAD and BIM software including AutoCAD and Revit. .rcp is Autodesk's native format, optimised for use within the Revit and AutoCAD ecosystem. We can deliver in either format based on your team's software environment — just let us know at the briefing stage." }
    },
    {
      "@type": "Question",
      "name": "How accurate does a survey need to be for Revit modelling?",
      "acceptedAnswer": { "@type": "Answer", "text": "For most Revit as-built modelling, accuracy of 5–10mm is sufficient for structural and architectural elements. MEP coordination to this accuracy is typically adequate for schematic and design development stages. If the project involves prefabricated elements or tight tolerance fabrication, tighter accuracy requirements should be discussed at the survey brief stage." }
    },
    {
      "@type": "Question",
      "name": "Can you work from existing drawings to focus the survey?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, and we'd encourage it. If existing drawings are available — even if known to be outdated — they help us focus capture effort on areas of uncertainty and identify discrepancies efficiently. Share whatever you have and we'll advise on how to structure the survey around it." }
    },
    {
      "@type": "Question",
      "name": "Do you provide the point cloud only, or a full package?",
      "acceptedAnswer": { "@type": "Answer", "text": "We can scope either. Point cloud delivery as a standalone is available for projects where the design team needs data and nothing else. Most projects benefit from the full documentation package — twin, conditions report, narrated walkthrough, asset schedule — alongside the point cloud, as different stakeholders use different parts of it." }
    }
  ]
});
---
<Layout
  title="Point Cloud Surveys and As-Built Documentation: What Architects and Engineers Actually Need"
  description="Not all site surveys produce data that design teams can actually use. Here's the difference between a navigable digital twin and a survey-grade point cloud — and when you need which."
  canonical="https://alturascope.com/insights/point-cloud-as-built-survey-architects-engineers/"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative h-[45vh] max-h-[450px] min-h-[300px] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <img
          src="/Images/stock/1503387762-592deb58ef4e.webp"
          alt="Architectural blueprints and technical drawings on a desk with building structure visible"
          class="w-full h-full object-cover opacity-25"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.82)]"></div>
      </div>
      <div class="relative z-10 text-center px-6 max-w-[760px] mx-auto">
        <p class="label text-gold mb-4">INSIGHTS</p>
        <h1 class="text-[1.8rem] md:text-[2.6rem] font-light text-offwhite leading-tight">
          Point Clouds, As-Built Surveys, and What Architects Actually Need From a Site Survey
        </h1>
      </div>
    </section>

    <!-- Article Body -->
    <article class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">

        <!-- Introduction -->
        <div class="space-y-6 text-midgrey leading-body text-[1.05rem]">
          <p>
            Architects and engineers working on existing buildings have a problem that's deceptively simple to describe and surprisingly expensive to solve badly: they need to know exactly what's there before they can design what comes next.
          </p>
          <p>
            Floor plans from the original build are a starting point, not a reliable record. Buildings get modified. Partitions move. Services get rerouted. Dimensions shift. By the time a design team is working on a refurbishment or change-of-use project, the gap between what the drawings say and what's actually there can be significant &mdash; and consequential.
          </p>
          <p>
            The right survey methodology depends on what the design team actually needs to produce. And that's a question worth asking carefully, because the answer differs depending on the project.
          </p>
        </div>

        <!-- Two Different Tools -->
        <h2 class="text-[1.6rem] font-light text-navy mt-16 mb-6">Two Different Tools for Two Different Purposes</h2>
        <div class="space-y-6 text-midgrey leading-body text-[1.05rem]">
          <p>
            There is a meaningful technical difference between the two main outputs from a professional site survey, and conflating them leads to either overspending on capability you don't need or undershooting on accuracy and getting data you can't use.
          </p>
        </div>

        <div class="mt-8 space-y-6">
          <div class="bg-offwhite rounded p-8">
            <h3 class="text-navy font-medium text-[1.1rem]">Navigable Digital Twin</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              The kind produced by Matterport Pro3 &mdash; a photorealistic, explorable 3D model of the space. Extraordinarily useful for client presentations, remote site review, coordination between dispersed project teams, and conditions documentation. Measurements can be taken within the model. It's accurate enough for spatial planning and general design intent. It is not, however, survey-grade. There is inherent spatial drift across large spaces that makes it unsuitable as the primary data source for precision CAD or Revit modelling.
            </p>
          </div>

          <div class="bg-offwhite rounded p-8">
            <h3 class="text-navy font-medium text-[1.1rem]">Survey-Grade Point Cloud</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              Produced by LiDAR scanners calibrated for accuracy and registered using control points &mdash; delivers spatial data to within <span class="text-navy font-medium">5&ndash;12mm</span> across a full building footprint. It exports in formats (.e57, .rcp, .pts) that plug directly into AutoCAD, Revit, and other BIM workflows. Architects can trace floor plans directly from the data. Structural engineers can verify existing dimensions with confidence. M&amp;E consultants can model around existing services without assumptions.
            </p>
          </div>
        </div>

        <p class="mt-8 text-midgrey leading-body text-[1.05rem]">
          The question isn't which is better. It's which is right for what you're designing.
        </p>

        <!-- When Each Approach Is Appropriate -->
        <h2 class="text-[1.6rem] font-light text-navy mt-16 mb-6">When Each Approach Is Appropriate</h2>

        <div class="mt-8 space-y-8">
          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium">Navigable digital twin</h3>
            <p class="mt-2 text-midgrey text-[1.05rem] leading-relaxed">
              The right deliverable when the primary need is spatial understanding, remote access, conditions documentation, and team coordination. For QSR rollouts, pre-acquisition due diligence, asset management, and multi-site programmes, this is typically exactly what's needed.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium">Survey-grade point cloud</h3>
            <p class="mt-2 text-midgrey text-[1.05rem] leading-relaxed">
              The right deliverable when design work requires dimensional accuracy that will be relied upon for structural, services, or architectural decisions. Refurbishment projects, change-of-use schemes, heritage building surveys, and complex MEP coordination all typically require this level of accuracy.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium">Both</h3>
            <p class="mt-2 text-midgrey text-[1.05rem] leading-relaxed">
              Many projects need both &mdash; the navigable twin for the client and the project team, the point cloud for the design consultants. This is increasingly the standard for well-resourced refurbishment projects.
            </p>
          </div>
        </div>

        <!-- What Point Cloud Data Enables -->
        <h2 class="text-[1.6rem] font-light text-navy mt-16 mb-6">What Survey-Grade Point Cloud Data Actually Enables</h2>
        <div class="text-midgrey leading-body text-[1.05rem]">
          <p>When a design team receives properly registered point cloud data, they can:</p>
        </div>

        <div class="space-y-4 mt-8 pl-6 border-l-2 border-gold text-midgrey leading-body text-[1.05rem]">
          <p>Produce accurate as-built floor plans, sections, and elevations without a single manual measurement taken on site</p>
          <p>Model existing structural elements, columns, beams, and slab profiles in Revit with dimensional confidence</p>
          <p>Coordinate new MEP routes around existing services</p>
          <p>Identify existing building tolerances and deviations from nominal before fabrication decisions are made</p>
          <p>Produce planning and listed building consent drawings from accurate spatial data</p>
        </div>

        <p class="mt-8 text-midgrey leading-body text-[1.05rem]">
          The alternative &mdash; designing from manually measured drawings with estimated or assumed dimensions &mdash; is a source of consistent downstream error that compounds through the design and procurement process and surfaces as cost during construction.
        </p>

        <!-- The Construction Experience Difference -->
        <h2 class="text-[1.6rem] font-light text-navy mt-16 mb-6">The Construction Experience Difference</h2>
        <div class="space-y-6 text-midgrey leading-body text-[1.05rem]">
          <p>
            Survey data is only as useful as the context that accompanies it. A point cloud file is a dataset. What matters is whether the person who captured it understood what they were looking at well enough to flag what the design team needs to know.
          </p>
          <p>
            With 18 years of construction and architectural sales experience, Alturascope documentation visits are conducted by someone who knows what a structural engineer will want to see, what an M&amp;E consultant will need to work around, and what conditions are worth flagging for the design team. That context &mdash; knowing what to look for and what to document &mdash; doesn't come with the scanner. It comes with the operator.
          </p>
          <p>
            Every Alturascope documentation visit, regardless of deliverable type, includes a narrated conditions walkthrough with spoken commentary on what was found and what the design team should be aware of.
          </p>
        </div>

        <!-- FAQ -->
        <h2 class="text-[1.6rem] font-light text-navy mt-16 mb-8">Frequently Asked Questions</h2>

        <div class="space-y-8">
          <div>
            <h3 class="text-navy font-medium text-[1.05rem]">What's the difference between .e57 and .rcp point cloud formats?</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              Both are industry-standard point cloud formats used in design workflows. .e57 is an open format that works across most CAD and BIM software including AutoCAD and Revit. .rcp is Autodesk's native format, optimised for use within the Revit and AutoCAD ecosystem. We can deliver in either format based on your team's software environment &mdash; just let us know at the briefing stage.
            </p>
          </div>

          <div>
            <h3 class="text-navy font-medium text-[1.05rem]">How accurate does a survey need to be for Revit modelling?</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              For most Revit as-built modelling, accuracy of 5&ndash;10mm is sufficient for structural and architectural elements. MEP coordination to this accuracy is typically adequate for schematic and design development stages. If the project involves prefabricated elements or tight tolerance fabrication, tighter accuracy requirements should be discussed at the survey brief stage.
            </p>
          </div>

          <div>
            <h3 class="text-navy font-medium text-[1.05rem]">Can you work from existing drawings to focus the survey?</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              Yes, and we'd encourage it. If existing drawings are available &mdash; even if known to be outdated &mdash; they help us focus capture effort on areas of uncertainty and identify discrepancies efficiently. Share whatever you have and we'll advise on how to structure the survey around it.
            </p>
          </div>

          <div>
            <h3 class="text-navy font-medium text-[1.05rem]">Do you provide the point cloud only, or a full package?</h3>
            <p class="mt-3 text-midgrey leading-body text-[1.05rem]">
              We can scope either. Point cloud delivery as a standalone is available for projects where the design team needs data and nothing else. Most projects benefit from the full documentation package &mdash; twin, conditions report, narrated walkthrough, asset schedule &mdash; alongside the point cloud, as different stakeholders use different parts of it.
            </p>
          </div>
        </div>

        <!-- Bottom Line -->
        <div class="mt-16 pt-16 border-t border-border">
          <h2 class="text-[1.6rem] font-light text-navy mb-6">The Bottom Line</h2>
          <div class="space-y-6 text-midgrey leading-body text-[1.05rem]">
            <p>
              Design teams working on existing buildings need data they can trust. The right survey methodology depends on what's being designed, not on what's cheapest or most convenient to deliver.
            </p>
            <p>
              If you're unsure what level of survey accuracy your next project requires, we're happy to advise based on your design scope &mdash; before you commit to anything.
            </p>
            <p>
              Briefing a refurbishment, fit-out, or change-of-use project? <a href="/contact/" class="text-navy font-medium hover:opacity-80 transition-opacity">Talk to Alturascope.</a> We'll give you an honest recommendation on survey methodology and an all-in quote within one business day.
            </p>
          </div>
        </div>

        <!-- Footer note -->
        <p class="mt-12 text-[0.85rem] text-midgrey/60 italic">
          Alturascope delivers survey-grade point cloud surveys, measured building surveys, and navigable digital twins across all 50 US states, every Canadian province, and the United Kingdom.
        </p>

        <!-- Internal Links -->
        <div class="mt-12 pt-8 border-t border-border flex flex-wrap gap-6 text-sm">
          <a href="/" class="text-navy font-medium hover:opacity-80 transition-opacity">Home &rarr;</a>
          <a href="/work/" class="text-navy font-medium hover:opacity-80 transition-opacity">The Standard &rarr;</a>
          <a href="/services/construction-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Construction documentation &rarr;</a>
          <a href="/services/heritage-building-documentation/" class="text-navy font-medium hover:opacity-80 transition-opacity">Heritage building documentation &rarr;</a>
          <a href="/insights/what-is-a-matterport-digital-twin/" class="text-navy font-medium hover:opacity-80 transition-opacity">What is a Matterport digital twin? &rarr;</a>
          <a href="/insights/above-ceiling-mep-survey-fit-out/" class="text-navy font-medium hover:opacity-80 transition-opacity">Above-ceiling MEP surveys &rarr;</a>
          <a href="/insights/" class="text-navy font-medium hover:opacity-80 transition-opacity">All insights &rarr;</a>
        </div>

      </div>
    </article>

    <!-- CTA -->
    <section class="bg-navy py-20">
      <div class="max-w-[600px] mx-auto px-6 text-center">
        <h2 class="text-[1.8rem] font-light text-offwhite leading-snug">
          Briefing a project on an existing building?
        </h2>
        <p class="mt-4 text-offwhite/70 leading-body">
          Tell us what you're designing and we'll recommend the right survey methodology. Honest advice and an all-in quote within one business day.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
      </div>
    </section>

  </div>
</Layout>
