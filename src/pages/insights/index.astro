// Twenty-six card categories made twenty-six filter chips, which is a wall
// rather than a filter. The granular label stays on the card; the chips group
// them into the handful of topics a reader actually arrives with.
const TOPIC_OF = {
  "ESTIMATING": "Estimating",
  "ESTIMATING UK": "Estimating",
  "COST & ROI": "Estimating",
  "SITE DOCUMENTATION": "Surveys & Method",
  "SURVEY METHODOLOGY": "Surveys & Method",
  "THERMAL IMAGING": "Surveys & Method",
  "MEP & FIT-OUT": "Surveys & Method",
  "BUYER'S GUIDE": "Surveys & Method",
  "DUE DILIGENCE": "Surveys & Method",
  "AI & METHOD": "Surveys & Method",
  "MULTI-SITE": "Multi-Site Programmes",
  "MULTI-SITE UK": "Multi-Site Programmes",
  "RETAIL ROLLOUT": "Multi-Site Programmes",
  "RETAIL UK": "Multi-Site Programmes",
  "FRANCHISE": "Multi-Site Programmes",
  "QSR REMODEL": "Multi-Site Programmes",
  "QSR & RESTAURANT": "Multi-Site Programmes",
  "CONVENIENCE RETAIL": "Multi-Site Programmes",
  "FASHION RETAIL": "Multi-Site Programmes",
  "AUTOMOTIVE": "Multi-Site Programmes",
  "ABA CLINICS": "Healthcare & Clinics",
  "ABA & AUTISM THERAPY": "Healthcare & Clinics",
  "HEALTHCARE": "Healthcare & Clinics",
  "VETERINARY": "Healthcare & Clinics",
  "DATA CENTRES": "Specialist Facilities",
  "DATA CENTRES UK": "Specialist Facilities",
  "CONTROLLED ENVIRONMENTS": "Specialist Facilities",
  "HERITAGE & SPECIALIST": "Specialist Facilities",
  "SELF-STORAGE": "Specialist Facilities",
};
const ORDER = ["Estimating", "Surveys & Method", "Multi-Site Programmes", "Healthcare & Clinics", "Specialist Facilities"];
const withTopic = posts.map((p) => ({ ...p, topic: TOPIC_OF[p.category] || "Surveys & Method" }));
const counts = withTopic.reduce((acc, p) => ({ ...acc, [p.topic]: (acc[p.topic] || 0) + 1 }), {});
const categories = ["All", ...ORDER.filter((t) => counts[t])];
---
<Layout
  title="Construction Insights & Industry Guides | Alturascope"
  description="Practical guides on existing conditions surveys, pre-lease due diligence and construction estimating - written for the people who have to price it and build it."
  canonical="https://alturascope.com/insights/"
  schema={schema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative h-[40vh] max-h-[400px] min-h-[280px] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.90)]"></div>
      </div>
      <div class="relative z-10 text-center px-6">
        <h1 class="text-[2.4rem] md:text-[3rem] font-light text-offwhite leading-tight">
          Insights.
        </h1>
        <p class="mt-4 text-offwhite/60 max-w-[520px] mx-auto leading-body">
          Practical perspectives on site documentation, reality capture, and the decisions these tools help project teams make.
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section class="bg-white section-padding">
      <div class="max-w-[900px] mx-auto px-6">

        <!-- Filter. Thirty-seven articles in one undifferentiated list ran to
             eighteen screens on a phone with no way to narrow it. -->
        <div class="flex flex-wrap gap-2 mb-12" role="group" aria-label="Filter articles by topic">
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              class="filter-chip text-[0.78rem] font-medium tracking-nav border border-border text-midgrey px-4 py-2 rounded-sm transition-colors hover:border-gold hover:text-navy"
            >
              {cat === "All" ? `All (${posts.length})` : `${cat} (${counts[cat]})`}
            </button>
          ))}
        </div>

        <p id="filter-count" class="sr-only" role="status" aria-live="polite"></p>

        <div class="space-y-12">
          {withTopic.map((post) => (
            <a href={post.href} class="post-card block group" data-category={post.topic}>
              <div class="border border-border rounded p-8 transition-all duration-300 hover:border-gold hover:shadow-md">
                <div class="flex items-center gap-4 mb-4">
                  <span class="label text-gold text-[0.7rem]">{post.category}</span>
                  <span class="text-midgrey/50 text-[0.8rem]">{post.date}</span>
                </div>
                <h2 class="text-[1.4rem] font-light text-navy leading-snug group-hover:opacity-80 transition-opacity">
                  {post.title}
                </h2>
                <p class="mt-3 text-midgrey text-[0.95rem] leading-relaxed">
                  {post.description}
                </p>
                <span class="inline-block mt-4 text-navy text-sm font-medium">Read article &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const chips = Array.from(document.querySelectorAll(".filter-chip"));
        const cards = Array.from(document.querySelectorAll(".post-card"));
        const status = document.getElementById("filter-count");
        const ACTIVE = ["bg-navy", "text-white", "border-navy"];
        const IDLE = ["text-midgrey", "border-border"];

        function apply(cat) {
          let shown = 0;
          cards.forEach((card) => {
            const match = cat === "All" || card.getAttribute("data-category") === cat;
            card.style.display = match ? "" : "none";
            if (match) shown++;
          });
          chips.forEach((chip) => {
            const on = chip.getAttribute("data-filter") === cat;
            chip.classList.toggle("is-active", on);
            ACTIVE.forEach((c) => chip.classList.toggle(c, on));
            IDLE.forEach((c) => chip.classList.toggle(c, !on));
            chip.setAttribute("aria-pressed", String(on));
          });
          if (status) status.textContent = `${shown} article${shown === 1 ? "" : "s"} shown`;
          const url = new URL(window.location.href);
          if (cat === "All") url.searchParams.delete("topic");
          else url.searchParams.set("topic", cat);
          history.replaceState(null, "", url);
        }

        chips.forEach((chip) => {
          chip.addEventListener("click", () => apply(chip.getAttribute("data-filter") || "All"));
        });

        const initial = new URL(window.location.href).searchParams.get("topic");
        apply(initial && chips.some((c) => c.getAttribute("data-filter") === initial) ? initial : "All");
      });
    </script>
</Layout>
