---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Alturascope Insights",
  "description": "Writing on site documentation, reality capture and construction estimating for teams making decisions on existing buildings.",
  "url": "https://alturascope.com/insights/",
  "publisher": {
    "@id": "https://alturascope.com/#organization"
  }
});

const posts = [
  {
    title: "How to Put AI Into a Construction Workflow, Not Around the Edges",
    description: "Most firms use AI at the periphery and change nothing. Moving it into the work means splitting judgement from clerical effort - and it changes capacity, not efficiency.",
    href: "/insights/how-to-put-ai-into-a-construction-workflow/",
    date: "September 2026",
    category: "AI & METHOD"
  },
  {
    title: "Fitting Out a Retail Unit Inside a Live Transit Terminal",
