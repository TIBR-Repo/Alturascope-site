---
import Layout from "../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Alturascope",
  "description": "Reality capture, 3D documentation, and conditions surveys for construction teams and specialist clients across the US, Canada, and the UK.",
  "url": "https://alturascope.com",
  "areaServed": ["United States", "Canada", "United Kingdom"],
  "serviceType": "Reality Capture and Site Documentation"
});

const workItems = [
  {
    image: "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=800&q=80",
    alt: "Professional commercial kitchen with stainless steel equipment and atmospheric lighting",
    type: "COMMERCIAL KITCHEN DOCUMENTATION",
    location: "Multi-site programme, US",
    placeholder: "Commercial kitchen or restaurant fit-out. Dramatic, professional."
  },
  {
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80",
    alt: "Above-ceiling view showing MEP services runs and structural elements in healthcare facility",
    type: "ABOVE-CEILING SURVEY",
    location: "Healthcare facility, Central US",
    placeholder: "Above-ceiling capture — MEP services visible, industrial atmosphere."
  },
  {
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=800&q=80",
    alt: "Heritage building interior with stone walls, timber structure, and significant architectural detail",
    type: "HERITAGE BUILDING DOCUMENTATION",
    location: "Private estate, UK",
    placeholder: "Heritage building interior — stone, timber, significant architectural detail."
  },
  {
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&q=80",
    alt: "Large empty commercial space with dramatic ceiling height prepared for pre-construction survey",
    type: "PRE-CONSTRUCTION SURVEY",
    location: "Commercial fit-out, Canada",
    placeholder: "Large commercial space — empty, atmospheric, dramatic ceiling height."
  },
  {
    image: "https://images.unsplash.com/photo-1519681393784-d120267933ba?w=800&q=80",
    alt: "Aerial view of significant multi-building estate for documentation survey",
    type: "AERIAL DOCUMENTATION",
    location: "Multi-building estate, Southeast US",
    placeholder: "Exterior aerial or drone photography of significant building or site."
  },
  {
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80",
    alt: "ScopeWalk platform interface showing structured project documentation and programme portal",
    type: "SCOPEWALK™ PLATFORM",
    location: "Programme portal, active rollout",
    placeholder: "ScopeWalk platform screenshot in browser device frame."
  }
];
---
<Layout
  title="Site Documentation Work & Projects | Alturascope"
  description="A selection of Alturascope's site documentation, reality capture, and conditions survey work across commercial, heritage, and specialist projects."
  canonical="https://alturascope.com/work"
  schema={schema}
  fullWidth={true}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative h-[50vh] min-h-[350px] flex items-center justify-center">
      <div class="absolute inset-0 bg-navy">
        <img
          src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1920&q=80"
          alt="Atmospheric architectural interior showcasing site documentation work"
          class="w-full h-full object-cover opacity-30"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>
      <div class="relative z-10 text-center px-6">
        <h1 class="text-[2.4rem] md:text-[3.2rem] font-light text-offwhite leading-tight">
          Selected work.
        </h1>
      </div>
    </section>

    <!-- Grid -->
    <section class="bg-white section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {workItems.map((item) => (
            <div class="group">
              <!-- REPLACE: {item.placeholder} -->
              <div class="overflow-hidden">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
              <div class="mt-4">
                <p class="text-[0.85rem] font-medium uppercase tracking-[0.08em] text-navy">{item.type}</p>
                <p class="text-[0.85rem] text-midgrey mt-0.5">{item.location}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-20 text-center">
          <a href="/contact" class="btn-primary">Start a project</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
