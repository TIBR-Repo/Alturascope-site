---
import Layout from "../layouts/Layout.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import HeroSlides from "../components/HeroSlides.astro";

const professionalServiceSchema = {
  "@type": "ProfessionalService",
  "name": "Alturascope",
  "description": "Reality capture, site documentation and construction estimating for contractors, multi-site operators and specialist clients across the US, Canada, and the UK.",
  "url": "https://alturascope.com/",
  "areaServed": ["United States", "Canada", "United Kingdom"],
  "serviceType": ["Site Documentation", "Construction Estimating"],
  "sameAs": ["https://www.linkedin.com/company/111948383"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Alturascope services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Site documentation and reality capture",
          "description": "Matterport digital twins, LiDAR point clouds and structured conditions reports for commercial buildings.",
          "url": "https://alturascope.com/services/",
        },
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Construction estimating",
          "description": "Priced, white-labeled bid packages for contractors, returned under their own name inside two working days.",
          "url": "https://alturascope.com/estimating/",
        },
      },
    ],
  },
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": "https://alturascope.com/#website",
  "url": "https://alturascope.com/",
  "name": "Alturascope",
  "alternateName": ["Alturascope Site Documentation", "The Alturascope Estimating Desk"],
  "description": "Site documentation and construction estimating across the US, Canada and the UK.",
  "publisher": { "@id": "https://alturascope.com/#organization" },
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [professionalServiceSchema, websiteSchema],
});
---
<Layout
  title="Existing Conditions Surveys &amp; Construction Estimating"
  description="Existing conditions and as-built surveys for multi-site fit-out programmes, plus construction estimating. US, Canada and UK. One standard, every site."
  canonical="https://alturascope.com/"
  schema={schema}
  fullWidth={true}
  lang="en"
  hreflang={[
    { lang: "en", href: "https://alturascope.com/" },
    { lang: "en-gb", href: "https://alturascope.com/uk/" },
    { lang: "x-default", href: "https://alturascope.com/" },
  ]}
>
  <div data-hero-page>

    <!-- SECTION 1: Hero - the work itself, captioned with where it is -->
    <HeroSlides />

    <!-- SECTION 2: Credibility Bar -->
    <section class="bg-navy border-t border-white/10 py-10 md:py-12">
      <div class="max-w-[1100px] mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 text-center">
          <div>
            <p class="text-[2.4rem] font-light text-offwhite">500+</p>
            <p class="text-[0.7rem] font-medium uppercase tracking-[0.12em] text-offwhite/60 mt-1">Commercial Sites Surveyed</p>
          </div>
          <div>
            <p class="text-[2.4rem] font-light text-offwhite">All 50</p>
            <p class="text-[0.7rem] font-medium uppercase tracking-[0.12em] text-offwhite/60 mt-1">States &amp; Canada</p>
          </div>
          <div>
            <p class="text-[2.4rem] font-light text-offwhite">3 days</p>
            <p class="text-[0.7rem] font-medium uppercase tracking-[0.12em] text-offwhite/60 mt-1">Typical Visit to Report</p>
          </div>
          <div>
            <p class="text-[2.4rem] font-light text-offwhite">18</p>
            <p class="text-[0.7rem] font-medium uppercase tracking-[0.12em] text-offwhite/60 mt-1">Years Construction Experience</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2a: Featured projects, straight after the numbers -->
    <FeaturedProjects />

    <!-- SECTION 2a-i: Client reference, straight after the work it refers to -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-[900px] mx-auto px-6 text-center">
        <p class="label text-gold mb-6">Client Reference</p>
        <blockquote class="text-[1.25rem] md:text-[1.6rem] font-light text-navy leading-relaxed">
          &ldquo;You have been great so far, and deliver exceptional quality reports and data,
          miles ahead of our previous reports. Your response time is on par as well, and the
          urgency in your scope is never overlooked. Here&rsquo;s to 22 more locations!&rdquo;
        </blockquote>
        <p class="mt-6 text-midgrey text-[0.9rem]">Nathaniel Lindley &mdash; Construction Manager, West Coast</p>
        <p class="mt-1 text-midgrey/70 text-[0.8rem]">National retail rollout programme</p>
      </div>
    </section>

    <!-- SECTION 2b: Two Services -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center max-w-[60ch] mx-auto mb-14">
          <p class="label text-gold mb-4">Two Services</p>
          <h2 class="text-[2rem] md:text-[2.2rem] font-light text-navy leading-tight">
            The survey, and the number that follows it.
          </h2>
          <p class="mt-5 text-midgrey leading-body">
            Most of our clients arrive with one of two questions. We built a service for each &mdash; and on a renovation, the second is far better for having done the first.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="card p-9">
            <p class="label text-gold mb-3">Site Documentation</p>
            <h3 class="text-[1.3rem] font-medium text-navy">&ldquo;What am I actually working with?&rdquo;</h3>
            <p class="mt-4 text-midgrey leading-body">
              Digital twins, conditions reports, equipment schedules and above-ceiling capture &mdash; delivered in the same structure every time, through ScopeWalk. For teams making decisions on space before anyone breaks ground.
            </p>
            <p class="mt-6">
              <a href="/services/" class="text-navy font-medium border-b border-gold pb-0.5 hover:opacity-80 transition-opacity">See the documentation service &rarr;</a>
            </p>
          </div>

          <div class="card border-gold bg-offwhite p-9">
            <p class="label text-gold mb-3">Estimating Desk</p>
            <h3 class="text-[1.3rem] font-medium text-navy">&ldquo;What is it going to cost me?&rdquo;</h3>
            <p class="mt-4 text-midgrey leading-body">
              Send us the drawings; we send back a priced, client-ready bid under your own name &mdash; usually inside two working days. Thirty-three years of construction and estimating experience, on software that won&rsquo;t let a number through without a source.
            </p>
            <p class="mt-6">
              <a href="/estimating/" class="text-navy font-medium border-b border-gold pb-0.5 hover:opacity-80 transition-opacity">See the estimating service &rarr;</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: What you receive - twin, deliverables and ScopeWalk in one band -->
    <section id="scopewalk" class="bg-navy section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <p class="label text-gold mb-4">What You Receive</p>
            <h2 class="text-[2rem] font-light text-offwhite leading-tight">
              The same structure. Every site. Every time.
            </h2>
            <p class="mt-5 text-offwhite/70 leading-body">
              A navigable digital twin, measured to the wall and column, plus everything your team
              needs to decide on the space &mdash; delivered through ScopeWalk&trade;, our project
              portal, so every site lives in one permanent, comparable record.
            </p>
            <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-offwhite/85 text-[0.95rem] list-none p-0">
              <li class="border-l-2 border-gold pl-3">Navigable digital twin</li>
              <li class="border-l-2 border-gold pl-3">Narrated video walkthrough</li>
              <li class="border-l-2 border-gold pl-3">Conditions report, P1&ndash;P3</li>
              <li class="border-l-2 border-gold pl-3">Equipment &amp; asset schedule</li>
              <li class="border-l-2 border-gold pl-3">Labeled photo storyboard</li>
              <li class="border-l-2 border-gold pl-3">ScopeWalk portal access</li>
            </ul>
            <div class="mt-10 flex flex-wrap items-center gap-6">
              <a href="/work/sample-project/" class="btn-primary">Explore a sample project</a>
              <a href="/services/" class="text-offwhite font-medium border-b border-gold pb-0.5 hover:opacity-80 transition-opacity">How a survey works &rarr;</a>
            </div>
          </div>
          <figure class="m-0">
            <img
              src="/Images/locations/digital-twin-mesh.webp"
              srcset="/Images/locations/digital-twin-mesh-640w.webp 640w, /Images/locations/digital-twin-mesh-1024w.webp 1024w, /Images/locations/digital-twin-mesh.webp 1280w"
              sizes="(min-width: 1024px) 560px, 100vw"
              alt="Measured mesh of a surveyed office floor plate, showing every wall, column and riser in its true position"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
            <figcaption class="mt-4 text-offwhite/55 text-[0.85rem] leading-relaxed">
              Beneath the walkthrough imagery: a measured mesh of the floor plate. It is why a
              dimension taken from a twin still holds months later &mdash; and why the same record can be priced.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- SECTION 6: Who We Work With (coverage folded in) -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[1200px] mx-auto px-6">
        <p class="label text-gold text-center mb-4">Who We Work With</p>
        <h2 class="text-[2rem] font-light text-navy text-center">
          Built for teams making decisions on space.
        </h2>
        <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded border border-border p-8">
            <h3 class="text-navy font-medium text-[1.1rem] mb-3">
              <a href="/services/multi-site-rollout-documentation/" class="hover:opacity-80 transition-opacity">Rollout &amp; multi-site programmes</a>
            </h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              PE-backed operators, franchise groups, healthcare networks and national brands. One brief, one standard, every site.
            </p>
            <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[0.85rem]">
              <a href="/services/qsr-restaurant-survey/" class="text-navy font-medium hover:opacity-80">QSR &amp; Restaurant &rarr;</a>
              <a href="/services/aba-autism-clinic-documentation/" class="text-navy font-medium hover:opacity-80">ABA &amp; Autism Therapy &rarr;</a>
              <a href="/services/retail-rollout-documentation/" class="text-navy font-medium hover:opacity-80">Retail &amp; Franchise &rarr;</a>
              <a href="/services/healthcare-facility-survey/" class="text-navy font-medium hover:opacity-80">Healthcare &rarr;</a>
            </p>
          </div>
          <div class="bg-white rounded border border-border p-8">
            <h3 class="text-navy font-medium text-[1.1rem] mb-3">General contractors &amp; design-build</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              <a href="/services/pre-construction-site-intelligence/" class="text-navy underline underline-offset-2 hover:opacity-80">Pre-construction site intelligence</a>, above-ceiling capture and conditions surveys that get your team off site faster and into design sooner.
            </p>
          </div>
          <div class="bg-white rounded border border-border p-8">
            <h3 class="text-navy font-medium text-[1.1rem] mb-3">Developers &amp; asset managers</h3>
            <p class="text-midgrey text-[0.9rem] leading-relaxed">
              <a href="/services/construction-documentation/" class="text-navy underline underline-offset-2 hover:opacity-80">Pre-lease diligence</a>, renew-versus-relocate analysis and <a href="/services/multi-site-rollout-documentation/" class="text-navy underline underline-offset-2 hover:opacity-80">multi-site capex programmes</a>.
            </p>
          </div>
        </div>
        <p class="mt-10 text-center text-midgrey text-[0.9rem] leading-relaxed max-w-[80ch] mx-auto">
          All 50 states and Canada, travel included:
          <a href="/services/northeast-site-surveys/" class="text-navy font-medium hover:opacity-80">Northeast</a>,
          <a href="/services/southeast-site-surveys/" class="text-navy font-medium hover:opacity-80">Southeast</a>,
          <a href="/services/central-us-site-surveys/" class="text-navy font-medium hover:opacity-80">Central US</a> and
          <a href="/services/west-coast-site-surveys/" class="text-navy font-medium hover:opacity-80">West Coast</a>.
          Working in the UK? <a href="/uk/" class="text-navy font-medium hover:opacity-80">Visit Alturascope UK &rarr;</a>
          Heritage and other specialist work: <a href="/services/specialist-projects/" class="text-navy font-medium hover:opacity-80">tell us about yours &rarr;</a>
        </p>
      </div>
    </section>

    <!-- SECTION 9: Closing CTA -->
    <section class="bg-white section-padding">
      <div class="max-w-[700px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] md:text-[2.2rem] font-light text-navy">
          Ready to know exactly what you&rsquo;re working with?
        </h2>
        <p class="mt-4 text-midgrey leading-body">
          Share the address, the approximate size, and what decision you're trying to make. We'll come back to you within one business day with a clear scope recommendation and an all-in quote — travel included.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact/" class="btn-primary">Start a Project</a>
          <a href="/work/" class="btn-secondary">The Standard</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const iframes = document.querySelectorAll("iframe[data-src]");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const iframe = entry.target as HTMLIFrameElement;
            if (iframe.dataset.src) {
              iframe.src = iframe.dataset.src;
              delete iframe.dataset.src;
            }
            observer.unobserve(iframe);
          }
        });
      }, { rootMargin: "200px" });

      iframes.forEach((iframe) => observer.observe(iframe));
    });
  </script>
</Layout>
