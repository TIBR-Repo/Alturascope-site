---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Page Not Found | Alturascope"
  description="The page you're looking for doesn't exist or has moved."
  canonical="https://alturascope.com/404/"
  robots="noindex, nofollow"
  fullWidth={true}
>
  <section class="bg-white min-h-[70vh] flex items-center justify-center">
    <div class="max-w-[500px] mx-auto px-6 text-center py-32">
      <h1 class="text-[2.4rem] md:text-[3rem] font-light text-navy leading-tight">
        Page not found.
      </h1>
      <p class="mt-4 text-midgrey leading-body">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a href="/" class="btn-primary mt-8">Back to Home</a>
    </div>
  </section>
</Layout>
