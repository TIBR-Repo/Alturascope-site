---
import Layout from "../../layouts/Layout.astro";
import EstimatingBand from "../../components/EstimatingBand.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Heritage Building Survey UK",
  "description": "Survey-grade documentation for Grade I and Grade II listed buildings, scheduled monuments, and conservation areas across the UK. Records for English Heritage, Historic Scotland, Cadw, and conservation architects.",
  "url": "https://alturascope.com/uk/heritage-building-survey/",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Alturascope"
  },
  "areaServed": { "@type": "Country", "name": "United Kingdom" },
  "serviceType": "Heritage Building Survey"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "UK", "item": "https://alturascope.com/uk/" },
    { "@type": "ListItem", "position": 3, "name": "Heritage Building Survey UK", "item": "https://alturascope.com/uk/heritage-building-survey/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you produce records to Historic England Level 2, 3, or 4?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our documentation aligns with Historic England Level 2 and Level 3 survey standards. Level 4 (full measured survey) is scoped specifically where required — typically for complex conservation projects or where detailed dimensional records are needed for structural or architectural design. We discuss the appropriate level during the brief." }
    },
    {
      "@type": "Question",
      "name": "Can you document buildings with very restricted access?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We use pole-mounted 360° capture, borescope inspection, thermal imaging, and drone documentation where appropriate to reach areas that are inaccessible by conventional means. No scaffolding or disruption to historic fabric is required. This non-invasive approach is essential for listed buildings with restricted access." }
    },
    {
      "@type": "Question",
      "name": "What format do planning submissions require?",
      "acceptedAnswer": { "@type": "Answer", "text": "Requirements vary by local planning authority (LPA). Your conservation architect or heritage consultant will advise on the specific format and level of detail needed for your listed building consent application. We produce documentation that can be adapted to meet LPA requirements — point cloud data, measured drawings, conditions reports, and visual records in formats that planners and heritage officers can work from." }
    },
    {
      "@type": "Question",
      "name": "Do you work on Grade I as well as Grade II listed buildings?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We work on all grades of listed buildings — Grade I, Grade II*, and Grade II in England, Category A, B, and C in Scotland, and equivalent designations in Wales and Northern Ireland. We also document scheduled monuments. The capture methodology is tailored to the sensitivity and significance of the building." }
    },
    {
      "@type": "Question",
      "name": "Do you cover rural locations and estates outside the main cities?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer full UK coverage with all-in pricing — travel is included. Whether your heritage building is in central London, the Scottish Highlands, rural Wales, or a remote estate, you receive the same standard of documentation at the same pricing structure. No location surcharge." }
    }
  ]
});
---
<Layout
  title="Listed Building Recording &amp; Heritage Surveys UK"
  description="Navigable, measurable digital records of listed and heritage buildings - pre-intervention records, listed building consent, quinquennial inspections and insurance."
  canonical="https://alturascope.com/uk/heritage-building-survey/"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
  lang="en-GB"
  hreflang={[{ lang: "en-GB", href: "https://alturascope.com/uk/heritage-building-survey/" }, { lang: "en", href: "https://alturascope.com/services/heritage-building-documentation/" }]}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center pt-24">
      <div class="absolute inset-0 bg-navy">
        <img
          src="/dan-stephens-gDP_HYXfUwM-unsplash.webp"
          alt="Listed heritage country house documented with LiDAR and Matterport for heritage survey, showing Palladian architecture reflected in ornamental lake"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>

      <div class="relative z-10 text-center max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-6">UK Services &middot; Heritage &amp; Listed Buildings</p>
        <h1 class="text-[2.4rem] md:text-[3.6rem] font-light text-offwhite leading-[1.1]">
          Digital Recording of Listed and Heritage Buildings
        </h1>
        <p class="mt-6 text-[1.15rem] text-offwhite/80 font-normal leading-relaxed max-w-[640px] mx-auto">
          A navigable, measurable, permanent record of a listed building as it stands today &mdash;
          for pre-intervention records, listed building consent applications, quinquennial
          inspections and insurance. We record; we do not assess.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact/" class="btn-primary">Tell Us About Your Project</a>
          <a href="/uk/" class="btn-secondary-light">See UK Services</a>
        </div>
      </div>

      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4">
        <div class="w-[60px] h-[1px] bg-gold"></div>
        <svg class="w-5 h-5 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- Why Heritage Buildings Require a Different Survey Approach -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">The Gap We Fill</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          The record almost nobody produces.
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Heritage consultants write reports. Measured building surveyors produce CAD and point
            cloud for architects. Conservation officers want written and photographic records to
            Historic England's Levels 1&ndash;4. All of that exists and all of it is done well.
          </p>
          <p>
            What almost nobody produces is a <span class="text-navy font-medium">navigable,
            dimensionally accurate, permanent record of the building as it stands</span> &mdash;
            the thing a trustee, an insurer, an incoming architect or a contractor can walk
            through two years later without going back to site, and take a measurement from.
            That is the whole of what we do here.
          </p>
          <p>
            It sits alongside a Level 2 or Level 3 record rather than replacing it. Where a
            written record describes and a photograph shows one view, the capture lets somebody
            move through the building and measure what they find &mdash; which is what makes it
            useful to people who were never on site.
          </p>
        </div>

        <div class="mt-10 border-l-2 border-gold bg-offwhite py-6 px-7">
          <p class="text-navy font-medium leading-snug text-[1.05rem]">
            What we do, and what we deliberately do not.
          </p>
          <p class="mt-3 text-midgrey leading-body">
            <span class="text-navy font-medium">We do:</span> capture the building, produce a
            navigable digital twin and point cloud, record the fabric photographically, and hand
            over a permanent record you own.
          </p>
          <p class="mt-3 text-midgrey leading-body">
            <span class="text-navy font-medium">We do not:</span> assess significance, write
            heritage statements, specify repairs, or advise on conservation methodology. Those
            belong to a conservation-accredited architect or heritage consultant, and we will
            happily work alongside yours &mdash; or say so plainly when you need one and do not
            yet have one.
          </p>
        </div>

        <div class="mt-10 space-y-4 text-midgrey leading-body">
          <p>
            <span class="text-navy font-medium">Why us, then, rather than a survey firm with a
            tripod.</span> Andrew Harris spent his first decade in UK construction working in and
            around Grade I and Grade II* listed buildings, including private and royal estates
            &mdash; on the management and coordination side rather than on the tools. That is a
            working familiarity with how these buildings behave, what a conservation officer will
            ask about, and where the awkward junctions are. It shapes what gets recorded and how
            carefully the work is done around fragile fabric.
          </p>
        </div>
      </div>
    </section>

    <!-- What a Heritage Building Survey Delivers -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">Deliverables</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          What a Heritage Building Survey Delivers
        </h2>

        <div class="mt-10 space-y-8">
          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">Survey-Grade Point Cloud Data</h3>
            <p class="text-midgrey leading-body">
              Millimetre-accurate LiDAR capture producing point cloud data suitable for CAD, Revit, and BIM workflows. The kind of data conservation architects and structural engineers can take measurements from and rely on.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">Navigable Digital Twin</h3>
            <p class="text-midgrey leading-body">
              Dimensionally accurate, explorable remotely by any team member. The accessible exploration layer for your wider team, heritage consultants, and stakeholders.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">Measured Floor Plans, Sections &amp; Elevations</h3>
            <p class="text-midgrey leading-body">
              Derived from the point cloud where required. Formatted for planning submissions, conservation management plans, and design development.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">Conditions Report</h3>
            <p class="text-midgrey leading-body">
              Written findings prioritised P1, P2, P3. Materials and fabric condition documented with the care and attention that historic environments require.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">Narrated Video Walkthrough</h3>
            <p class="text-midgrey leading-body">
              Spoken commentary on conditions, concerns, and findings. Delivers context that static reports cannot.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <h3 class="text-navy font-medium text-[1.15rem] mb-2">ScopeWalk Platform Access</h3>
            <p class="text-midgrey leading-body">
              Permanent, structured, shareable. All deliverables accessible through one platform for your conservation team, planners, and heritage consultants.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Commissions Heritage Building Surveys -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">Who Commissions</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Who Commissions Heritage Building Surveys
        </h2>

        <ul class="mt-10 space-y-4">
          <li class="border-l-2 border-gold pl-6 text-midgrey leading-body"><strong class="text-navy">Conservation architects</strong> &mdash; pre-intervention records for listed building consent applications and design development</li>
          <li class="border-l-2 border-gold pl-6 text-midgrey leading-body"><strong class="text-navy">Private estate owners</strong> &mdash; complete records of significant historic properties for estate management and future planning</li>
          <li class="border-l-2 border-gold pl-6 text-midgrey leading-body"><strong class="text-navy">Developers and investors</strong> &mdash; due diligence and conditions documentation before acquisition or refurbishment</li>
          <li class="border-l-2 border-gold pl-6 text-midgrey leading-body"><strong class="text-navy">Local authorities</strong> &mdash; heritage asset records, conservation area documentation, and planning support</li>
          <li class="border-l-2 border-gold pl-6 text-midgrey leading-body"><strong class="text-navy">Building preservation trusts</strong> &mdash; baseline documentation for restoration projects and grant applications</li>
        </ul>
      </div>
    </section>

    <!-- Documentation That Meets Heritage Authority Requirements -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">Heritage Authority Alignment</p>
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Documentation That Meets Heritage Authority Requirements
        </h2>
        <div class="mt-6 space-y-6 text-midgrey leading-body">
          <p>
            Our documentation is designed to align with the requirements of the heritage bodies across the UK:
          </p>
          <ul class="space-y-3">
            <li><strong class="text-navy">England</strong> &mdash; Historic England survey levels and listed building consent documentation standards</li>
            <li><strong class="text-navy">Scotland</strong> &mdash; Historic Environment Scotland requirements for scheduled monuments and listed buildings</li>
            <li><strong class="text-navy">Wales</strong> &mdash; Cadw documentation standards for conservation and planning</li>
            <li><strong class="text-navy">Northern Ireland</strong> &mdash; Historic Environment Division requirements for listed buildings and scheduled monuments</li>
          </ul>
          <p>
            We produce records that support listed building consent applications, grant submissions, conservation management plans, and heritage impact assessments. The deliverable format is scoped during the brief to match what your conservation team and LPA require.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Frequently Asked Questions</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you produce records to Historic England Level 2, 3, or 4?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Our documentation aligns with Historic England Level 2 and Level 3 survey standards. Level 4 (full measured survey) is scoped specifically where required &mdash; typically for complex conservation projects or where detailed dimensional records are needed for structural or architectural design. We discuss the appropriate level during the brief.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you document buildings with very restricted access?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We use pole-mounted 360&deg; capture, borescope inspection, thermal imaging, and drone documentation where appropriate to reach areas that are inaccessible by conventional means. No scaffolding or disruption to historic fabric is required. This non-invasive approach is essential for listed buildings with restricted access.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What format do planning submissions require?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Requirements vary by local planning authority (LPA). Your conservation architect or heritage consultant will advise on the specific format and level of detail needed for your listed building consent application. We produce documentation that can be adapted to meet LPA requirements &mdash; point cloud data, measured drawings, conditions reports, and visual records in formats that planners and heritage officers can work from.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you work on Grade I as well as Grade II listed buildings?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We work on all grades of listed buildings &mdash; Grade I, Grade II*, and Grade II in England, Category A, B, and C in Scotland, and equivalent designations in Wales and Northern Ireland. We also document scheduled monuments. The capture methodology is tailored to the sensitivity and significance of the building.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you cover rural locations and estates outside the main cities?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes. We offer full UK coverage with all-in pricing &mdash; travel is included. Whether your heritage building is in central London, the Scottish Highlands, rural Wales, or a remote estate, you receive the same standard of documentation at the same pricing structure. No location surcharge.
            </p>
          </details>
        </div>
      </div>
    </section>

    <EstimatingBand locale="uk" lead="Listed building work is priced on access, fabric and constraint rather than floor area." />

    <!-- CTA -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[700px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">
          Tell Us About Your Heritage Project
        </h2>
        <p class="mt-4 text-midgrey leading-body">
          Describe the building, the listed status, and what the documentation needs to achieve. We'll come back with a clear scope and an all-in quote.
        </p>
        <div class="mt-10">
          <a href="/contact/" class="btn-primary">Start a Project</a>
        </div>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="text-midgrey text-sm mb-4">Related UK services:</p>
        <div class="flex flex-wrap gap-6">
          <a href="/uk/pre-construction-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Pre-Construction Survey UK &rarr;</a>
          <a href="/uk/measured-building-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Measured Building Survey UK &rarr;</a>
          <a href="/uk/" class="text-navy font-medium hover:opacity-80 transition-opacity">Alturascope UK &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Footer note -->
    <p class="text-center text-[0.85rem] text-midgrey/60 italic py-8 bg-white">
      Alturascope delivers professional site documentation across all 50 US states, every Canadian province, and the United Kingdom.
    </p>

    <!-- Navy CTA bar -->
    <section class="bg-navy py-12">
      <div class="max-w-[760px] mx-auto px-6 text-center">
        <p class="text-offwhite text-lg font-light mb-6">
          Ready to document your heritage building?
        </p>
        <a href="/contact/" class="btn-primary">Get in Touch</a>
      </div>
    </section>

  </div>
</Layout>
