---
import Layout from "../../layouts/Layout.astro";
import EstimatingBand from "../../components/EstimatingBand.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "provider": {
    "@type": "ProfessionalService",
    "name": "AlturaScope"
  },
  "description": "Non-invasive above-ceiling MEP documentation for UK commercial fit-out. Thermal imaging, 360° pole-mounted capture, and borescope inspection to document existing services before design is committed.",
  "areaServed": { "@type": "Country", "name": "United Kingdom" },
  "serviceType": "MEP Survey"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "UK", "item": "https://alturascope.com/uk/" },
    { "@type": "ListItem", "position": 3, "name": "Above-Ceiling MEP Survey UK", "item": "https://alturascope.com/uk/above-ceiling-mep-survey/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you need to open up the ceiling to survey above it?",
      "acceptedAnswer": { "@type": "Answer", "text": "Usually no, work through existing access." }
    },
    {
      "@type": "Question",
      "name": "Can you identify specific services — ductwork sizes, pipe diameters, cable types?",
      "acceptedAnswer": { "@type": "Answer", "text": "Document what's visible, may need M&E specialist for formal schedules." }
    },
    {
      "@type": "Question",
      "name": "Is above-ceiling documentation included in a standard pre-construction survey?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes as standard." }
    },
    {
      "@type": "Question",
      "name": "What if there's no suspended ceiling — just an exposed concrete soffit?",
      "acceptedAnswer": { "@type": "Answer", "text": "Document exposed services from below." }
    }
  ]
});
---
<Layout
  title="Above-Ceiling MEP Survey UK — Existing Services Documentation | Alturascope"
  description="Non-invasive above-ceiling MEP documentation for UK commercial fit-out. Thermal imaging, 360° pole-mounted capture, and borescope inspection to document existing services before design is committed."
  canonical="https://alturascope.com/uk/above-ceiling-mep-survey/"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
  lang="en-GB"
  hreflang={[{ lang: "en-gb", href: "https://alturascope.com/uk/above-ceiling-mep-survey/" }, { lang: "en", href: "https://alturascope.com/uk/above-ceiling-mep-survey/" }]}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center pt-24">
      <div class="absolute inset-0 bg-navy">
        <img
          src="/above-ceiling-survey.jpg"
          width="1920"
          height="1451"
          alt="Ductwork, conduit and structural deck above the ceiling line, documented on a UK above-ceiling MEP survey"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>

      <div class="relative z-10 text-center max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-6">UK Services · Above-Ceiling &amp; MEP</p>
        <h1 class="text-[2.4rem] md:text-[3.6rem] font-light text-offwhite leading-[1.1]">
          Above-Ceiling MEP Survey UK &mdash; Document Existing Services Before Fit-Out Begins
        </h1>
        <p class="mt-6 text-[1.15rem] text-offwhite/80 font-normal leading-relaxed max-w-[620px] mx-auto">
          The most expensive surprises in commercial fit-out come from above the ceiling. Document what's there before design is committed.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact/" class="btn-primary">Find Out What's Above Your Ceiling</a>
          <a href="/uk/" class="btn-secondary-light">UK Services</a>
        </div>
      </div>

      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4">
        <div class="w-[60px] h-[1px] bg-gold"></div>
        <svg class="w-5 h-5 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- What's Above the Ceiling — And Why It's Almost Never Documented -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          What's Above the Ceiling &mdash; And Why It's Almost Never Documented
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            HVAC ductwork from previous tenancies. Pipework that doesn't match any drawing. Drainage stacks that block the intended partition layout. Above the suspended ceiling is where the previous fit-out left its mark &mdash; and where the next one discovers the surprises.
          </p>
          <p>
            Most pre-construction documentation stops at floor level. The ceiling comes down, and the design assumptions collapse with it. Above-ceiling MEP documentation captures what's actually there before you specify the new layout.
          </p>
        </div>
      </div>
    </section>

    <!-- How We Document Above-Ceiling Conditions -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight mb-8">
          How We Document Above-Ceiling Conditions
        </h2>

        <div class="space-y-8">
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Thermal Imaging</h3>
            <p class="mt-2 text-midgrey leading-body">
              FLIR first pass to identify hot and cold runs, concealed services, and thermal anomalies before any physical access.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">360&deg; Pole-Mounted Capture</h3>
            <p class="mt-2 text-midgrey leading-body">
              Panoramic capture above the ceiling through access panels. No scaffolding, no disruption. Full visual record of ductwork, pipework, and cable runs.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Borescope and Endoscope Inspection</h3>
            <p class="mt-2 text-midgrey leading-body">
              Reach into voids and tight spaces where the pole camera cannot go. Document what's hidden behind bulkheads and above soffits.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Narrated Conditions Commentary</h3>
            <p class="mt-2 text-midgrey leading-body">
              Spoken walkthrough of findings. What matters for design, what matters for cost, what the M&E team needs to know.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- The Cost of Not Knowing What's Up There -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          The Cost of Not Knowing What's Up There
        </h2>
        <p class="mt-6 text-midgrey leading-body">
          Before vs after: the ceiling comes down, the duct runs where the partition was supposed to go, the drainage stack blocks the kitchen layout. A single surprise can cost &pound;5,000&ndash;&pound;25,000 in rework, delay, and change orders.
        </p>

        <div class="mt-10">
          <div class="bg-offwhite p-8 rounded">
            <h3 class="text-navy font-medium mb-3">Before documentation</h3>
            <p class="text-midgrey leading-body mb-4">
              Design assumes conditions. Contractor discovers conflicts on site. Change order. Programme slip. Client frustration.
            </p>
            <h3 class="text-navy font-medium mb-3">After documentation</h3>
            <p class="text-midgrey leading-body">
              Design informed by what's actually there. M&E team knows the constraints. Fewer surprises, fewer change orders, programme stays on track.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Benefits From Above-Ceiling MEP Documentation -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight mb-8">
          Who Benefits From Above-Ceiling MEP Documentation
        </h2>

        <div class="space-y-6">
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Commercial fit-out PMs</h3>
            <p class="mt-2 text-midgrey leading-body">Reduce risk before tender. Inform design decisions. Avoid above-ceiling surprises.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Architects and M&amp;E</h3>
            <p class="mt-2 text-midgrey leading-body">Design with visibility. Know where services run before you specify partitions and ceilings.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Restaurant and food service</h3>
            <p class="mt-2 text-midgrey leading-body">Kitchen extract, grease ducting, and drainage runs. Document before you commit to layout.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Healthcare and education</h3>
            <p class="mt-2 text-midgrey leading-body">Clinical and lab services. Specialist MEP requirements. Document existing before specifying new.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Landlords and asset managers</h3>
            <p class="mt-2 text-midgrey leading-body">Pre-letting documentation. Dilapidation records. Know what's above the ceiling for tenant handover.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Frequently Asked Questions</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you need to open up the ceiling to survey above it?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Usually no, work through existing access.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you identify specific services &mdash; ductwork sizes, pipe diameters, cable types?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Document what's visible, may need M&amp;E specialist for formal schedules.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Is above-ceiling documentation included in a standard pre-construction survey?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes as standard.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What if there's no suspended ceiling &mdash; just an exposed concrete soffit?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Document exposed services from below.
            </p>
          </details>
        </div>
      </div>
    </section>

    <EstimatingBand locale="uk" lead="What is above the ceiling is usually what moves the mechanical and electrical price." />

    <!-- CTA -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">
          Find Out What's Above Your Ceiling Before Fit-Out Begins
        </h2>
        <p class="mt-4 text-midgrey leading-body">
          Share the address or approximate location, the size of the space, and what you're planning. We'll come back within one business day with a clear scope recommendation and an all-in quote &mdash; travel included.
        </p>
        <a href="/contact/" class="btn-primary mt-10">Contact Us</a>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">Related UK Services</p>
        <div class="flex flex-wrap gap-6 text-midgrey">
          <a href="/uk/pre-construction-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Pre-construction survey UK &rarr;</a>
          <a href="/uk/measured-building-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Measured building survey UK &rarr;</a>
          <a href="/uk/" class="text-navy font-medium hover:opacity-80 transition-opacity">Alturascope UK &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Footer note -->
    <p class="text-center text-[0.85rem] text-midgrey/60 italic py-8 bg-white">
      Alturascope delivers professional site documentation across all 50 US states, every Canadian province, and the United Kingdom.
    </p>

    <!-- Navy CTA bar -->
    <section class="bg-navy py-20">
      <div class="max-w-[600px] mx-auto px-6 text-center">
        <h2 class="text-[1.8rem] font-light text-offwhite leading-snug">
          Ready to document what's above your ceiling?
        </h2>
        <p class="mt-4 text-offwhite/70 leading-body">
          Share the location, the approximate size, and what you're planning. We'll confirm scope and send an all-in quote within one business day.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
      </div>
    </section>

  </div>
</Layout>
