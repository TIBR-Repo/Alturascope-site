---
import Layout from "../../layouts/Layout.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "provider": {
    "@type": "ProfessionalService",
    "name": "AlturaScope"
  },
  "description": "Survey-grade measured building surveys across the UK. Point cloud data accurate to 5–12mm for CAD and Revit workflows. As-built floor plans, sections, and elevations. .e57 and .rcp export.",
  "areaServed": { "@type": "Country", "name": "United Kingdom" },
  "serviceType": "Measured Building Survey"
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alturascope.com/" },
    { "@type": "ListItem", "position": 2, "name": "UK", "item": "https://alturascope.com/uk/" },
    { "@type": "ListItem", "position": 3, "name": "Measured Building Survey UK", "item": "https://alturascope.com/uk/measured-building-survey/" }
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What accuracy can we expect from a point cloud survey?",
      "acceptedAnswer": { "@type": "Answer", "text": "5–12mm across full footprint." }
    },
    {
      "@type": "Question",
      "name": "What software do you deliver point cloud data in?",
      "acceptedAnswer": { "@type": "Answer", "text": ".e57 and .rcp." }
    },
    {
      "@type": "Question",
      "name": "Can you produce as-built CAD drawings from the point cloud?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, floor plans, sections, and elevations." }
    },
    {
      "@type": "Question",
      "name": "How does this differ from a topographic survey?",
      "acceptedAnswer": { "@type": "Answer", "text": "Topographic surveys document external ground and boundaries; measured building surveys capture the spatial geometry of the building itself." }
    },
    {
      "@type": "Question",
      "name": "Do you work with architects and engineers directly or through contractors?",
      "acceptedAnswer": { "@type": "Answer", "text": "Both." }
    }
  ]
});
---
<Layout
  title="Measured Building Survey UK — Point Cloud & As-Built Documentation | Alturascope"
  description="Survey-grade measured building surveys across the UK. Point cloud data accurate to 5–12mm for CAD and Revit workflows. As-built floor plans, sections, and elevations. .e57 and .rcp export."
  canonical="https://alturascope.com/uk/measured-building-survey/"
  schema={schema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
  fullWidth={true}
  lang="en-GB"
  hreflang={[{ lang: "en-gb", href: "https://alturascope.com/uk/measured-building-survey/" }, { lang: "en", href: "https://alturascope.com/uk/measured-building-survey/" }]}
>
  <div data-hero-page>

    <!-- Hero -->
    <section class="relative min-h-screen flex items-center justify-center pt-24">
      <div class="absolute inset-0 bg-navy">
        <img
          src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=1920&q=80"
          alt="UK commercial interior documented with LiDAR point cloud during measured building survey for architectural and engineering use"
          class="w-full h-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[rgba(11,31,58,0.72)]"></div>
      </div>

      <div class="relative z-10 text-center max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-6">UK Services · Measured Survey &amp; Point Cloud</p>
        <h1 class="text-[2.4rem] md:text-[3.6rem] font-light text-offwhite leading-[1.1]">
          Measured Building Survey UK &mdash; Point Cloud Data for Architects and Engineers
        </h1>
        <p class="mt-6 text-[1.15rem] text-offwhite/80 font-normal leading-relaxed max-w-[620px] mx-auto">
          Survey-grade point cloud data accurate to 5&ndash;12mm across full building footprints. The dimensional foundation your CAD and Revit workflows need.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/contact/" class="btn-primary">Tell Us What You&apos;re Designing</a>
          <a href="/uk/" class="btn-secondary-light">UK Services</a>
        </div>
      </div>

      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4">
        <div class="w-[60px] h-[1px] bg-gold"></div>
        <svg class="w-5 h-5 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- Why Design Teams Need Better Spatial Data -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight">
          Why Design Teams Need Better Spatial Data
        </h2>
        <div class="mt-6 space-y-4 text-midgrey leading-body">
          <p>
            Unreliable old drawings. Assumptions about floor levels, ceiling heights, and structural geometry that turn out to be wrong. Downstream errors in design, procurement, and construction when the base data doesn&apos;t match reality.
          </p>
          <p>
            A measured building survey gives you survey-grade point cloud data &mdash; accurate to 5&ndash;12mm across the full footprint &mdash; so your CAD and Revit models start from what&apos;s actually there, not what someone drew years ago.
          </p>
        </div>
      </div>
    </section>

    <!-- Understanding the Difference: Digital Twin vs. Point Cloud Survey -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight mb-10">
          Understanding the Difference: Digital Twin vs. Point Cloud Survey
        </h2>
        <p class="text-midgrey leading-body mb-10">
          Both are valuable. They serve different purposes. Here&apos;s when you need each:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-offwhite p-8 rounded border border-border">
            <h3 class="text-navy font-medium text-[1.15rem] mb-3">Navigable Digital Twin</h3>
            <p class="text-midgrey leading-body">
              An explorable, walk-through model of the space. Ideal for remote site visits, stakeholder review, and understanding layout and conditions. Dimensionally useful but not survey-grade. Best when you need to explore and communicate, not measure.
            </p>
          </div>
          <div class="bg-offwhite p-8 rounded border border-border">
            <h3 class="text-navy font-medium text-[1.15rem] mb-3">Survey-Grade Point Cloud</h3>
            <p class="text-midgrey leading-body">
              Millimetre-accurate LiDAR data for CAD, Revit, and BIM workflows. When you need to take measurements, produce as-built drawings, or model with precision. Required for refurbishment, conversion, heritage work, and complex fit-out where dimensions matter.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What a Measured Building Survey Delivers -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight mb-10">
          What a Measured Building Survey Delivers
        </h2>

        <div class="space-y-8">
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Survey-Grade Point Cloud Data (.e57/.rcp)</h3>
            <p class="mt-2 text-midgrey leading-body">
              Millimetre-accurate LiDAR capture. Exported in .e57 and .rcp formats for direct use in AutoCAD, Revit, and other design software. The raw dimensional foundation your workflows need.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">As-Built Floor Plans, Sections &amp; Elevations</h3>
            <p class="mt-2 text-midgrey leading-body">
              Derived from the point cloud. Floor plans, sections, and elevations drawn to survey accuracy. Ready for design development, planning submissions, and construction documentation.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Navigable Digital Twin (Optional)</h3>
            <p class="mt-2 text-midgrey leading-body">
              The accessible exploration layer for your wider team. Walk the space remotely. Add as an optional deliverable when you need both precision data and easy exploration.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">Conditions Report</h3>
            <p class="mt-2 text-midgrey leading-body">
              Written findings prioritised P1, P2, P3. What matters for design decisions, cost, and programme.
            </p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium text-[1.15rem]">ScopeWalk Platform Access</h3>
            <p class="mt-2 text-midgrey leading-body">
              Permanent, structured, shareable. All deliverables accessible through one platform for your design team, contractors, and stakeholders.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- When a Measured Building Survey Is Required -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy leading-tight mb-10">
          When a Measured Building Survey Is Required
        </h2>

        <div class="space-y-6">
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Refurbishment and conversion</h3>
            <p class="mt-2 text-midgrey leading-body">When existing drawings are outdated or unreliable and design depends on accurate dimensions.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Change of use</h3>
            <p class="mt-2 text-midgrey leading-body">Planning and design for conversion require as-built geometry that reflects current conditions.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Heritage and listed buildings</h3>
            <p class="mt-2 text-midgrey leading-body">Conservation architects and heritage bodies need survey-grade records for consent applications and design.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Complex fit-out</h3>
            <p class="mt-2 text-midgrey leading-body">When MEP, structure, and finishes must align precisely with existing geometry.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">BIM projects</h3>
            <p class="mt-2 text-midgrey leading-body">When the BIM model must be founded on accurate as-built data, not assumptions.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold">
            <h3 class="text-navy font-medium">Pre-acquisition due diligence</h3>
            <p class="mt-2 text-midgrey leading-body">When investors or developers need dimensional certainty before committing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <h2 class="text-[2rem] font-light text-navy mb-12">Frequently asked questions</h2>

        <div class="space-y-8">
          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What accuracy can we expect from a point cloud survey?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              5&ndash;12mm across full footprint.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              What software do you deliver point cloud data in?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              .e57 and .rcp.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Can you produce as-built CAD drawings from the point cloud?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Yes, floor plans, sections, and elevations.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              How does this differ from a topographic survey?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Topographic surveys document external ground and boundaries; measured building surveys capture the spatial geometry of the building itself.
            </p>
          </details>

          <details class="group border-b border-border pb-6">
            <summary class="cursor-pointer text-navy font-medium text-lg flex items-center justify-between">
              Do you work with architects and engineers directly or through contractors?
              <span class="text-gold text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 text-midgrey leading-body">
              Both.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA: Tell Us What You're Designing -->
    <section class="bg-offwhite section-padding">
      <div class="max-w-[760px] mx-auto px-6 text-center">
        <h2 class="text-[2rem] font-light text-navy">
          Tell Us What You&apos;re Designing
        </h2>
        <p class="mt-4 text-midgrey leading-body">
          Share the address or approximate location, the size of the space, and what you need the point cloud for. We&apos;ll come back within one business day with a clear scope recommendation and an all-in quote &mdash; travel included.
        </p>
        <a href="/contact/" class="btn-primary mt-10">Tell Us What You&apos;re Designing</a>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="bg-white section-padding">
      <div class="max-w-[760px] mx-auto px-6">
        <p class="label text-gold mb-4">Related UK Services</p>
        <div class="flex flex-wrap gap-6 text-midgrey">
          <a href="/uk/heritage-building-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Heritage building survey UK &rarr;</a>
          <a href="/uk/pre-construction-survey/" class="text-navy font-medium hover:opacity-80 transition-opacity">Pre-construction survey UK &rarr;</a>
          <a href="/uk/" class="text-navy font-medium hover:opacity-80 transition-opacity">Alturascope UK &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Footer note -->
    <p class="text-center text-[0.85rem] text-midgrey/60 italic py-8 bg-white">
      Alturascope delivers measured building surveys across England, Scotland, Wales, and Northern Ireland &mdash; all-in pricing with travel included.
    </p>

    <!-- Navy CTA bar -->
    <section class="bg-navy py-20">
      <div class="max-w-[600px] mx-auto px-6 text-center">
        <h2 class="text-[1.8rem] font-light text-offwhite leading-snug">
          Ready for survey-grade point cloud data?
        </h2>
        <p class="mt-4 text-offwhite/70 leading-body">
          Share the location, the approximate size, and what you&apos;re designing. We&apos;ll confirm scope and send an all-in quote within one business day.
        </p>
        <a href="/contact/" class="btn-primary mt-8">Start a Project</a>
      </div>
    </section>

  </div>
</Layout>
