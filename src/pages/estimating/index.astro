                <div>
                  <label for="est-company" class="block text-sm font-medium text-navy mb-1.5">Company <span class="text-gold">*</span></label>
                  <input type="text" id="est-company" name="company" required class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="est-email" class="block text-sm font-medium text-navy mb-1.5">Email <span class="text-gold">*</span></label>
                  <input type="email" id="est-email" name="email" required class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="est-trade" class="block text-sm font-medium text-navy mb-1.5">Your trade or sector</label>
                  <input type="text" id="est-trade" name="trade" placeholder="Build-out, MEP, sitework&hellip;" class="w-full px-4 py-3 border border-border bg-white text-navy placeholder:text-midgrey/60 focus:border-gold focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="est-due" class="block text-sm font-medium text-navy mb-1.5">Return date <span class="text-gold">*</span></label>
                  <input type="text" id="est-due" name="return_date" required placeholder="When is it due back?" class="w-full px-4 py-3 border border-border bg-white text-navy placeholder:text-midgrey/60 focus:border-gold focus:outline-none transition-colors" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="est-value" class="block text-sm font-medium text-navy mb-1.5">Approximate value</label>
                  <input type="text" id="est-value" name="approx_value" placeholder="A ballpark is fine" class="w-full px-4 py-3 border border-border bg-white text-navy placeholder:text-midgrey/60 focus:border-gold focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="est-volume" class="block text-sm font-medium text-navy mb-1.5">Packages per month</label>
                  <select id="est-volume" name="packages_per_month" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors">
                    <option>1&ndash;3</option>
                    <option>4&ndash;8</option>
                    <option>9&ndash;15</option>
                    <option>More than 15</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="est-docs" class="block text-sm font-medium text-navy mb-1.5">Where are the documents?</label>
                <input type="text" id="est-docs" name="documents" placeholder="Dropbox, SharePoint or WeTransfer link" class="w-full px-4 py-3 border border-border bg-white text-navy placeholder:text-midgrey/60 focus:border-gold focus:outline-none transition-colors" />
                <p class="mt-1.5 text-[0.8rem] text-midgrey">Or leave blank and we&rsquo;ll send you an upload link.</p>
              </div>

              <div>
                <label for="est-brief" class="block text-sm font-medium text-navy mb-1.5">Anything we should know?</label>
                <textarea id="est-brief" name="brief" rows="3" class="w-full px-4 py-3 border border-border bg-white text-navy focus:border-gold focus:outline-none transition-colors resize-y"></textarea>
              </div>

              <div class="flex items-center gap-3">
                <input type="checkbox" id="est-nda" name="nda_required" value="Yes" class="w-4 h-4 accent-gold" />
                <label for="est-nda" class="text-[0.9rem] text-midgrey">We need a non-disclosure agreement in place first</label>
              </div>

              <!-- Honeypot -->
              <div class="hidden" aria-hidden="true">
                <label for="est-website">Website</label>
                <input type="text" id="est-website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <button type="submit" class="btn-primary w-full">Send the Brief</button>
            </form>
          </div>
        </div>

        <div class="mt-14 flex flex-wrap gap-6 text-sm">
          <a href="/estimating/basis-of-estimate/" class="text-offwhite/70 hover:text-offwhite transition-colors">Basis of Estimate standard &rarr;</a>
          <a href="/uk/estimating/" class="text-offwhite/70 hover:text-offwhite transition-colors">UK estimating &rarr;</a>
          <a href="/services/" class="text-offwhite/70 hover:text-offwhite transition-colors">Site documentation services &rarr;</a>
          <a href="/services/pre-construction-site-intelligence/" class="text-offwhite/70 hover:text-offwhite transition-colors">Pre-construction intelligence &rarr;</a>
          <a href="/about/" class="text-offwhite/70 hover:text-offwhite transition-colors">About Alturascope &rarr;</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
