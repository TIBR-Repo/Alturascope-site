---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Enquiry Received | Alturascope"
  description="Your enquiry has been received. We'll come back to you within one business day."
  canonical="https://alturascope.com/thank-you/"
  robots="noindex, follow"
  fullWidth={true}
>
  <section class="bg-navy min-h-[70vh] flex items-center pt-32 pb-24">
    <div class="max-w-[760px] mx-auto px-6">
      <p class="label text-gold mb-4">Enquiry Received</p>
      <h1 class="text-[2rem] md:text-[2.8rem] font-light text-offwhite leading-tight">
        Thank you. We&rsquo;ll be in touch within one business day.
      </h1>
      <div class="mt-8 space-y-4 text-offwhite/75 leading-body">
        <p>
          We&rsquo;ll come back with a clear scope recommendation and an all-in quote &mdash; travel included, wherever the building is.
        </p>
        <p>
          If your project is time-critical, reply to the confirmation you&rsquo;ve just been sent and tell us the date you&rsquo;re working to.
        </p>
      </div>

      <div class="mt-12 flex flex-wrap gap-6 text-sm">
        <a href="/work/sample-project/" class="text-offwhite/70 hover:text-offwhite transition-colors">Explore a sample project &rarr;</a>
        <a href="/services/" class="text-offwhite/70 hover:text-offwhite transition-colors">Our services &rarr;</a>
        <a href="/estimating/" class="text-offwhite/70 hover:text-offwhite transition-colors">Estimating desk &rarr;</a>
        <a href="/" class="text-offwhite/70 hover:text-offwhite transition-colors">Home &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
