---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  schema?: string;
  breadcrumbSchema?: string;
  faqSchema?: string;
  fullWidth?: boolean;
  lang?: string;
  hreflang?: { lang: string; href: string }[];
  minimalChrome?: boolean;
}

const {
  title,
  description,
  canonical,
  robots = "index, follow",
  ogImage = "https://alturascope.com/og/default.jpg",
  schema,
  breadcrumbSchema,
  faqSchema,
  fullWidth = false,
  lang = "en",
  hreflang = [],
  minimalChrome = false,
} = Astro.props;

const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://alturascope.com/#organization",
  "name": "Alturascope",
  "url": "https://alturascope.com/",
  "logo": "https://alturascope.com/logo.png",
  "description": "Reality capture, site documentation and construction estimating across the US, Canada, and the UK.",
  "sameAs": ["https://www.linkedin.com/company/111948383"],
  "areaServed": ["United States", "Canada", "United Kingdom"],
  "knowsAbout": [
    "Reality capture",
    "Site documentation",
    "Measured building surveys",
    "Construction estimating",
    "Quantity take-off",
    "Bid and tender pricing"
  ],
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Site documentation and reality capture",
        "url": "https://alturascope.com/services/"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Construction estimating",
        "url": "https://alturascope.com/estimating/"
      }
    }
  ],
});

const navLinks = [
  { href: "/work/", label: "The Standard" },
  { href: "/services/", label: "Services" },
  { href: "/estimating/", label: "Estimating" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DSTWFS10J2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DSTWFS10J2');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Alturascope" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0B1F3A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <script type="application/ld+json" set:html={organizationSchema} />
    {schema && <script type="application/ld+json" set:html={schema} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
    {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}
  </head>
  <body>
    {!minimalChrome && (
    <Fragment>
    <!-- Header -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
      <div class="mx-auto max-w-[1400px] px-6 md:px-8 lg:px-12 py-5 flex items-center justify-between">
        <a href="/" class="flex items-center" aria-label="Alturascope home">
          <span id="logo-text" class="text-xl font-light tracking-wide text-white transition-colors duration-300">ALTURASCOPE</span>
        </a>

        <nav class="hidden lg:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link text-[0.875rem] font-medium tracking-nav text-white/90 hover:text-white transition-colors duration-300"
            >
              {link.label}
            </a>
          ))}
          <a href="/contact/" class="btn-primary text-sm px-6 py-3">Start a Project</a>
        </nav>

        <button
          id="mobile-toggle"
          type="button"
          class="lg:hidden flex flex-col justify-center items-center w-10 h-10"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
          <span id="burger-top" class="block w-6 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
          <span id="burger-mid" class="block w-6 h-[1.5px] bg-white mt-[6px] transition-all duration-300"></span>
          <span id="burger-bot" class="block w-6 h-[1.5px] bg-white mt-[6px] transition-all duration-300 origin-center"></span>
        </button>
      </div>
    </header>

    <!-- Mobile overlay -->
    <div id="mobile-overlay" class="fixed inset-0 z-[60] bg-navy flex flex-col items-center justify-center hidden opacity-0 transition-opacity duration-300">
      <button id="mobile-close" class="absolute top-6 right-6 text-gold text-3xl font-light leading-none" aria-label="Close navigation">&times;</button>
      <nav class="flex flex-col items-center gap-8">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white text-2xl font-light">{link.label}</a>
        ))}
        <a href="/contact/" class="btn-primary mt-4 text-base px-8 py-3.5">Start a Project</a>
      </nav>
    </div>
    </Fragment>
    )}

    <main class={fullWidth ? "" : "mx-auto max-w-[1400px] px-6 lg:px-10"}>
      <slot />
    </main>

    {minimalChrome && (
    <footer class="bg-[#F5EFE4] border-t border-[#E9E0CD]">
      <div class="mx-auto max-w-[1100px] px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#6F6A61]">
        <p>Shared via <span class="font-semibold text-[#3A3630]">ScopeWalk</span> &middot; <span>Sample project</span></p>
        <a href="/" class="text-[#3A3630] font-medium hover:text-[#CC620A] transition-colors">&larr; Back to Alturascope</a>
      </div>
    </footer>
    )}
    {!minimalChrome && (
    <!-- Footer -->
    <footer class="bg-navy text-white/80">
      <div class="mx-auto max-w-[1400px] px-6 lg:px-10 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_2.4fr] gap-16">
          <div>
            <span class="text-xl font-light tracking-wide text-white">ALTURASCOPE</span>
            <p class="mt-4 text-sm text-white/60 max-w-sm leading-relaxed">
              Reality capture, site documentation and construction estimating across the US, Canada, and the UK.
            </p>
            <a href="https://www.linkedin.com/company/111948383" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-6 text-white/50 hover:text-white transition-colors" aria-label="Alturascope on LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <p class="mt-4 text-xs text-white/40">
              &copy; {new Date().getFullYear()} Alturascope. All rights reserved.
            </p>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
            <div>
              <h4 class="text-xs font-medium uppercase tracking-label text-white/50 mb-6">Services</h4>
              <nav class="flex flex-col gap-3">
                <a href="/services/construction-documentation/" class="text-sm text-white/70 hover:text-white transition-colors">Construction Documentation</a>
                <a href="/services/multi-site-rollout-documentation/" class="text-sm text-white/70 hover:text-white transition-colors">Multi-Site Rollout</a>
                <a href="/services/pre-construction-site-intelligence/" class="text-sm text-white/70 hover:text-white transition-colors">Pre-Construction Intelligence</a>
                <a href="/services/specialist-projects/" class="text-sm text-white/70 hover:text-white transition-colors">Specialist Projects</a>
                <a href="/services/" class="text-sm text-white/70 hover:text-white transition-colors">How It Works</a>
                <a href="/#scopewalk" class="text-sm text-white/70 hover:text-white transition-colors">ScopeWalk&trade;</a>
                <span class="block mt-3 mb-1 text-xs font-medium uppercase tracking-label text-white/40">Regions</span>
                <a href="/services/northeast-site-surveys/" class="text-sm text-white/70 hover:text-white transition-colors">Northeast US</a>
                <a href="/services/southeast-site-surveys/" class="text-sm text-white/70 hover:text-white transition-colors">Southeast US</a>
                <a href="/services/central-us-site-surveys/" class="text-sm text-white/70 hover:text-white transition-colors">Central US</a>
                <a href="/services/west-coast-site-surveys/" class="text-sm text-white/70 hover:text-white transition-colors">West Coast</a>
              </nav>
            </div>
            <div>
              <h4 class="text-xs font-medium uppercase tracking-label text-white/50 mb-6">Sectors</h4>
              <nav class="flex flex-col gap-3">
                <a href="/services/aba-autism-clinic-documentation/" class="text-sm text-white/70 hover:text-white transition-colors">ABA &amp; Autism Therapy</a>
                <a href="/services/qsr-restaurant-survey/" class="text-sm text-white/70 hover:text-white transition-colors">QSR &amp; Restaurant</a>
                <a href="/services/retail-rollout-documentation/" class="text-sm text-white/70 hover:text-white transition-colors">Retail &amp; Franchise</a>
                <a href="/services/healthcare-facility-survey/" class="text-sm text-white/70 hover:text-white transition-colors">Healthcare</a>
                <a href="/services/commercial-kitchen-survey/" class="text-sm text-white/70 hover:text-white transition-colors">Commercial Kitchens</a>
                <a href="/services/aviation-facility-survey/" class="text-sm text-white/70 hover:text-white transition-colors">Aviation</a>
                <a href="/services/heritage-building-documentation/" class="text-sm text-white/70 hover:text-white transition-colors">Heritage</a>
              </nav>
            </div>
            <div>
              <h4 class="text-xs font-medium uppercase tracking-label text-white/50 mb-6">Estimating</h4>
              <nav class="flex flex-col gap-3">
                <a href="/estimating/" class="text-sm text-white/70 hover:text-white transition-colors">Estimating Desk</a>
                <a href="/estimating/sample-quote-pack/" class="text-sm text-white/70 hover:text-white transition-colors">Sample Estimate Pack</a>
                <a href="/estimating/basis-of-estimate/" class="text-sm text-white/70 hover:text-white transition-colors">Basis of Estimate</a>
                <a href="/uk/estimating/" class="text-sm text-white/70 hover:text-white transition-colors">Estimating UK</a>
                <a href="/estimating/#send-a-package" class="text-sm text-white/70 hover:text-white transition-colors">Send a Package</a>
                <a href="https://vyntworks.com" target="_blank" rel="noopener" class="text-sm text-white/70 hover:text-white transition-colors">Powered by Vyntworks</a>
              </nav>
            </div>

            <div>
              <h4 class="text-xs font-medium uppercase tracking-label text-white/50 mb-6">Company</h4>
              <nav class="flex flex-col gap-3">
                <a href="/work/" class="text-sm text-white/70 hover:text-white transition-colors">The Standard</a>
                <a href="/work/locations/" class="text-sm text-white/70 hover:text-white transition-colors">Surveyed Locations</a>
                <a href="/about/" class="text-sm text-white/70 hover:text-white transition-colors">About</a>
                <a href="/insights/" class="text-sm text-white/70 hover:text-white transition-colors">Insights</a>
                <a href="/contact/" class="text-sm text-white/70 hover:text-white transition-colors">Contact</a>
                <a href="/uk/" class="text-sm text-white/70 hover:text-white transition-colors">Alturascope UK</a>
                <a href="/uk/heritage-building-survey/" class="text-sm text-white/70 hover:text-white transition-colors">Heritage Survey UK</a>
                <a href="/uk/pre-construction-survey/" class="text-sm text-white/70 hover:text-white transition-colors">Pre-Construction UK</a>
              </nav>
            </div>
          </div>
        </div>
      </div>
      <div class="border-t border-navy-light">
        <div class="mx-auto max-w-[1400px] px-6 lg:px-10 py-6 flex justify-end gap-6">
          <a href="/privacy/" class="text-[0.8rem] text-white/50 hover:text-white/70 transition-colors">Privacy Policy</a>
          <a href="/terms/" class="text-[0.8rem] text-white/50 hover:text-white/70 transition-colors">Terms</a>
        </div>
      </div>
    </footer>
    )}

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const header = document.getElementById("site-header");
        const logo = document.getElementById("logo-text");
        const navLinks = document.querySelectorAll(".nav-link");
        const burgerLines = [
          document.getElementById("burger-top"),
          document.getElementById("burger-mid"),
          document.getElementById("burger-bot"),
        ];
        const mobileToggle = document.getElementById("mobile-toggle");
        const mobileOverlay = document.getElementById("mobile-overlay");
        const mobileClose = document.getElementById("mobile-close");

        let isHeroPage = !!document.querySelector("[data-hero-page]");

        function updateHeader() {
          if (!header) return;
          const scrolled = window.scrollY > 50;

          if (scrolled || !isHeroPage) {
            header.classList.add("bg-white", "border-b", "border-border", "shadow-sm");
            header.classList.remove("bg-transparent");
            logo?.classList.replace("text-white", "text-navy");
            navLinks.forEach((l) => {
              l.classList.remove("text-white/90");
              l.classList.add("text-navy/80");
              l.classList.remove("hover:text-white");
              l.classList.add("hover:text-navy");
            });
            burgerLines.forEach((l) => {
              l?.classList.replace("bg-white", "bg-navy");
            });
          } else {
            header.classList.remove("bg-white", "border-b", "border-border", "shadow-sm");
            header.classList.add("bg-transparent");
            logo?.classList.replace("text-navy", "text-white");
            navLinks.forEach((l) => {
              l.classList.add("text-white/90");
              l.classList.remove("text-navy/80");
              l.classList.add("hover:text-white");
              l.classList.remove("hover:text-navy");
            });
            burgerLines.forEach((l) => {
              l?.classList.replace("bg-navy", "bg-white");
            });
          }
        }

        updateHeader();
        window.addEventListener("scroll", updateHeader, { passive: true });

        function openMobile() {
          mobileOverlay?.classList.remove("hidden");
          requestAnimationFrame(() => {
            mobileOverlay?.classList.replace("opacity-0", "opacity-100");
          });
          document.body.style.overflow = "hidden";
        }

        function closeMobile() {
          mobileOverlay?.classList.replace("opacity-100", "opacity-0");
          setTimeout(() => {
            mobileOverlay?.classList.add("hidden");
          }, 300);
          document.body.style.overflow = "";
        }

        mobileToggle?.addEventListener("click", openMobile);
        mobileClose?.addEventListener("click", closeMobile);

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeMobile();
        });
      });
    </script>
  </body>
</html>
