---
/**
 * UK entity details - address, phone, company and VAT numbers.
 *
 * Renders only the fields that exist in src/data/uk-entity.json, so there is
 * never placeholder text on the live site.
 *
 * One deliberate guard: the registration block (company and VAT numbers) does
 * not render until legalName is set. A VAT number published under an
 * "Alturascope in the UK" heading with no entity named reads as a claim that
 * it is Alturascope's own registration. This one was supplied as Selwyn's, and
 * whichever company actually contracts UK work should be the one named beside
 * it.
 *
 * Why any of this matters: eight /uk/ pages assert UK coverage, and until now
 * the site carried no address, no phone and no company detail anywhere - an
 * assertion with nothing behind it, and the most likely reason the UK pages sit
 * on page five for terms they should compete for.
 */
import uk from "../data/uk-entity.json";

interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;

const addressLines = [uk.street, uk.locality, uk.postTown, uk.region, uk.postalCode].filter(Boolean);
const hasAddress = addressLines.length > 0;
const hasContact = Boolean(uk.phone || uk.email);
const hasRegistration = Boolean(uk.legalName) && Boolean(uk.companyNumber || uk.vatNumber);
const show = hasAddress || hasContact || hasRegistration;

const dark = tone === "dark";
const head = dark ? "text-offwhite" : "text-navy";
const body = dark ? "text-offwhite/70" : "text-midgrey";
---
{show && (
  <section class={`section-padding-tight ${dark ? "bg-navy" : "bg-offwhite"}`}>
    <div class="max-w-[1100px] mx-auto px-6">
      <p class="label text-gold mb-4">Alturascope in the UK</p>
      <div class="grid md:grid-cols-3 gap-10">
        {hasAddress && (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Office</h3>
            <address class={`mt-3 not-italic leading-body text-[0.95rem] ${body}`}>
              {uk.legalName && <span class="block">{uk.legalName}</span>}
              {addressLines.map((l) => <span class="block">{l}</span>)}
              <span class="block">United Kingdom</span>
            </address>
          </div>
        )}
        {hasContact && (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Contact</h3>
            <div class={`mt-3 leading-body text-[0.95rem] ${body}`}>
              {uk.phone && (
                <a href={`tel:${uk.phone.replace(/[^+0-9]/g, "")}`} class={`block ${head} font-medium hover:opacity-80 transition-opacity`}>
                  {uk.phone}
                </a>
              )}
              {uk.email && (
                <a href={`mailto:${uk.email}`} class="block mt-1 hover:opacity-80 transition-opacity">{uk.email}</a>
              )}
              <span class="block mt-2">Monday to Friday, 08:00&ndash;18:00</span>
            </div>
          </div>
        )}
        {hasRegistration && (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Registration</h3>
            <div class={`mt-3 leading-body text-[0.95rem] ${body}`}>
              <span class="block">{uk.legalName}</span>
              {uk.companyNumber && <span class="block">Company no. {uk.companyNumber}</span>}
              {uk.vatNumber && <span class="block">VAT no. {uk.vatNumber}</span>}
            </div>
          </div>
        )}
      </div>
      {!hasContact && (
        <p class={`mt-8 text-[0.95rem] ${body}`}>
          UK enquiries go through the <a href="/contact/" class={`${head} font-medium hover:opacity-80 transition-opacity`}>enquiry form</a>, and we reply within one working day.
        </p>
      )}
    </div>
  </section>
)}
