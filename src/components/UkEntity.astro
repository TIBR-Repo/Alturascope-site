---
/**
 * UK entity details and statutory trading disclosure.
 *
 * Alturascope trades in the UK as a name of Orleyton Ltd. A UK limited company
 * must disclose its registered name, registered number, place of registration
 * and registered office address on its websites - Companies Act 2006
 * s.1202-1206 and the Companies (Trading Disclosures) Regulations - and that
 * obligation applies precisely because the trading name differs from the
 * registered one. So this block is a legal requirement first and a local search
 * signal second.
 *
 * Everything is driven from src/data/uk-entity.json and any null field simply
 * does not render, so there is never placeholder text on the live site.
 */
import uk from "../data/uk-entity.json";

interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;

const addressLines = [uk.street, uk.locality, uk.postTown, uk.region, uk.postalCode].filter(Boolean);
const hasAddress = addressLines.length > 0;
const hasContact = Boolean(uk.phone || uk.email);
const hasDisclosure = Boolean(uk.legalName && uk.companyNumber);
const show = hasAddress || hasContact || hasDisclosure;

const dark = tone === "dark";
const head = dark ? "text-offwhite" : "text-navy";
const body = dark ? "text-offwhite/70" : "text-midgrey";
const quiet = dark ? "text-offwhite/50" : "text-midgrey/80";
---
{show && (
  <section class={`section-padding-tight ${dark ? "bg-navy" : "bg-offwhite"}`}>
    <div class="max-w-[1100px] mx-auto px-6">
      <p class="label text-gold mb-4">Alturascope in the UK</p>

      <div class="grid md:grid-cols-3 gap-10">
        {hasAddress && (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>
              {uk.isRegisteredOffice ? "Registered office" : "Office"}
            </h3>
            <address class={`mt-3 not-italic leading-body text-[0.95rem] ${body}`}>
              {uk.legalName && <span class="block">{uk.legalName}</span>}
              {addressLines.map((l) => <span class="block">{l}</span>)}
              <span class="block">United Kingdom</span>
            </address>
          </div>
        )}

        {hasContact ? (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Contact</h3>
            <div class={`mt-3 leading-body text-[0.95rem] ${body}`}>
              {uk.phone && (
                <a href={`tel:${uk.phone.replace(/[^+0-9]/g, "")}`} class={`block ${head} font-medium hover:opacity-80 transition-opacity`}>
                  {uk.phone}
                </a>
              )}
              {uk.email && (
                <a href={`mailto:${uk.email}`} class="block mt-1 hover:opacity-80 transition-opacity">{uk.email}</a>
              )}
              <span class="block mt-2">Monday to Friday, 08:00&ndash;18:00</span>
            </div>
          </div>
        ) : (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Enquiries</h3>
            <p class={`mt-3 leading-body text-[0.95rem] ${body}`}>
              UK enquiries go through the
              {" "}<a href="/contact/" class={`${head} font-medium hover:opacity-80 transition-opacity`}>enquiry form</a>,
              answered within one working day.
            </p>
            <p class={`mt-2 leading-body text-[0.95rem] ${body}`}>
              Monday to Friday, 08:00&ndash;18:00.
            </p>
          </div>
        )}

        {hasDisclosure && (
          <div>
            <h3 class={`text-[0.95rem] font-medium ${head}`}>Company</h3>
            <div class={`mt-3 leading-body text-[0.95rem] ${body}`}>
              <span class="block">Registered in {uk.registeredIn}</span>
              <span class="block">Company no. {uk.companyNumber}</span>
              {uk.vatNumber && <span class="block">VAT no. {uk.vatNumber}</span>}
            </div>
          </div>
        )}
      </div>

      {hasDisclosure && (
        <p class={`mt-10 text-[0.88rem] leading-relaxed ${quiet} max-w-[80ch]`}>
          {uk.tradingAs || "Alturascope"} is a trading name of {uk.legalName}, a company
          registered in {uk.registeredIn} under number {uk.companyNumber}
          {hasAddress && <>, whose registered office is {addressLines.join(", ")}</>}.
          {uk.vatNumber && <> VAT registration {uk.vatNumber}.</>}
          {" "}UK work is contracted with {uk.legalName}.
        </p>
      )}
    </div>
  </section>
)}
